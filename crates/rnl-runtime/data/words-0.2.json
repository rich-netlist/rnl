{
  "language_version": "0.2",
  "note": "Prototype standard word list (spec-draft 5.3, Z1), with the names settled in round D (2026-10-10), the trial decisions TR1-TR4, TR3 continued and TR11 (2026-10-11), and the decisions of 2026-10-12: positional parameters first (D9 revised), ORDER and DISTANCE take one direction, ALIGN, DISTRIBUTE and TEXT take their first parameter by position, DEFINE only by name, ALIAS definition=, USE-ALIASES (D16, D17).",
  "header_fields": {
    "type": {"values": ["authored", "generated", "header"], "affects": true},
    "scope": {"type": "string", "affects": true},
    "priority": {"values": ["disabled", "low", "normal", "high"], "affects": true},
    "author": {"type": "string", "affects": false},
    "hash": {"type": "string", "affects": false},
    "modified": {"type": "string", "affects": false}
  },
  "kinds": ["instance", "terminal", "net", "point", "wire", "usage", "bundle", "text", "annotation", "label"],
  "subobjects": ["position", "net"],
  "attributes": ["name", "value", "model", "type", "net", "x", "y"],
  "style_props": {
    "linecolor": {"type": "color"},
    "linestyle": {"values": ["solid", "dashed", "dotted", "dash-dot", "double", "bold", "none"]},
    "linewidth": {"type": "number"},
    "cap": {"values": ["butt", "round", "square"]},
    "join": {"values": ["miter", "round", "bevel"]},
    "fillcolor": {"type": "color"},
    "textcolor": {"type": "color"},
    "size": {"type": "number"},
    "font": {"type": "string"},
    "bold": {"type": "bool"},
    "italic": {"type": "bool"},
    "arrowsize": {"type": "number"}
  },
  "line_style": ["linecolor", "linestyle", "linewidth", "cap", "join", "fillcolor", "arrowsize"],
  "area_style": ["linecolor", "linestyle", "linewidth", "cap", "join", "fillcolor"],
  "wire_style": ["linecolor", "linestyle", "linewidth", "cap", "join"],
  "text_style": ["textcolor", "size", "font", "bold", "italic"],
  "keywords": {
    "VERSION": {"where": ["header"], "positions": [], "params": [{"name": "version", "type": "string", "required": true}], "positional": ["version"], "output": "none", "section": "16.1"},
    "PACKAGE": {"where": ["package-header"], "positions": [], "params": [{"name": "name", "type": "string", "required": true}, {"name": "version", "type": "string", "required": true}], "output": "none", "section": "2.7"},
    "USE-PACKAGE": {"where": ["header", "level"], "positions": [{"name": "body", "takes": "body", "optional": true}], "params": [{"name": "name", "type": "string", "required": true}, {"name": "version", "type": "string"}, {"name": "path", "type": "string"}], "output": "none", "section": "16.2"},
    "ALIAS": {"where": ["header"], "positions": [], "params": [{"name": "alias", "type": "string", "required": true}, {"name": "original", "type": "string", "required": true}, {"name": "definition", "type": "string"}], "positional": ["alias", "original"], "output": "none", "section": "16.5"},
    "USE-ALIASES": {"where": ["header"], "positions": [], "params": [{"name": "name", "type": "string", "required": true}, {"name": "version", "type": "string"}, {"name": "path", "type": "string"}], "output": "none", "section": "16.5"},
    "DEVICE": {"where": ["header"], "positions": [], "params": [{"name": "name", "type": "string", "required": true}, {"name": "model", "type": "string"}, {"name": "terminals", "type": "array", "required": true}], "output": "none", "section": "6.12"},
    "DEFINE-SYMBOL": {"where": ["level", "symbol"], "positions": [{"name": "body", "takes": "body"}], "params": [{"name": "box", "type": "array"}], "output": "def:symbol", "section": "9.2"},
    "DEFINE-STYLE": {"where": ["level"], "positions": [{"name": "extends", "takes": "body"}], "params": "style", "output": "def:style", "section": "9.3"},
    "DEFINE": {"where": ["level"], "positions": [{"name": "body", "takes": "body"}], "params": [{"name": "roles", "type": "array", "required": true}, {"name": "parameters", "type": "array"}], "output": "def:definition", "section": "9.4"},
    "PIN": {"where": ["symbol"], "positions": [{"name": "position", "takes": "one", "kinds": ["point"]}], "params": [{"name": "terminal", "type": "term", "required": true}, {"name": "label", "type": "string"}, {"name": "direction", "values": ["right", "up", "left", "down"]}], "output": "new:pin", "section": "9.2.4"},
    "LINE": {"where": ["level", "symbol"], "positions": [{"name": "points", "takes": "set", "kinds": ["point", "terminal"]}], "params": [{"name": "arrow", "values": ["none", "start", "end", "both"]}, {"name": "fill", "values": ["none", "linecolor", "fillcolor"]}], "style": "line_style", "output": "new:annotation", "section": "9.2.5"},
    "RECTANGLE": {"where": ["level", "symbol"], "positions": [{"name": "points", "takes": "shape", "kinds": ["point", "terminal"]}], "params": [{"name": "width", "type": "number"}, {"name": "height", "type": "number"}, {"name": "fill", "values": ["none", "linecolor", "fillcolor"]}], "style": "area_style", "output": "new:annotation", "section": "9.2.5"},
    "CIRCLE": {"where": ["level", "symbol"], "positions": [{"name": "points", "takes": "shape", "kinds": ["point", "terminal"]}], "params": [{"name": "radius", "type": "number"}, {"name": "fill", "values": ["none", "linecolor", "fillcolor"]}], "style": "area_style", "output": "new:annotation", "section": "9.2.5"},
    "ELLIPSE": {"where": ["level", "symbol"], "positions": [{"name": "points", "takes": "shape", "kinds": ["point", "terminal"]}], "params": [{"name": "width", "type": "number"}, {"name": "height", "type": "number"}, {"name": "fill", "values": ["none", "linecolor", "fillcolor"]}], "style": "area_style", "output": "new:annotation", "section": "9.2.5"},
    "ARC": {"where": ["level", "symbol"], "positions": [{"name": "points", "takes": "set", "kinds": ["point", "terminal"]}], "params": [{"name": "arrow", "values": ["none", "start", "end", "both"]}, {"name": "fill", "values": ["none", "linecolor", "fillcolor"]}], "style": "line_style", "output": "new:annotation", "section": "9.2.5"},
    "BEZIER": {"where": ["level", "symbol"], "positions": [{"name": "points", "takes": "set", "kinds": ["point", "terminal"]}], "params": [{"name": "arrow", "values": ["none", "start", "end", "both"]}, {"name": "fill", "values": ["none", "linecolor", "fillcolor"]}], "style": "line_style", "output": "new:annotation", "section": "9.2.5"},
    "TEXT": {"where": ["level", "symbol"], "positions": [{"name": "attach", "takes": "one", "kinds": ["point", "instance", "usage", "bundle", "terminal", "wire", "annotation", "net", "owner"]}], "params": [{"name": "text", "type": "string", "required": true}, {"name": "key", "type": "string"}, {"name": "dx", "type": "number"}, {"name": "dy", "type": "number"}, {"name": "halign", "values": ["start", "middle", "end"]}, {"name": "valign", "values": ["baseline", "top", "middle", "bottom"]}, {"name": "rotate", "values": [0, 90, 180, 270]}], "positional": ["text"], "style": "text_style", "output": "new:text", "section": "13.3"},
    "PLACE": {"where": ["level", "symbol"], "positions": [{"name": "target", "takes": "one", "kinds": ["instance", "usage", "bundle", "point", "text", "position"]}], "params": [{"name": "x", "type": "number"}, {"name": "y", "type": "number"}, {"name": "priority", "values": ["disabled", "low", "normal", "high"]}], "positional": ["x", "y"], "at_least_one": ["x", "y"], "output": "pass", "override": "geometry", "section": "11.1"},
    "ORIENT": {"where": ["level", "symbol"], "positions": [{"name": "target", "takes": "one", "kinds": ["instance", "usage", "bundle"]}], "params": [{"name": "code", "values": ["R0", "R90", "R180", "R270", "MX", "MY", "MXR90", "MYR90"], "required": true}, {"name": "priority", "values": ["disabled", "low", "normal", "high"]}], "positional": ["code"], "output": "pass", "override": "geometry", "section": "11.2"},
    "LAYER": {"where": ["level"], "positions": [{"name": "target", "takes": "one", "kinds": ["instance", "usage", "bundle", "wire", "annotation", "text"]}], "params": [{"name": "layer", "values": ["bottom", "middle", "top"], "required": true}], "positional": ["layer"], "output": "pass", "override": "key", "section": "11.6"},
    "SELECT-INSTANCE": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["level", "any"]}], "params": [{"name": "name", "type": "string"}, {"name": "model", "type": "string"}, {"name": "type", "type": "string"}, {"name": "role", "type": "string"}, {"name": "recursive", "type": "bool"}], "output": "new:select:instance", "section": "10.1"},
    "SELECT-TERMINAL": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["level", "any"]}], "params": [{"name": "name", "type": "string"}, {"name": "model", "type": "string"}, {"name": "type", "type": "string"}, {"name": "terminal", "type": "term"}, {"name": "net", "type": "string"}, {"name": "wired", "type": "bool"}, {"name": "current", "values": ["in", "out", "unspecified"]}, {"name": "role", "type": "string"}, {"name": "recursive", "type": "bool"}], "output": "new:select:terminal", "section": "10.1"},
    "SELECT-NET": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["level", "any"]}], "params": [{"name": "name", "type": "string"}, {"name": "port", "type": "bool"}, {"name": "wired", "type": "bool"}, {"name": "global", "type": "bool"}, {"name": "role", "type": "string"}, {"name": "recursive", "type": "bool"}], "output": "new:select:net", "section": "10.1"},
    "SELECT-WIRE": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["level", "any"]}], "params": [{"name": "net", "type": "string"}, {"name": "bus", "type": "bool"}, {"name": "role", "type": "string"}, {"name": "recursive", "type": "bool"}], "output": "new:select:wire", "section": "10.1"},
    "SELECT-LABEL": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["level", "any"]}], "params": [{"name": "key", "type": "string"}, {"name": "role", "type": "string"}, {"name": "recursive", "type": "bool"}], "output": "new:select:label", "section": "10.1"},
    "SELECT-ANNOTATION": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["level", "any"]}], "params": [{"name": "role", "type": "string"}, {"name": "recursive", "type": "bool"}], "output": "new:select:annotation", "section": "10.1"},
    "SELECT-USAGE": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["level", "usage"]}, {"name": "definition", "takes": "def:definition", "optional": true}], "params": [{"name": "recursive", "type": "bool"}], "output": "new:select:usage", "section": "10.1"},
    "SELECT-ANCESTOR-USAGE": {"where": ["level"], "positions": [{"name": "scope", "takes": "any", "kinds": ["any"]}, {"name": "definition", "takes": "def:definition"}], "params": [{"name": "recursive", "type": "bool"}], "output": "new:select:usage", "section": "10.1"},
    "SET-SYMBOL": {"where": ["level", "symbol"], "positions": [{"name": "target", "takes": "one", "kinds": ["instance", "usage", "bundle", "level"]}, {"name": "symbol", "takes": "def:symbol"}], "params": [], "output": "pass", "override": "queue", "phase": 4, "section": "11.3"},
    "SET-STYLE": {"where": ["level"], "positions": [{"name": "target", "takes": "one", "kinds": ["instance", "usage", "bundle", "wire", "annotation", "text"]}, {"name": "style", "takes": "def:style"}], "params": [], "output": "pass", "override": "queue", "phase": 8, "section": "11.3"},
    "AS": {"where": ["level", "symbol"], "positions": "definition", "definition_at": "last", "params": "definition", "output": "new:usage", "phase": 5, "section": "9.4"},
    "ATTACH": {"where": ["level", "symbol"], "positions": "definition", "definition_at": "first", "params": "definition", "output": "new:usage", "phase": 5, "section": "9.4"},
    "WIRE": {"where": ["level"], "positions": [{"name": "net", "takes": "any", "kinds": ["net"]}, {"name": "points", "takes": "set", "kinds": ["terminal", "point"]}], "params": [{"name": "mode", "values": ["auto", "straight", "horizontal-vertical", "vertical-horizontal", "manhattan", "manhattan45"]}], "style": "wire_style", "output": "new:wire", "section": "13.1"},
    "ROUTE": {"where": ["level"], "positions": [{"name": "net", "takes": "one", "kinds": ["net"]}], "params": [{"name": "mode", "values": ["auto", "straight", "horizontal-vertical", "vertical-horizontal", "manhattan", "manhattan45"]}], "style": "wire_style", "output": "new:route", "section": "13.7"},
    "BUNDLE": {"where": ["level"], "positions": [{"name": "members", "takes": "set", "kinds": ["instance"]}], "params": [], "output": "new:bundle", "section": "11.8"},
    "GROUP": {"where": ["level"], "positions": [{"name": "members", "takes": "set", "kinds": ["any"]}], "params": [], "output": "pass", "section": "11.5"},
    "ADD-TO": {"where": ["level"], "positions": [{"name": "items", "takes": "any", "kinds": ["any"]}, {"name": "target", "takes": "any", "kinds": ["set"]}], "params": [], "output": "pass-target", "section": "5.2.2"},
    "REMOVE-FROM": {"where": ["level"], "positions": [{"name": "items", "takes": "any", "kinds": ["any"]}, {"name": "target", "takes": "any", "kinds": ["set"]}], "params": [], "output": "pass-target", "section": "5.2.2"},
    "UNION": {"where": ["level"], "positions": [{"name": "sets", "takes": "set", "kinds": ["any"]}], "params": [], "output": "new:set", "section": "5.2.2"},
    "ALIGN": {"where": ["level"], "positions": [{"name": "members", "takes": "set", "kinds": ["locatable"]}], "params": [{"name": "axis", "values": ["x", "y"], "required": true}, {"name": "priority", "values": ["disabled", "low", "normal", "high"]}], "positional": ["axis"], "output": "new:constraint", "override": "geometry", "section": "14.2"},
    "ORDER": {"where": ["level"], "positions": [{"name": "members", "takes": "set", "kinds": ["locatable"]}], "params": [{"name": "direction", "values": ["left-to-right", "right-to-left", "bottom-to-top", "top-to-bottom", "x", "y"], "required": true}, {"name": "priority", "values": ["disabled", "low", "normal", "high"]}], "positional": ["direction"], "output": "new:constraint", "override": "geometry", "section": "14.3"},
    "DISTRIBUTE": {"where": ["level"], "positions": [{"name": "members", "takes": "set", "kinds": ["locatable"]}], "params": [{"name": "axis", "values": ["x", "y"], "required": true}, {"name": "priority", "values": ["disabled", "low", "normal", "high"]}], "positional": ["axis"], "output": "new:constraint", "override": "geometry", "section": "14.4"},
    "DISTANCE": {"where": ["level"], "positions": [{"name": "from", "takes": "any", "kinds": ["locatable"]}, {"name": "to", "takes": "any", "kinds": ["locatable"]}], "params": [{"name": "direction", "values": ["left-to-right", "right-to-left", "bottom-to-top", "top-to-bottom", "x", "y"], "required": true}, {"name": "min", "type": "number"}, {"name": "max", "type": "number"}, {"name": "exact", "type": "number"}, {"name": "priority", "values": ["disabled", "low", "normal", "high"]}], "positional": ["direction"], "at_least_one": ["min", "max", "exact"], "output": "new:constraint", "override": "geometry", "section": "14.5"},
    "ORIENT-RELATION": {"where": ["level"], "positions": [{"name": "from", "takes": "any", "kinds": ["orientable"]}, {"name": "to", "takes": "any", "kinds": ["orientable"]}], "params": [{"name": "relation", "values": ["R0", "R90", "R180", "R270", "MX", "MY", "MXR90", "MYR90"], "required": true}, {"name": "priority", "values": ["disabled", "low", "normal", "high"]}], "positional": ["relation"], "output": "new:constraint", "override": "geometry", "section": "14.9"},
    "CURRENT": {"where": ["level"], "positions": [{"name": "terminal", "takes": "one", "kinds": ["terminal"]}], "params": [{"name": "direction", "values": ["in", "out", "unspecified"], "required": true}], "positional": ["direction"], "output": "pass", "override": "key", "section": "15.2"},
    "PRIORITY": {"where": ["level"], "positions": [{"name": "target", "takes": "one", "kinds": ["constraint", "usage", "set"]}], "params": [{"name": "priority", "values": ["disabled", "low", "normal", "high"], "required": true}], "positional": ["priority"], "output": "pass", "override": "key", "section": "14.8"}
  }
}

/* rnl-std-functional 0.4, a package of the standard series 0.4 (16.3).
   Made from the files of the series 0.3 (libraries/standard/0.3), which say what they were
   generated from, and edited in rnl, whose files are the source.
   Behavioral models: op-amps, comparators, amplifiers, transconductors, ADC, DAC.
   In rnl-std-full; a file that wants it alone names it with USE-PACKAGE (16.2).
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. The pins are named with
   Analog Canvas's terminal names, which the comment above each symbol lists in order (a supply
   terminal in brackets has no pin), and bind the terminal of that name (9.2.4, 11.3). A subcircuit
   instance drawn with one of these symbols needs ports of these names, or terminals= on its
   SET-SYMBOL (11.3). */
@RNL(type="header") { @VERSION("0.4"); @PACKAGE(name="rnl-std-functional", version="0.4")}

/* ---------------------------------------------------------------- symbols (9.2) drawn from Analog Canvas */
@RNL {
  /* An op-amp of three terminals. inp inn out; from $OPAMP_5TERM without its supply terminals */
  $OPAMP = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35)
  };

  /* An op-amp of five terminals, its supply terminals not drawn. inp inn (vp) (vn) out; from Analog Canvas opamp-inputs-swapped */
  $OPAMP_5TERM = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35)
  };

  /* A fully differential op-amp, its supply terminals not drawn. inp inn outp outn (vp) (vn); from Analog Canvas opamp-differential-crossed-inputs-swapped */
  $DIFFERENTIAL_OPAMP = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %outp = (3, 1) @PIN(terminal="outp", direction="right");
    %outn = (3, -1) @PIN(terminal="outn", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(0.4641, 1) (3, 1)};
    @LINE {(0.4641, -1) (3, -1)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE(cap="round") {(-1.3538, 1.1) (-1.3538, 1.7)};
    @LINE(cap="round") {(-1.6538, 1.4) (-1.0538, 1.4)};
    @LINE(cap="round") {(-1.6538, -1.4) (-1.0538, -1.4)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35)
  };

  /* A comparator, its supply terminals not drawn. inp inn out (vp) (vn); from Analog Canvas comparator-inputs-swapped */
  $COMPARATOR = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE {(-1.8038, -0.7) (-1.0038, -0.7) (-1.0038, 0.7) (-0.2038, 0.7)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35)
  };

  /* A comparator of five terminals in a macromodel's order, its supply terminals not drawn. inp inn (vp) (vn) out; from $COMPARATOR with its terminals in the macromodel's order */
  $COMPARATOR_5TERM = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE {(-1.8038, -0.7) (-1.0038, -0.7) (-1.0038, 0.7) (-0.2038, 0.7)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35)
  };

  /* A voltage amplifier, its supply terminals not drawn. in out (vp) (vn); from Analog Canvas voltage-amplifier */
  $VOLTAGE_AMPLIFIER = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %in = (-4, 0) @PIN(terminal="in", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 0) (-3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE {(2.1962, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35)
  };

  /* A transconductor (a gm cell), its supply terminals not drawn. in out (vp) (vn); from Analog Canvas transconductance */
  $TRANSCONDUCTOR = @DEFINE-SYMBOL(box=[-3, -3.9, 3, 3.9]) {
    %in = (-3, 0) @PIN(terminal="in", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-3, 0) (-2, 0)};
    @LINE(linewidth=0.24) {(-2, 3.5) (2, 1.75) (2, -1.75) (-2, -3.5) (-2, 3.5)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\textit{g}_{m}", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.85)
  };

  /* A transconductor with a differential input, its supply terminals not drawn. inp inn out (vp) (vn); from Analog Canvas differential-transconductance-inputs-swapped */
  $DIFFERENTIAL_TRANSCONDUCTOR = @DEFINE-SYMBOL(box=[-3, -3.9, 3, 3.9]) {
    %inp = (-3, 1) @PIN(terminal="inp", direction="left");
    %inn = (-3, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE(linewidth=0.24) {(-2, 3.5) (2, 1.75) (2, -1.75) (-2, -3.5) (-2, 3.5)};
    @LINE(cap="round") {(-1.3, 1) (-0.7, 1)};
    @LINE(cap="round") {(-1, 0.7) (-1, 1.3)};
    @LINE(cap="round") {(-1.3, -1) (-0.7, -1)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\textit{g}_{m}", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0.3, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.85)
  };

  /* An analog-to-digital converter, its supply terminals not drawn. in out (vp) (vn); from Analog Canvas adc */
  $ADC = @DEFINE-SYMBOL(box=[-5, -2.4, 4, 2.4]) {
    %in = (-5, 0) @PIN(terminal="in", direction="left");
    %out = (4, 0) @PIN(terminal="out", direction="right");
    @LINE {(-5, 0) (-4, 0)};
    @LINE(linewidth=0.24) {(3, 2) (-2, 2) (-4, 0) (-2, -2) (3, -2) (3, 2)};
    @LINE {(3, 0) (4, 0)};
    ? @TEXT("ADC", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(-0.028, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 2.35)
  };

  /* A digital-to-analog converter, its supply terminals not drawn. in out (vp) (vn); from Analog Canvas dac */
  $DAC = @DEFINE-SYMBOL(box=[-4, -2.4, 5, 2.4]) {
    %in = (-4, 0) @PIN(terminal="in", direction="left");
    %out = (5, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 0) (-3, 0)};
    @LINE(linewidth=0.24) {(-3, 2) (2, 2) (4, 0) (2, -2) (-3, -2) (-3, 2)};
    @LINE {(4, 0) (5, 0)};
    ? @TEXT("DAC", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0.028, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.5, 2.35)
  }
}

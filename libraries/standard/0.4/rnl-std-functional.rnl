/* rnl-std-functional 0.4, a package of the standard series 0.4 (16.3).
   Behavioral models: op-amps, comparators, amplifiers, transconductors, ADC, DAC and chopper
   modulator, with *_SUPPLY variants carrying integer-grid vp (top) and vn (bottom) pins.
   In rnl-std-all; a file that wants it alone names it with USE-PACKAGE (16.2).
   Coordinates are y-up; one unit is one grid step. The pins bind terminals by name (9.2.4, 11.3),
   listed in canonical order (signals before supplies, inputs before outputs, + before -, vp before vn)
   above each symbol. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-functional", version="0.4");
}

@RNL {
  /* ---------------------------------------------------------------- op-amps and comparators (9.2) */

  /* An op-amp of three terminals: inp, inn, out. */
  $OPAMP = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35);
  };

  /* An op-amp with supply pins: inp, inn, out, vp, vn. */
  $OPAMP_SUPPLY = @DEFINE-SYMBOL(box=[-4, -3, 3, 3]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    %vp = (-1, 3) @PIN(terminal="vp", direction="up");
    %vn = (-1, -3) @PIN(terminal="vn", direction="down");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(-1, 1.8453) (-1, 3)};
    @LINE {(-1, -1.8453) (-1, -3)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.2, 1.8);
  };

  /* A fully differential op-amp: inp, inn, outp, outn. */
  $DIFFERENTIAL_OPAMP = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %outp = (3, 1) @PIN(terminal="outp", direction="right");
    %outn = (3, -1) @PIN(terminal="outn", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(0.4641, 1) (3, 1)};
    @LINE {(0.4641, -1) (3, -1)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE(cap="round") {(-0.5, 0.6) (-0.5, 1.2)};
    @LINE(cap="round") {(-0.8, 0.9) (-0.2, 0.9)};
    @LINE(cap="round") {(-0.8, -0.9) (-0.2, -0.9)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35);
  };

  /* A fully differential op-amp with supply pins: inp, inn, outp, outn, vp, vn. */
  $DIFFERENTIAL_OPAMP_SUPPLY = @DEFINE-SYMBOL(box=[-4, -3, 3, 3]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %outp = (3, 1) @PIN(terminal="outp", direction="right");
    %outn = (3, -1) @PIN(terminal="outn", direction="right");
    %vp = (-1, 3) @PIN(terminal="vp", direction="up");
    %vn = (-1, -3) @PIN(terminal="vn", direction="down");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(-1, 1.8453) (-1, 3)};
    @LINE {(-1, -1.8453) (-1, -3)};
    @LINE {(0.4641, 1) (3, 1)};
    @LINE {(0.4641, -1) (3, -1)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE(cap="round") {(-0.5, 0.6) (-0.5, 1.2)};
    @LINE(cap="round") {(-0.8, 0.9) (-0.2, 0.9)};
    @LINE(cap="round") {(-0.8, -0.9) (-0.2, -0.9)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.2, 2.15);
  };

  /* A fully differential op-amp with its output polarity swapped (outn above, outp below): inp, inn, outp, outn. */
  $DIFFERENTIAL_OPAMP_TWISTED = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %outp = (3, -1) @PIN(terminal="outp", direction="right");
    %outn = (3, 1) @PIN(terminal="outn", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(0.4641, 1) (3, 1)};
    @LINE {(0.4641, -1) (3, -1)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE(cap="round") {(-0.8, 0.9) (-0.2, 0.9)};
    @LINE(cap="round") {(-0.5, -1.2) (-0.5, -0.6)};
    @LINE(cap="round") {(-0.8, -0.9) (-0.2, -0.9)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35);
  };

  /* A fully differential op-amp with twisted outputs and supply pins: inp, inn, outp, outn, vp, vn. */
  $DIFFERENTIAL_OPAMP_TWISTED_SUPPLY = @DEFINE-SYMBOL(box=[-4, -3, 3, 3]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %outp = (3, -1) @PIN(terminal="outp", direction="right");
    %outn = (3, 1) @PIN(terminal="outn", direction="right");
    %vp = (-1, 3) @PIN(terminal="vp", direction="up");
    %vn = (-1, -3) @PIN(terminal="vn", direction="down");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(-1, 1.8453) (-1, 3)};
    @LINE {(-1, -1.8453) (-1, -3)};
    @LINE {(0.4641, 1) (3, 1)};
    @LINE {(0.4641, -1) (3, -1)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE(cap="round") {(-0.8, 0.9) (-0.2, 0.9)};
    @LINE(cap="round") {(-0.5, -1.2) (-0.5, -0.6)};
    @LINE(cap="round") {(-0.8, -0.9) (-0.2, -0.9)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.2, 2.15);
  };

  /* A comparator of three terminals: inp, inn, out. */
  $COMPARATOR = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE {(-1.8038, -0.7) (-1.0038, -0.7) (-1.0038, 0.7) (-0.2038, 0.7)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35);
  };

  /* A comparator with supply pins: inp, inn, out, vp, vn. */
  $COMPARATOR_SUPPLY = @DEFINE-SYMBOL(box=[-4, -3, 3, 3]) {
    %inp = (-4, 1) @PIN(terminal="inp", direction="left");
    %inn = (-4, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    %vp = (-1, 3) @PIN(terminal="vp", direction="up");
    %vn = (-1, -3) @PIN(terminal="vn", direction="down");
    @LINE {(-4, 1) (-3, 1)};
    @LINE {(-4, -1) (-3, -1)};
    @LINE {(-1, 1.8453) (-1, 3)};
    @LINE {(-1, -1.8453) (-1, -3)};
    @LINE {(2.1962, 0) (3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE(cap="round") {(-2.375, 1.1) (-2.375, 1.7)};
    @LINE(cap="round") {(-2.675, 1.4) (-2.075, 1.4)};
    @LINE(cap="round") {(-2.675, -1.4) (-2.075, -1.4)};
    @LINE {(-1.8038, -0.7) (-1.0038, -0.7) (-1.0038, 0.7) (-0.2038, 0.7)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.2, 1.8);
  };

  /* ---------------------------------------------------------------- amplifiers, transconductors and converters */

  /* A voltage amplifier, with an optional centered text of key label: in, out. */
  $VOLTAGE_AMPLIFIER = @DEFINE-SYMBOL(box=[-4, -3.4, 3, 3.4]) {
    %in = (-4, 0) @PIN(terminal="in", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 0) (-3, 0)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE {(2.1962, 0) (3, 0)};
    ? @TEXT("", key="label", halign="middle", valign="middle", size=1.2) => @PLACE(-1.2, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 3.35);
  };

  /* A voltage amplifier with supply pins: in, out, vp, vn. */
  $VOLTAGE_AMPLIFIER_SUPPLY = @DEFINE-SYMBOL(box=[-4, -3, 3, 3]) {
    %in = (-4, 0) @PIN(terminal="in", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    %vp = (-1, 3) @PIN(terminal="vp", direction="up");
    %vn = (-1, -3) @PIN(terminal="vn", direction="down");
    @LINE {(-4, 0) (-3, 0)};
    @LINE {(-1, 1.8453) (-1, 3)};
    @LINE {(-1, -1.8453) (-1, -3)};
    @LINE(linewidth=0.24) {(-3, 3) (-3, -3) (2.1962, 0) (-3, 3)};
    @LINE {(2.1962, 0) (3, 0)};
    ? @TEXT("", key="label", halign="middle", valign="middle", size=1.2) => @PLACE(-1.2, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.2, 1.8);
  };

  /* A transconductor (a gm cell), with an optional centered text of key label: in, out. */
  $TRANSCONDUCTOR = @DEFINE-SYMBOL(box=[-3, -3.9, 3, 3.9]) {
    %in = (-3, 0) @PIN(terminal="in", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-3, 0) (-2, 0)};
    @LINE(linewidth=0.24) {(-2, 3.5) (2, 1.75) (2, -1.75) (-2, -3.5) (-2, 3.5)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("", key="label", halign="middle", valign="middle", size=1.2) => @PLACE(0, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.85);
  };

  /* A transconductor with supply pins: in, out, vp, vn. */
  $TRANSCONDUCTOR_SUPPLY = @DEFINE-SYMBOL(box=[-3, -4, 3, 4]) {
    %in = (-3, 0) @PIN(terminal="in", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    %vp = (0, 4) @PIN(terminal="vp", direction="up");
    %vn = (0, -4) @PIN(terminal="vn", direction="down");
    @LINE {(-3, 0) (-2, 0)};
    @LINE {(0, 2.625) (0, 4)};
    @LINE {(0, -2.625) (0, -4)};
    @LINE(linewidth=0.24) {(-2, 3.5) (2, 1.75) (2, -1.75) (-2, -3.5) (-2, 3.5)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("", key="label", halign="middle", valign="middle", size=1.2) => @PLACE(0, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.65, 2.65);
  };

  /* A transconductor with a differential input: inp, inn, out. */
  $DIFFERENTIAL_TRANSCONDUCTOR = @DEFINE-SYMBOL(box=[-3, -3.9, 3, 3.9]) {
    %inp = (-3, 1) @PIN(terminal="inp", direction="left");
    %inn = (-3, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE(linewidth=0.24) {(-2, 3.5) (2, 1.75) (2, -1.75) (-2, -3.5) (-2, 3.5)};
    @LINE(cap="round") {(-1.3, 1) (-0.7, 1)};
    @LINE(cap="round") {(-1, 0.7) (-1, 1.3)};
    @LINE(cap="round") {(-1.3, -1) (-0.7, -1)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\textit{g}_{m}", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0.3, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.85);
  };

  /* A differential-input transconductor with supply pins: inp, inn, out, vp, vn. */
  $DIFFERENTIAL_TRANSCONDUCTOR_SUPPLY = @DEFINE-SYMBOL(box=[-3, -4, 3, 4]) {
    %inp = (-3, 1) @PIN(terminal="inp", direction="left");
    %inn = (-3, -1) @PIN(terminal="inn", direction="left");
    %out = (3, 0) @PIN(terminal="out", direction="right");
    %vp = (0, 4) @PIN(terminal="vp", direction="up");
    %vn = (0, -4) @PIN(terminal="vn", direction="down");
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(0, 2.625) (0, 4)};
    @LINE {(0, -2.625) (0, -4)};
    @LINE(linewidth=0.24) {(-2, 3.5) (2, 1.75) (2, -1.75) (-2, -3.5) (-2, 3.5)};
    @LINE(cap="round") {(-1.3, 1) (-0.7, 1)};
    @LINE(cap="round") {(-1, 0.7) (-1, 1.3)};
    @LINE(cap="round") {(-1.3, -1) (-0.7, -1)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\textit{g}_{m}", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0.3, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.65, 2.65);
  };

  /* An analog-to-digital converter: in, out. */
  $ADC = @DEFINE-SYMBOL(box=[-5, -2.4, 4, 2.4]) {
    %in = (-5, 0) @PIN(terminal="in", direction="left");
    %out = (4, 0) @PIN(terminal="out", direction="right");
    @LINE {(-5, 0) (-4, 0)};
    @LINE(linewidth=0.24) {(3, 2) (-2, 2) (-4, 0) (-2, -2) (3, -2) (3, 2)};
    @LINE {(3, 0) (4, 0)};
    ? @TEXT("ADC", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(-0.028, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 2.35);
  };

  /* An analog-to-digital converter with supply pins: in, out, vp, vn. */
  $ADC_SUPPLY = @DEFINE-SYMBOL(box=[-5, -3, 4, 3]) {
    %in = (-5, 0) @PIN(terminal="in", direction="left");
    %out = (4, 0) @PIN(terminal="out", direction="right");
    %vp = (0, 3) @PIN(terminal="vp", direction="up");
    %vn = (0, -3) @PIN(terminal="vn", direction="down");
    @LINE {(-5, 0) (-4, 0)};
    @LINE {(0, 2) (0, 3)};
    @LINE {(0, -2) (0, -3)};
    @LINE(linewidth=0.24) {(3, 2) (-2, 2) (-4, 0) (-2, -2) (3, -2) (3, 2)};
    @LINE {(3, 0) (4, 0)};
    ? @TEXT("ADC", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(-0.028, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(1.7, 2.35);
  };

  /* A digital-to-analog converter: in, out. */
  $DAC = @DEFINE-SYMBOL(box=[-4, -2.4, 5, 2.4]) {
    %in = (-4, 0) @PIN(terminal="in", direction="left");
    %out = (5, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 0) (-3, 0)};
    @LINE(linewidth=0.24) {(-3, 2) (2, 2) (4, 0) (2, -2) (-3, -2) (-3, 2)};
    @LINE {(4, 0) (5, 0)};
    ? @TEXT("DAC", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0.028, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.5, 2.35);
  };

  /* A digital-to-analog converter with supply pins: in, out, vp, vn. */
  $DAC_SUPPLY = @DEFINE-SYMBOL(box=[-4, -3, 5, 3]) {
    %in = (-4, 0) @PIN(terminal="in", direction="left");
    %out = (5, 0) @PIN(terminal="out", direction="right");
    %vp = (0, 3) @PIN(terminal="vp", direction="up");
    %vn = (0, -3) @PIN(terminal="vn", direction="down");
    @LINE {(-4, 0) (-3, 0)};
    @LINE {(0, 2) (0, 3)};
    @LINE {(0, -2) (0, -3)};
    @LINE(linewidth=0.24) {(-3, 2) (2, 2) (4, 0) (2, -2) (-3, -2) (-3, 2)};
    @LINE {(4, 0) (5, 0)};
    ? @TEXT("DAC", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0.028, 0);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-1.6, 2.35);
  };

  /* A chopper modulator block (distinct from the switch-bridge structure $CHOPPER): inp, inn, outp, outn. */
  $CHOPPER_SYMBOL = @DEFINE-SYMBOL(box=[-2, -3.4, 2, 3.4]) {
    %inp = (-2, 1) @PIN(terminal="inp", direction="left");
    %inn = (-2, -1) @PIN(terminal="inn", direction="left");
    %outp = (2, 1) @PIN(terminal="outp", direction="right");
    %outn = (2, -1) @PIN(terminal="outn", direction="right");
    @LINE {(-2, 1) (-0.8, 1)};
    @LINE {(-2, -1) (-0.8, -1)};
    @LINE {(0.8, 1) (2, 1)};
    @LINE {(0.8, -1) (2, -1)};
    @LINE(linewidth=0.24) {(-0.8, 3) (0.8, 3) (0.8, -3) (-0.8, -3) (-0.8, 3)};
    @LINE {(-0.8, 3) (0.8, -3)};
    @LINE {(0.8, 3) (-0.8, -3)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 3.35);
  };
}

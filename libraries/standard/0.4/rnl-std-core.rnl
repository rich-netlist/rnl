/* rnl-std-core 0.4, a package of the standard series 0.4 (16.3).
   Made from the files of the series 0.3 (libraries/standard/0.3), which say what they were
   generated from, and edited in rnl, whose files are the source.
   The smallest collection of the series (16.3): it references rnl-std-style, rnl-std-basic,
   rnl-std-semiconductors and the rule packages of the two dialects, rnl-std-spice and
   rnl-std-spectre, and has no content of its own. It draws the netlist and adds nothing. A file
   of the language 0.4 uses each dialect's rules in that language's host sections (2.8, 16.3). */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-core", version="0.4");
  @USE-PACKAGE(name="rnl-std-style", version="0.4");
  @USE-PACKAGE(name="rnl-std-basic", version="0.4");
  @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4")
}
@RNL(type="header", language="spice") {
  @USE-PACKAGE(name="rnl-std-spice", version="0.4")
}
@RNL(type="header", language="spectre") {
  @USE-PACKAGE(name="rnl-std-spectre", version="0.4")
}

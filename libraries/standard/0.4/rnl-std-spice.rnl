/* rnl-std-spice 0.4, a package of the standard series 0.4 (16.3).
   The rule package of SPICE: assigns symbols to instances by element letter, by model type, and by
   bulk or control-negative net (16.3). */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-spice", version="0.4");
  @USE-PACKAGE(name="rnl-std-basic", version="0.4");
  @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4");
}

/* ---------------------------------------------------------------- symbol rules for SPICE netlists */
@RNL {
  /* Broad rules by element letter (all native SPICE elements except subcircuit calls). */
  # @SELECT-INSTANCE(name="R*", recursive=true) => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(name="C*", recursive=true) => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(name="L*", recursive=true) => @SET-SYMBOL $INDUCTOR;
  # @SELECT-INSTANCE(name="V*", recursive=true) => @SET-SYMBOL $VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(name="I*", recursive=true) => @SET-SYMBOL $CURRENT_SOURCE;
  # @SELECT-INSTANCE(name="D*", recursive=true) => @SET-SYMBOL $DIODE;
  # @SELECT-INSTANCE(name="E*", recursive=true) => @SET-SYMBOL $VCVS_4TERM;
  # @SELECT-INSTANCE(name="G*", recursive=true) => @SET-SYMBOL $VCCS_4TERM;
  # @SELECT-INSTANCE(name="F*", recursive=true) => @SET-SYMBOL $CONTROLLED_CURRENT_SOURCE;
  # @SELECT-INSTANCE(name="H*", recursive=true) => @SET-SYMBOL $CONTROLLED_VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(name="B*", recursive=true) => @SET-SYMBOL $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(name="S*", recursive=true) => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH;
  # @SELECT-INSTANCE(name="W*", recursive=true) => @SET-SYMBOL $SWITCH;
  # @SELECT-INSTANCE(name="T*", recursive=true) => @SET-SYMBOL $TRANSMISSION_LINE;
  # @SELECT-INSTANCE(name="O*", recursive=true) => @SET-SYMBOL $TRANSMISSION_LINE;
  # @SELECT-INSTANCE(name="U*", recursive=true) => @SET-SYMBOL $RC_LINE;

  /* Narrower rules by the model type of the .model card. */
  # @SELECT-INSTANCE(type="d", recursive=true) => @SET-SYMBOL $DIODE;
  # @SELECT-INSTANCE(type="r", recursive=true) => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(type="c", recursive=true) => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(type="l", recursive=true) => @SET-SYMBOL $INDUCTOR;
  # @SELECT-INSTANCE(type="sw", recursive=true) => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH;
  # @SELECT-INSTANCE(type="nmos", recursive=true) => @SET-SYMBOL $NMOS_4TERM;
  # @SELECT-INSTANCE(type="npn", recursive=true) => @SET-SYMBOL $NPN;
  # @SELECT-INSTANCE(type="njf", recursive=true) => @SET-SYMBOL $NJFET;
  # @SELECT-INSTANCE(type="nmf", recursive=true) => @SET-SYMBOL $NJFET;
  # @SELECT-INSTANCE(type="pmos", recursive=true) => @SET-SYMBOL $PMOS_4TERM;
  # @SELECT-INSTANCE(type="pnp", recursive=true) => @SET-SYMBOL $PNP;
  # @SELECT-INSTANCE(type="lpnp", recursive=true) => @SET-SYMBOL $PNP;
  # @SELECT-INSTANCE(type="pjf", recursive=true) => @SET-SYMBOL $PJFET;
  # @SELECT-INSTANCE(type="pmf", recursive=true) => @SET-SYMBOL $PJFET;
  # @SELECT-INSTANCE(type="tline", recursive=true) => @SET-SYMBOL $TRANSMISSION_LINE;

  /* Three-terminal symbols when MOS bulk is on a ground/supply net or switch cn is on a ground net. */
  $GROUND_NET_SET @SELECT-TERMINAL(type="nmos", terminal="b", recursive=true) => @SELECT-INSTANCE(recursive=true) => @SET-SYMBOL $NMOS;
  $SUPPLY_NET_SET @SELECT-TERMINAL(type="pmos", terminal="b", recursive=true) => @SELECT-INSTANCE(recursive=true) => @SET-SYMBOL $PMOS;
  $GROUND_NET_SET @SELECT-TERMINAL(name="S*", terminal="cn", recursive=true) => @SELECT-INSTANCE(recursive=true) => @SET-SYMBOL $EXTERNALLY_CONTROLLED_SWITCH;
  $GROUND_NET_SET @SELECT-TERMINAL(type="sw", terminal="cn", recursive=true) => @SELECT-INSTANCE(recursive=true) => @SET-SYMBOL $EXTERNALLY_CONTROLLED_SWITCH;
}

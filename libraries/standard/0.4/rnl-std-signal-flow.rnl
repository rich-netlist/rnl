/* rnl-std-signal-flow 0.4, a package of the standard series 0.4 (16.3).
   Ideal signal-flow virtual parts and their symbols: adder, subtractor, multiplier, continuous-time
   and discrete-time integrators, quantizer and unit delay.
   In rnl-std-all; a file that wants it alone names it with USE-PACKAGE (16.2).
   Coordinates are y-up; one unit is one grid step. Each block is a virtual part whose roles take nets
   (or the empty node &, 6.3), bound to the pins of its _SYMBOL by role name (9.2.4, 11.3, 12.1); a
   subcircuit instance can also use one of the _SYMBOL definitions with SET-SYMBOL and terminals=. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-signal-flow", version="0.4");
}

@RNL {
  /* ---------------------------------------------------------------- symbols (9.2) */

  /* The symbol of $ADDER: a summing circle with arrowheads on its input leads a (in1) and b (in2), and output y (out). */
  $ADDER_SYMBOL = @DEFINE-SYMBOL(box=[-2, -2, 2, 1.6]) {
    %a = (-2, 0) @PIN(terminal="in1", direction="left");
    %b = (0, -2) @PIN(terminal="in2", direction="down");
    %y = (2, 0) @PIN(terminal="out", direction="right");
    @LINE {(-2, 0) (-1.65, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3, 0) (-1.8, 0.25) (-1.8, -0.25) (-1.3, 0)};
    @LINE {(0, -2) (0, -1.65)};
    @LINE(fill="linecolor", linestyle="none") {(0, -1.3) (-0.25, -1.8) (0.25, -1.8) (0, -1.3)};
    (0, 0) @CIRCLE(radius=1.2, linewidth=0.24);
    @LINE {(1.3, 0) (2, 0)};
    @LINE(cap="round") {(-0.6, 0) (0.6, 0)};
    @LINE(cap="round") {(0, 0.6) (0, -0.6)};
    ? @TEXT("", key="name", halign="middle", fix_rotate=true) => @PLACE(0, 1.55);
  };

  /* The symbol of $SUBTRACTOR: a summing circle with + in the center and - outside by its negative input b (in2), inputs a (in1) and b (in2), and output y (out). */
  $SUBTRACTOR_SYMBOL = @DEFINE-SYMBOL(box=[-2, -2, 2, 1.6]) {
    %a = (-2, 0) @PIN(terminal="in1", direction="left");
    %b = (0, -2) @PIN(terminal="in2", direction="down");
    %y = (2, 0) @PIN(terminal="out", direction="right");
    @LINE {(-2, 0) (-1.65, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3, 0) (-1.8, 0.25) (-1.8, -0.25) (-1.3, 0)};
    @LINE {(0, -2) (0, -1.65)};
    @LINE(fill="linecolor", linestyle="none") {(0, -1.3) (-0.25, -1.8) (0.25, -1.8) (0, -1.3)};
    (0, 0) @CIRCLE(radius=1.2, linewidth=0.24);
    @LINE {(1.3, 0) (2, 0)};
    @LINE(cap="round") {(-0.6, 0) (0.6, 0)};
    @LINE(cap="round") {(0, 0.6) (0, -0.6)};
    @LINE(cap="round") {(-0.9, -1.55) (-0.45, -1.55)};
    ? @TEXT("", key="name", halign="middle", fix_rotate=true) => @PLACE(0, 1.55);
  };

  /* The symbol of $MULTIPLIER: a product circle with arrowheads on its input leads a (in1) and b (in2), and output y (out). */
  $MULTIPLIER_SYMBOL = @DEFINE-SYMBOL(box=[-2, -2, 2, 1.6]) {
    %a = (-2, 0) @PIN(terminal="in1", direction="left");
    %b = (0, -2) @PIN(terminal="in2", direction="down");
    %y = (2, 0) @PIN(terminal="out", direction="right");
    @LINE {(-2, 0) (-1.65, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3, 0) (-1.8, 0.25) (-1.8, -0.25) (-1.3, 0)};
    @LINE {(0, -2) (0, -1.65)};
    @LINE(fill="linecolor", linestyle="none") {(0, -1.3) (-0.25, -1.8) (0.25, -1.8) (0, -1.3)};
    (0, 0) @CIRCLE(radius=1.2, linewidth=0.24);
    @LINE {(1.3, 0) (2, 0)};
    @LINE(cap="round") {(-0.4243, 0.4243) (0.4243, -0.4243)};
    @LINE(cap="round") {(-0.4243, -0.4243) (0.4243, 0.4243)};
    ? @TEXT("", key="name", halign="middle", fix_rotate=true) => @PLACE(0, 1.55);
  };

  /* The symbol of $INTEGRATOR: a box marked 1/s with input a (in) and output y (out). */
  $INTEGRATOR_SYMBOL = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 0) @PIN(terminal="in", direction="left");
    %y = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-3, 0) (-2.45, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1, 0) (-2.6, 0.25) (-2.6, -0.25) (-2.1, 0)};
    @LINE(linewidth=0.24) {(-2, 2) (2, 2) (2, -2) (-2, -2) (-2, 2)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\frac{1}{\textit{s}}", key="formula", halign="middle", valign="middle", size=1.2, fix_rotate=true) => @PLACE(0, 0);
    ? @TEXT("", key="name", halign="middle", fix_rotate=true) => @PLACE(0, 2.35);
  };

  /* The symbol of $DISCRETE_TIME_INTEGRATOR: a box marked with its z-domain transfer function, input a (in) and output y (out). */
  $DISCRETE_TIME_INTEGRATOR_SYMBOL = @DEFINE-SYMBOL(box=[-4, -2.4, 4, 2.4]) {
    %a = (-4, 0) @PIN(terminal="in", direction="left");
    %y = (4, 0) @PIN(terminal="out", direction="right");
    @LINE {(-4, 0) (-3.45, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-3.1, 0) (-3.6, 0.25) (-3.6, -0.25) (-3.1, 0)};
    @LINE(linewidth=0.24) {(-3, 2) (3, 2) (3, -2) (-3, -2) (-3, 2)};
    @LINE {(3, 0) (4, 0)};
    ? @TEXT("\frac{\textit{z}^{-1}}{1-\textit{z}^{-1}}", key="formula", halign="middle", valign="middle", size=1.2, fix_rotate=true) => @PLACE(0, 0);
    ? @TEXT("", key="name", halign="middle", fix_rotate=true) => @PLACE(0, 2.35);
  };

  /* The symbol of $QUANTIZER: a box with a staircase, input a (in) and output y (out). */
  $QUANTIZER_SYMBOL = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 0) @PIN(terminal="in", direction="left");
    %y = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-3, 0) (-2.45, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1, 0) (-2.6, 0.25) (-2.6, -0.25) (-2.1, 0)};
    @LINE(linewidth=0.24) {(-2, 2) (2, 2) (2, -2) (-2, -2) (-2, 2)};
    @LINE {(2, 0) (3, 0)};
    @LINE(cap="round", join="round") {(-1.4, -1.5) (-0.7, -1.5) (-0.7, -0.5) (0, -0.5) (0, 0.5) (0.7, 0.5) (0.7, 1.5) (1.4, 1.5)};
    ? @TEXT("", key="name", halign="middle", fix_rotate=true) => @PLACE(0, 2.35);
  };

  /* The symbol of $UNIT_DELAY: a box marked z to the minus one, input a (in) and output y (out). */
  $UNIT_DELAY_SYMBOL = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 0) @PIN(terminal="in", direction="left");
    %y = (3, 0) @PIN(terminal="out", direction="right");
    @LINE {(-3, 0) (-2.45, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1, 0) (-2.6, 0.25) (-2.6, -0.25) (-2.1, 0)};
    @LINE(linewidth=0.24) {(-2, 1.5) (2, 1.5) (2, -1.5) (-2, -1.5) (-2, 1.5)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\textit{z}^{-1}", key="formula", halign="middle", valign="middle", size=1.2, fix_rotate=true) => @PLACE(0, 0);
    ? @TEXT("", key="name", halign="middle", fix_rotate=true) => @PLACE(0, 1.85);
  };

  /* ---------------------------------------------------------------- virtual parts (9.4, 12.1) */

  /* An ideal signal-flow adder (out = in1 + in2), drawn with $ADDER_SYMBOL. */
  $ADDER = @DEFINE(roles=[["in1", "net"], ["in2", "net"], ["out", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $ADDER => @SET-SYMBOL $ADDER_SYMBOL;

  /* An ideal signal-flow subtractor (out = in1 - in2), drawn with $SUBTRACTOR_SYMBOL. */
  $SUBTRACTOR = @DEFINE(roles=[["in1", "net"], ["in2", "net"], ["out", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $SUBTRACTOR => @SET-SYMBOL $SUBTRACTOR_SYMBOL;

  /* An ideal signal-flow multiplier (out = in1 * in2), drawn with $MULTIPLIER_SYMBOL. */
  $MULTIPLIER = @DEFINE(roles=[["in1", "net"], ["in2", "net"], ["out", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $MULTIPLIER => @SET-SYMBOL $MULTIPLIER_SYMBOL;

  /* An ideal continuous-time integrator, drawn with $INTEGRATOR_SYMBOL. */
  $INTEGRATOR = @DEFINE(roles=[["in", "net"], ["out", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $INTEGRATOR => @SET-SYMBOL $INTEGRATOR_SYMBOL;

  /* An ideal discrete-time integrator, drawn with $DISCRETE_TIME_INTEGRATOR_SYMBOL. */
  $DISCRETE_TIME_INTEGRATOR = @DEFINE(roles=[["in", "net"], ["out", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $DISCRETE_TIME_INTEGRATOR => @SET-SYMBOL $DISCRETE_TIME_INTEGRATOR_SYMBOL;

  /* An ideal quantizer, drawn with $QUANTIZER_SYMBOL. */
  $QUANTIZER = @DEFINE(roles=[["in", "net"], ["out", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $QUANTIZER => @SET-SYMBOL $QUANTIZER_SYMBOL;

  /* An ideal unit delay, drawn with $UNIT_DELAY_SYMBOL. */
  $UNIT_DELAY = @DEFINE(roles=[["in", "net"], ["out", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $UNIT_DELAY => @SET-SYMBOL $UNIT_DELAY_SYMBOL;
}

/* rnl-std-signal-flow 0.4, a package of the standard series 0.4 (16.3).
   Made from the files of the series 0.3 (libraries/standard/0.3), which say what they were
   generated from, and edited in rnl, whose files are the source.
   Signal-flow blocks: adder, multiplier, and the drawing-only integrators, quantizer and unit delay.
   In rnl-std-full; a file that wants it alone names it with USE-PACKAGE (16.2).
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. The pins are named with
   Analog Canvas's terminal names, which the comment above each symbol lists in order (a supply
   terminal in brackets has no pin), and bind the terminal of that name (9.2.4, 11.3). A subcircuit
   instance drawn with one of these symbols needs ports of these names, or terminals= on its
   SET-SYMBOL (11.3). */
@RNL(type="header") { @VERSION("0.4"); @PACKAGE(name="rnl-std-signal-flow", version="0.4")}

/* ---------------------------------------------------------------- symbols (9.2) drawn from Analog Canvas */
@RNL {
  /* A signal-flow adder: a summing node. a b y (vp) (vn); from Analog Canvas adder */
  $ADDER = @DEFINE-SYMBOL(box=[-2, -2, 2, 1.6]) {
    %a = (-2, 0) @PIN(terminal="a", direction="left");
    %b = (0, -2) @PIN(terminal="b", direction="down");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (0, 0) @CIRCLE(radius=1.2, linewidth=0.24);
    @LINE {(1.3, 0) (2, 0)};
    @LINE {(0, -1.3) (0, -2)};
    @LINE(cap="round") {(-0.6, 0) (0.6, 0)};
    @LINE(cap="round") {(0, 0.6) (0, -0.6)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.55)
  };

  /* A signal-flow multiplier. a b y (vp) (vn); from Analog Canvas multiplier */
  $MULTIPLIER = @DEFINE-SYMBOL(box=[-2, -2, 2, 1.6]) {
    %a = (-2, 0) @PIN(terminal="a", direction="left");
    %b = (0, -2) @PIN(terminal="b", direction="down");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (0, 0) @CIRCLE(radius=1.2, linewidth=0.24);
    @LINE {(1.3, 0) (2, 0)};
    @LINE {(0, -1.3) (0, -2)};
    @LINE(cap="round") {(-0.4243, 0.4243) (0.4243, -0.4243)};
    @LINE(cap="round") {(-0.4243, -0.4243) (0.4243, 0.4243)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.55)
  };

  /* The symbol of $INTEGRATOR: a box marked 1/s. Its pins a y bind nothing and are wired by name (9.2.4);
     from Analog Canvas integrator */
  $INTEGRATOR_SYMBOL = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 0) @PIN(direction="left");
    %y = (3, 0) @PIN(direction="right");
    @LINE {(-3, 0) (-2, 0)};
    @LINE(linewidth=0.24) {(-2, 2) (2, 2) (2, -2) (-2, -2) (-2, 2)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\frac{1}{\textit{s}}", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0, 0)
  };

  /* The symbol of $DISCRETE_TIME_INTEGRATOR: a box with its transfer function in z. Its pins a y bind
     nothing and are wired by name (9.2.4); from Analog Canvas discrete-time-integrator */
  $DISCRETE_TIME_INTEGRATOR_SYMBOL = @DEFINE-SYMBOL(box=[-4, -2.4, 4, 2.4]) {
    %a = (-4, 0) @PIN(direction="left");
    %y = (4, 0) @PIN(direction="right");
    @LINE {(-4, 0) (-3, 0)};
    @LINE(linewidth=0.24) {(-3, 2) (3, 2) (3, -2) (-3, -2) (-3, 2)};
    @LINE {(3, 0) (4, 0)};
    ? @TEXT("\frac{\textit{z}^{-1}}{1-\textit{z}^{-1}}", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0, 0)
  };

  /* The symbol of $QUANTIZER: a box with a staircase. Its pins a y bind nothing and are wired by name
     (9.2.4); from Analog Canvas quantizer */
  $QUANTIZER_SYMBOL = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 0) @PIN(direction="left");
    %y = (3, 0) @PIN(direction="right");
    @LINE {(-3, 0) (-2, 0)};
    @LINE(linewidth=0.24) {(-2, 2) (2, 2) (2, -2) (-2, -2) (-2, 2)};
    @LINE {(2, 0) (3, 0)};
    @LINE(cap="round", join="round") {(-1.4, -1.5) (-0.7, -1.5) (-0.7, -0.5) (0, -0.5) (0, 0.5) (0.7, 0.5) (0.7, 1.5) (1.4, 1.5)}
  };

  /* The symbol of $UNIT_DELAY: a box marked z to the minus one. Its pins a y bind nothing and are wired by
     name (9.2.4); from Analog Canvas unit-delay */
  $UNIT_DELAY_SYMBOL = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 0) @PIN(direction="left");
    %y = (3, 0) @PIN(direction="right");
    @LINE {(-3, 0) (-2, 0)};
    @LINE(linewidth=0.24) {(-2, 1.5) (2, 1.5) (2, -1.5) (-2, -1.5) (-2, 1.5)};
    @LINE {(2, 0) (3, 0)};
    ? @TEXT("\textit{z}^{-1}", key="formula", halign="middle", valign="middle", size=1.2) => @PLACE(0, 0)
  }
}

/* ---------------------------------------------------------------- rnl-std-signal-flow: drawing-only parts (9.2.7, 13.4) */
@RNL {
  /* only drawn, with no netlist line: usages on a point, each drawn by the definition's _SYMBOL
     at its own point, which the body ties to the point (12.1 item 5); the rule that draws them right
     under each definition (12.1) */
  /* A continuous-time integrator drawn as a figure on a point, with no netlist line. */
  $INTEGRATOR = @DEFINE(roles=[["at", "point"]]) { {? ?at} @ALIGN("x"); {? ?at} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $INTEGRATOR => @SET-SYMBOL $INTEGRATOR_SYMBOL;
  /* A discrete-time integrator drawn as a figure on a point, with no netlist line. */
  $DISCRETE_TIME_INTEGRATOR = @DEFINE(roles=[["at", "point"]]) { {? ?at} @ALIGN("x"); {? ?at} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $DISCRETE_TIME_INTEGRATOR => @SET-SYMBOL $DISCRETE_TIME_INTEGRATOR_SYMBOL;
  /* A quantizer drawn as a figure on a point, with no netlist line. */
  $QUANTIZER = @DEFINE(roles=[["at", "point"]]) { {? ?at} @ALIGN("x"); {? ?at} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $QUANTIZER => @SET-SYMBOL $QUANTIZER_SYMBOL;
  /* A unit delay drawn as a figure on a point, with no netlist line. */
  $UNIT_DELAY = @DEFINE(roles=[["at", "point"]]) { {? ?at} @ALIGN("x"); {? ?at} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $UNIT_DELAY => @SET-SYMBOL $UNIT_DELAY_SYMBOL
}

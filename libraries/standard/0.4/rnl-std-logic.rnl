/* rnl-std-logic 0.4, a package of the standard series 0.4 (16.3).
   Gates, buffer, inverter, delay cell and D flip-flops.
   In rnl-std-all; a file that wants it alone names it with USE-PACKAGE (16.2).
   Coordinates are y-up; one unit is one grid step. The pins bind terminals by name (9.2.4, 11.3),
   listed in the comment above each symbol. A subcircuit instance drawn with one of these symbols
   needs ports of these names, or terminals= on its SET-SYMBOL (11.3). */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-logic", version="0.4");
}

@RNL {
  /* ---------------------------------------------------------------- gates of two and three inputs (9.2) */

  /* An AND gate of two inputs: a, b, y. */
  $AND_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, -1) @PIN(terminal="b", direction="left");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(1.5, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 1.85);
  };

  /* An AND gate of three inputs: a, b, c, y. */
  $AND_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, 0) (-2, 0)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(1.5, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 1.85);
  };

  /* A NAND gate of two inputs: a, b, y. */
  $NAND_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, -1) @PIN(terminal="b", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    (2.05, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(2.3875, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.85);
  };

  /* A NAND gate of three inputs: a, b, c, y. */
  $NAND_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    (2.05, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, 0) (-2, 0)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(2.3875, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.85);
  };

  /* An OR gate of two inputs: a, b, y. */
  $OR_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, -1) @PIN(terminal="b", direction="left");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(1.58, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 2.15);
  };

  /* An OR gate of three inputs: a, b, c, y. */
  $OR_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, 0) (-1.25, 0)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(1.58, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 2.15);
  };

  /* A NOR gate of two inputs: a, b, y. */
  $NOR_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, -1) @PIN(terminal="b", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    (2, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.3375, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15);
  };

  /* A NOR gate of three inputs: a, b, c, y. */
  $NOR_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    (2, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, 0) (-1.25, 0)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.3375, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15);
  };

  /* An XOR gate of two inputs: a, b, y. */
  $XOR_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, -1) @PIN(terminal="b", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.23, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15);
  };

  /* An XOR gate of three inputs: a, b, c, y. */
  $XOR_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, 0) (-1.25, 0)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.23, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15);
  };

  /* An XNOR gate of two inputs: a, b, y. */
  $XNOR_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 4, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, -1) @PIN(terminal="b", direction="left");
    %y = (4, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    (2.65, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.9875, 0) (4, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.5, 2.15);
  };

  /* An XNOR gate of three inputs: a, b, c, y. */
  $XNOR_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 4, 2.4]) {
    %a = (-3, 1) @PIN(terminal="a", direction="left");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %y = (4, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    (2.65, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, 0) (-1.25, 0)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.9875, 0) (4, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.5, 2.15);
  };

  /* ---------------------------------------------------------------- gates of four inputs, on integer grid points */

  /* An AND gate of four inputs on integer grid points: a, b, c, d, y. */
  $AND_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    %a = (-3, 2) @PIN(terminal="a", direction="left");
    %b = (-3, 1) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %d = (-3, -2) @PIN(terminal="d", direction="left");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    @LINE {(-3, 2) (-2, 2)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(-3, -2) (-2, -2)};
    @LINE(linewidth=0.24) {(-2, 2) (-2, 1.5)};
    @LINE(linewidth=0.24) {(-2, -1.5) (-2, -2)};
    @LINE {(1.5, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 1.85);
  };

  /* A NAND gate of four inputs on integer grid points: a, b, c, d, y. */
  $NAND_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 2) @PIN(terminal="a", direction="left");
    %b = (-3, 1) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %d = (-3, -2) @PIN(terminal="d", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    (2.05, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 2) (-2, 2)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(-3, -2) (-2, -2)};
    @LINE(linewidth=0.24) {(-2, 2) (-2, 1.5)};
    @LINE(linewidth=0.24) {(-2, -1.5) (-2, -2)};
    @LINE {(2.3875, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.85);
  };

  /* An OR gate of four inputs on integer grid points: a, b, c, d, y. */
  $OR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    %a = (-3, 2) @PIN(terminal="a", direction="left");
    %b = (-3, 1) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %d = (-3, -2) @PIN(terminal="d", direction="left");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    @LINE {(-3, 2) (-2, 2)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(-3, -2) (-2, -2)};
    @LINE(linewidth=0.24, cap="round") {(-2, 2) (-2, 1.78)};
    @LINE(linewidth=0.24, cap="round") {(-2, -1.78) (-2, -2)};
    @LINE {(1.58, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 2.15);
  };

  /* A NOR gate of four inputs on integer grid points: a, b, c, d, y. */
  $NOR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 2) @PIN(terminal="a", direction="left");
    %b = (-3, 1) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %d = (-3, -2) @PIN(terminal="d", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    (2, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 2) (-2, 2)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(-3, -2) (-2, -2)};
    @LINE(linewidth=0.24, cap="round") {(-2, 2) (-2, 1.78)};
    @LINE(linewidth=0.24, cap="round") {(-2, -1.78) (-2, -2)};
    @LINE {(2.3375, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15);
  };

  /* An XOR gate of four inputs on integer grid points: a, b, c, d, y. */
  $XOR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    %a = (-3, 2) @PIN(terminal="a", direction="left");
    %b = (-3, 1) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %d = (-3, -2) @PIN(terminal="d", direction="left");
    %y = (3, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @LINE {(-3, 2) (-2, 2)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(-3, -2) (-2, -2)};
    @LINE(linewidth=0.24, cap="round") {(-2, 2) (-2, 1.78)};
    @LINE(linewidth=0.24, cap="round") {(-2, -1.78) (-2, -2)};
    @LINE {(2.23, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15);
  };

  /* An XNOR gate of four inputs on integer grid points: a, b, c, d, y. */
  $XNOR_4INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 4, 2.4]) {
    %a = (-3, 2) @PIN(terminal="a", direction="left");
    %b = (-3, 1) @PIN(terminal="b", direction="left");
    %c = (-3, -1) @PIN(terminal="c", direction="left");
    %d = (-3, -2) @PIN(terminal="d", direction="left");
    %y = (4, 0) @PIN(terminal="y", direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    (2.65, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 2) (-2, 2)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(-3, -2) (-2, -2)};
    @LINE(linewidth=0.24, cap="round") {(-2, 2) (-2, 1.78)};
    @LINE(linewidth=0.24, cap="round") {(-2, -1.78) (-2, -2)};
    @LINE {(2.9875, 0) (4, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0.5, 2.15);
  };

  /* ---------------------------------------------------------------- buffer, inverter, delay cell and D flip-flops */

  /* A buffer: a, y. */
  $BUFFER = @DEFINE-SYMBOL(box=[-3, -2.4, 1, 2.4]) {
    %a = (-3, 0) @PIN(terminal="a", direction="left");
    %y = (1, 0) @PIN(terminal="y", direction="right");
    @LINE {(-3, 0) (-2, 0)};
    @LINE(linewidth=0.24) {(0.375, 0) (-2, -1.4999) (-2, 1.375) (0.375, 0)};
    @LINE {(0.375, 0) (1, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-1, 1.7);
  };

  /* An inverter (a NOT gate): a, y. */
  $INVERTER = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    %a = (-3, 0) @PIN(terminal="a", direction="left");
    %y = (2, 0) @PIN(terminal="y", direction="right");
    @LINE {(-3, 0) (-2, 0)};
    @LINE(linewidth=0.24) {(0.3751, 0) (-2, 1.5) (-2, -1.3748) (0.3751, 0)};
    (0.7522, -0.001) @CIRCLE(radius=0.375, linewidth=0.24);
    @LINE {(1.1272, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 1.85);
  };

  /* A delay cell: a, y. */
  $DELAY_CELL = @DEFINE-SYMBOL(box=[-4, -2.4, 4, 2.4]) {
    %a = (-4, 0) @PIN(terminal="a", direction="left");
    %y = (4, 0) @PIN(terminal="y", direction="right");

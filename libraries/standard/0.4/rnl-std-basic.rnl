/* rnl-std-basic 0.4, a package of the standard series 0.4 (16.3).
   Made from the files of the series 0.3 (libraries/standard/0.3), which say what they were
   generated from, and edited in rnl, whose files are the source.
   The symbols of passive parts, sources, switches and transmission lines, of the virtual parts
   and the marks; the definitions of the virtual parts and of the parts that are only drawn, each
   with the rule that draws its usages, and the stubs of ground, supply, port and net label.
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. The pins of a device
   symbol are named with the standard terminal names of SPICE, in SPICE's order, and bind the
   terminal of that name (6.12, 11.3), so #R1::p is the pin of #R1:p. The transformer, which SPICE
   does not have, takes the names of T, p1 n1 p2 n2; the closed and the externally controlled
   switches those of S, p n cp cn. A one-pin virtual part names its pin pin. The header record
   tells a solver to mark the junctions of its wires with $JUNCTION (SOLVER-CONFIG junction, 14.10). */
@RNL(type="header") { @VERSION("0.4"); @PACKAGE(name="rnl-std-basic", version="0.4"); @SOLVER-CONFIG(junction="$JUNCTION")}

/* ---------------------------------------------------------------- rnl-std-basic: symbols (9.2) drawn from Analog Canvas */
@RNL {
  /* A resistor. p n; from Analog Canvas resistor */
  $RESISTOR = @DEFINE-SYMBOL(box=[-1, -2, 1, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.95, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(0.95, -1.2)
  };

  /* A variable resistor: a resistor with an arrow across it. p n; from Analog Canvas variable-resistor */
  $VARIABLE_RESISTOR = @DEFINE-SYMBOL(box=[-1.6, -2, 1.6, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -1.2)
  };

  /* A capacitor. p n; from Analog Canvas capacitor */
  $CAPACITOR = @DEFINE-SYMBOL(box=[-1.2, -2, 1.2, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.2, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.2, -1.2)
  };

  /* A variable capacitor: a capacitor with an arrow across it. p n; from Analog Canvas variable-capacitor */
  $VARIABLE_CAPACITOR = @DEFINE-SYMBOL(box=[-1.6, -2, 1.6, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -1.2)
  };

  /* An inductor. p n; from Analog Canvas inductor-compact */
  $INDUCTOR = @DEFINE-SYMBOL(box=[-1, -2, 1, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 1.2)};
    @ARC(cap="round") {(0, 1.2) (0.2121, 1.1121) (0.3, 0.9)};
    @ARC {(0.3, 0.9) (0.2121, 0.6879) (0, 0.6)};
    @ARC {(0, 0.6) (0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0, -0.6)};
    @ARC {(0, -0.6) (0.2121, -0.6879) (0.3, -0.9)};
    @ARC(cap="round") {(0.3, -0.9) (0.2121, -1.1121) (0, -1.2)};
    @LINE {(0, -1.2) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.7, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(0.7, -1.2)
  };

  /* A variable inductor: an inductor with an arrow across it. p n; from Analog Canvas variable-inductor */
  $VARIABLE_INDUCTOR = @DEFINE-SYMBOL(box=[-1.6, -2, 1.6, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 1.2)};
    @ARC(cap="round") {(0, 1.2) (0.2121, 1.1121) (0.3, 0.9)};
    @ARC {(0.3, 0.9) (0.2121, 0.6879) (0, 0.6)};
    @ARC {(0, 0.6) (0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0, -0.6)};
    @ARC {(0, -0.6) (0.2121, -0.6879) (0.3, -0.9)};
    @ARC(cap="round") {(0.3, -0.9) (0.2121, -1.1121) (0, -1.2)};
    @LINE {(0, -1.2) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -1.2)
  };

  /* A transformer: two coupled windings, their dots on the right. p1 n1 p2 n2; from Analog Canvas xfmr */
  $TRANSFORMER = @DEFINE-SYMBOL(box=[-2, -2.4, 2, 2.4]) {
    %n1 = (-2, 1) @PIN(terminal="n1", direction="left");
    %p1 = (2, 1) @PIN(terminal="p1", direction="right");
    %n2 = (-2, -1) @PIN(terminal="n2", direction="left");
    %p2 = (2, -1) @PIN(terminal="p2", direction="right");
    @LINE {(-2, 1) (-1.2, 1)};
    @ARC(cap="round") {(-1.2, 1) (-1.1121, 0.7879) (-0.9, 0.7)};
    @ARC {(-0.9, 0.7) (-0.6879, 0.7879) (-0.6, 1)};
    @ARC {(-0.6, 1) (-0.3, 0.7) (0, 1)};
    @ARC {(0, 1) (0.3, 0.7) (0.6, 1)};
    @ARC {(0.6, 1) (0.6879, 0.7879) (0.9, 0.7)};
    @ARC(cap="round") {(0.9, 0.7) (1.1121, 0.7879) (1.2, 1)};
    @LINE {(1.2, 1) (2, 1)};
    @LINE {(-2, -1) (-1.2, -1)};
    @ARC(cap="round") {(-1.2, -1) (-1.1121, -0.7879) (-0.9, -0.7)};
    @ARC {(-0.9, -0.7) (-0.6879, -0.7879) (-0.6, -1)};
    @ARC {(-0.6, -1) (-0.3, -0.7) (0, -1)};
    @ARC {(0, -1) (0.3, -0.7) (0.6, -1)};
    @ARC {(0.6, -1) (0.6879, -0.7879) (0.9, -0.7)};
    @ARC(cap="round") {(0.9, -0.7) (1.1121, -0.7879) (1.2, -1)};
    @LINE {(1.2, -1) (2, -1)};
    (1.6, 1.45) @CIRCLE(radius=0.229, fill="linecolor", linestyle="none");
    (1.6, -1.45) @CIRCLE(radius=0.229, fill="linecolor", linestyle="none");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.05)
  };

  /* An independent voltage source. p n; from Analog Canvas voltage-source */
  $VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2)
  };

  /* An independent current source, its arrow from p to n. p n; from Analog Canvas current-source */
  $CURRENT_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2)
  };

  /* A battery. p n; from Analog Canvas battery */
  $BATTERY = @DEFINE-SYMBOL(box=[-2.4, -2, 2.4, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 0.3361)};
    @LINE {(0, -0.3361) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.5341, 0.496) (1.5367, 0.496) (1.5367, 0.1762) (-1.5341, 0.1762) (-1.5341, 0.496)};
    @LINE(fill="linecolor", linestyle="none") {(-0.7988, -0.1762) (0.8006, -0.1762) (0.8006, -0.496) (-0.7988, -0.496) (-0.7988, -0.1762)};
    @LINE {(0.7919, 1.3416) (1.5986, 1.3416)};
    @LINE {(1.1952, 1.745) (1.1952, 0.9385)};
    @LINE {(0.7919, -1.3472) (1.5986, -1.3472)};
    ? @TEXT("${name}", key="name") => @PLACE(2, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(2, -1.2)
  };

  /* A voltage-controlled voltage source (E) drawn with its output pins only. p n (cp) (cn); from Analog Canvas vcvs (diamond) */
  $VCVS = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2)
  };

  /* A voltage-controlled current source (G) drawn with its output pins only. p n (cp) (cn); from Analog Canvas vccs (diamond) */
  $VCCS = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2)
  };

  /* A current-controlled current source (F). p n; from Analog Canvas cccs (diamond) */
  $CCCS = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2)
  };

  /* A current-controlled voltage source (H). p n; from Analog Canvas ccvs (diamond) */
  $CCVS = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2)
  };

  /* A switch drawn open, for a current-controlled switch (W) or a switch of Spectre. p n (cp) (cn); from Analog Canvas ideal-switch */
  $SWITCH = @DEFINE-SYMBOL(box=[-2, -1.2, 2, 1.8]) {
    %p = (-2, 0) @PIN(terminal="p", direction="left");
    %n = (2, 0) @PIN(terminal="n", direction="right");
    @LINE {(-2, 0) (-1.2727, 0)};
    (-0.9524, 0.002) @CIRCLE(radius=0.3203);
    @LINE {(-0.6954, 0.2418) (0.6406, 1.2807)};
    (1.1201, 0.002) @CIRCLE(radius=0.3202);
    @LINE {(1.4403, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.65)
  };

  /* A switch drawn closed. p n (cp) (cn); from Analog Canvas closed-switch */
  $CLOSED_SWITCH = @DEFINE-SYMBOL(box=[-2, -1.2, 2, 1.2]) {
    %p = (-2, 0) @PIN(terminal="p", direction="left");
    %n = (2, 0) @PIN(terminal="n", direction="right");
    @LINE {(-2, 0) (-1.3562, 0)};
    (-1.0363, 0) @CIRCLE(radius=0.3199);
    @LINE {(-0.7187, 0.1496) (1.3609, 0.4694)};
    (1.0363, 0) @CIRCLE(radius=0.3199);
    @LINE {(1.3562, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 0.8)
  };

  /* A switch with a control pin at its side. p n cp (cn); from Analog Canvas externally-controlled-switch */
  $EXTERNALLY_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-2, -2, 2.4, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    %cp = (-2, 0) @PIN(terminal="cp", direction="left");
    @LINE {(0, 2) (0, 1.2414)};
    (0, 0.9215) @CIRCLE(radius=0.3199);
    @LINE {(-0.2636, 0.6896) (-1.3529, -0.6998)};
    @LINE {(-2, 0) (-0.7428, 0)};
    (0, -1.1511) @CIRCLE(radius=0.3199);
    @LINE {(0, -1.471) (0, -2)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.85, 2.35)
  };

  /* A voltage-controlled switch (S), its control pins below it. p n cp cn; from Analog Canvas voltage-controlled-switch */
  $VOLTAGE_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-2, -3.8, 2, 1.7]) {
    %p = (-2, 0) @PIN(terminal="p", direction="left");
    %n = (2, 0) @PIN(terminal="n", direction="right");
    %cp = (-2, -3) @PIN(terminal="cp", direction="left");
    %cn = (2, -3) @PIN(terminal="cn", direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (-1, 0) @CIRCLE(radius=0.3);
    @LINE {(-0.7, 0.24) (0.64, 1.28)};
    (1.1, 0) @CIRCLE(radius=0.3);
    @LINE {(1.4, 0) (2, 0)};
    @LINE {(-2, -3) (-1, -3)};
    @LINE {(1, -3) (2, -3)};
    @LINE {(-1, -2.4) (1, -2.4) (1, -3.6) (-1, -3.6) (-1, -2.4)};
    @LINE {(-0.8, -3) (-0.2, -3)};
    @LINE {(-0.5, -2.7) (-0.5, -3.3)};
    @LINE {(0.2, -3) (0.8, -3)};
    @LINE {(0, -2.4) (0, -2)};
    @LINE {(0, -1.6) (0, -1.2)};
    @LINE {(0, -0.8) (0, -0.6)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.65)
  };

  /* The symbol of $SPDT_SWITCH: a single-pole double-throw switch. Its pins com a b bind nothing and are
     wired by name, %sw::com (9.2.4); from Analog Canvas spdt-switch */
  $SPDT_SWITCH_SYMBOL = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %com = (-2, 0) @PIN(direction="left");
    %a = (2, 1) @PIN(direction="right");
    %b = (2, -1) @PIN(direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (-1, 0) @CIRCLE(radius=0.3);
    @LINE {(-0.732, 0.134) (0.732, 0.866)};
    (1, 1) @CIRCLE(radius=0.3);
    @LINE {(1.3, 1) (2, 1)};
    (1, -1) @CIRCLE(radius=0.3);
    @LINE {(1.3, -1) (2, -1)}
  };

  /* The symbol of $GROUND: a ground, its pin at the top. Its pin, %g::pin, binds the role p (12.1); from Analog Canvas ground */
  $GROUND_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, -2.7, 1.2, 0]) {
    %pin = (0, 0) @PIN(terminal="p", direction="up");
    @LINE {(0, 0) (0, -1)};
    @LINE(linewidth=0.2907) {(-0.6395, -1) (0.6395, -1)};
    @LINE(linewidth=0.2907) {(-0.407, -1.5814) (0.407, -1.5814)};
    @LINE(linewidth=0.2907) {(-0.2326, -2.1047) (0.2326, -2.1047)}
  };

  /* The symbol of $SUPPLY: a bar with the name of its net, its pin at the bottom. Its pin, %s::pin, binds the role p (12.1); from Analog Canvas vdd-port */
  $SUPPLY_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, 0, 1.2, 2.2]) {
    %pin = (0, 0) @PIN(terminal="p", direction="down");
    @LINE {(0, 0) (0, 1.85)};
    @LINE(fill="linecolor", linestyle="none") {(-1, 2.088) (1, 2.088) (1, 1.764) (-1, 1.764) (-1, 2.088)};
    ? @TEXT("${p}", key="name", halign="middle", valign="bottom") => @PLACE(0, 2.4)
  };

  /* The symbol of $IO_PORT: a small circle with the name of its net, its pin on the right. Its pin, %p::pin, binds the role p (12.1); from Analog Canvas port */
  $IO_PORT_SYMBOL = @DEFINE-SYMBOL(box=[-1.4, -0.7, 0, 0.7]) {
    %pin = (0, 0) @PIN(terminal="p", direction="right");
    (-0.7087, 0) @CIRCLE(radius=0.2479);
    @LINE {(0, 0) (-0.4608, 0)};
    ? @TEXT("${p}", key="name", halign="end", valign="middle") => @PLACE(-1.25, 0)
  }
}

/* rnl-std-basic, drawn by hand: what Analog Canvas has no drawing for. In the manner of the drawings
   above: strokes of the style's width, 0.24 where Analog Canvas emphasizes (a capacitor plate), arcs
   rather than Bezier curves, pins on integer points, the box on the pins where a side has pins. */
@RNL {
  /* The symbol of $ARROW: a filled arrow head pointing right. Analog Canvas's arrow head,
     1.657 long and 0.79 wide, centred on the point */
  $ARROW_SYMBOL = @DEFINE-SYMBOL(box=[-0.85, -0.4, 0.85, 0.4]) { @LINE(fill="linecolor", linestyle="none") {(0.8285, 0) (-0.8285, 0.3953) (-0.8285, -0.3953) (0.8285, 0)}};

  /* E and G with four terminals, p n cp cn: rnl-std 0.2's layout, the output pins at (0, ±2)
     as in $VCVS, Analog Canvas's diamond, and control leads that reach its sides, + and − between */
  %CONTROLLED_SOURCE_BODY = @DEFINE-SYMBOL {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    %cp = (-4, 1) @PIN(terminal="cp", direction="left");
    %cn = (-4, -1) @PIN(terminal="cn", direction="left");
    @LINE {(0, 2) (0, 1.25)};
    @LINE {(0, -1.25) (0, -2)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(-4, 1) (-3, 1) (-0.75, 0.5)};
    @LINE {(-4, -1) (-3, -1) (-0.75, -0.5)};
    (-2.5, 0.4) @TEXT("+", halign="middle", valign="middle", size=0.8);
    (-2.5, -0.4) @TEXT("−", halign="middle", valign="middle", size=0.8);
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2)
  };
  /* A voltage-controlled voltage source (E) with its control pins on the left. */
  $VCVS_4TERM = @DEFINE-SYMBOL(box=[-4, -2, 1.65, 2]) {
    %CONTROLLED_SOURCE_BODY;
    @LINE {(-0.35, 0.55) (0.35, 0.55)};
    @LINE {(0, 0.2) (0, 0.9)};
    @LINE {(-0.35, -0.55) (0.35, -0.55)}
  };
  /* A voltage-controlled current source (G) with its control pins on the left. The arrow of Analog Canvas's VCCS */
  $VCCS_4TERM = @DEFINE-SYMBOL(box=[-4, -2, 1.65, 2]) {
    %CONTROLLED_SOURCE_BODY;
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)}
  };

  /* A behavioral source (B): a circle with a B. B (Spectre's bsource), p n. Its V= or I= makes it a voltage
     or a current source, and no selection condition sees that, so one drawing: the source body of Analog
     Canvas with a B */
  $BEHAVIORAL_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 1.0756)};
    @LINE {(0, -1.0756) (0, -2)};
    (0, 0) @CIRCLE(radius=1.0756);
    (0, 0) @TEXT("B", halign="middle", valign="middle", size=1.1);
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2)
  };

  /* An RF port: a source with its own resistance, for the port of Spectre. Spectre's port, p n: a source
     with its own resistance; the resistor is Analog Canvas's, at 0.8 of its size */
  $RF_PORT = @DEFINE-SYMBOL(box=[-1.5, -3, 1.5, 3]) {
    %p = (0, 3) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    @LINE {(0, 3) (0, 2.75) (0.43, 2.56) (-0.37, 2.38) (0.43, 2.14) (-0.4, 1.91) (0.43, 1.68) (-0.37, 1.45) (0, 1.35) (0, 1.0756)};
    @LINE {(0, -1.0756) (0, -3)};
    (0, 0) @CIRCLE(radius=1.0756);
    /* a sine of two half circles */
    @ARC {(-0.6, 0) (-0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0.6, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2)
  };

  /* A transmission line (T or O), port 1 on the left and port 2 on the right. T (lossless) and O (lossy): port 1 on the left, port 2 on the right, p1 n1 p2 n2 (6.12) */
  $TRANSMISSION_LINE = @DEFINE-SYMBOL(box=[-4, -2, 4, 1.2]) {
    %p1 = (-4, 0) @PIN(terminal="p1", direction="left");
    %n1 = (-2, -2) @PIN(terminal="n1", direction="down");
    %p2 = (4, 0) @PIN(terminal="p2", direction="right");
    %n2 = (2, -2) @PIN(terminal="n2", direction="down");
    @LINE {(-4, 0) (-2.3, 0)};
    @LINE {(2.3, 0) (4, 0)};
    @LINE {(-2, -2) (-2, -0.8)};
    @LINE {(2, -2) (2, -0.8)};
    (-2, 0) @ELLIPSE(width=0.6, height=1.6);
    @LINE {(-2, 0.8) (2, 0.8)};
    @LINE {(-2, -0.8) (2, -0.8)};
    /* the far end: an arc through the ends of the ellipse's half */
    @ARC {(2, 0.8) (2.3, 0) (2, -0.8)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.15)
  };

  /* A uniform distributed RC line (U). U, the uniform RC line: the two ends, then the node its capacitance goes to, a b ref (6.12) */
  $RC_LINE = @DEFINE-SYMBOL(box=[-4, -2, 4, 0.8]) {
    %a = (-4, 0) @PIN(terminal="a", direction="left");
    %b = (4, 0) @PIN(terminal="b", direction="right");
    %ref = (0, -2) @PIN(terminal="ref", direction="down");
    @LINE {(-4, 0) (-2, 0) (-1.667, 0.4) (-1, -0.4) (-0.333, 0.4) (0.333, -0.4) (1, 0.4) (1.667, -0.4) (2, 0) (4, 0)};
    @LINE(linewidth=0.24) {(-2, -0.9) (2, -0.9)};
    @LINE {(0, -0.9) (0, -2)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 0.75)
  };

  /* marks: the cross of no connection (12.6), as in rnl-std 0.2; the dot of a junction and the arrow
     of a current (13.2, 15.2) as Analog Canvas draws them: a dot 0.378 in radius, and the arrow's head
     alone, on the wire, which is its shaft */
  /* The symbol of $NO_CONNECT: a cross. */
  $NO_CONNECT_SYMBOL = @DEFINE-SYMBOL(box=[-0.5, -0.5, 0.5, 0.5]) {
    @LINE {(-0.5, -0.5) (0.5, 0.5)};
    @LINE {(-0.5, 0.5) (0.5, -0.5)}
  };
  /* The symbol of $JUNCTION: a filled dot. */
  $JUNCTION_SYMBOL = @DEFINE-SYMBOL(box=[-0.4, -0.4, 0.4, 0.4]) {(0, 0) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none")};
  /* The symbol of $CURRENT_ARROW: an arrow head on a wire. Points right; ORIENT("R270") points down (15.2) */
  $CURRENT_ARROW_SYMBOL = @DEFINE-SYMBOL(box=[-0.85, -0.4, 0.85, 0.4]) { @LINE(fill="linecolor", linestyle="none") {(0.8285, 0) (-0.8285, 0.3953) (-0.8285, -0.3953) (0.8285, 0)}};

  /* A ground with the name of its net under it. It is for a ground net other than 0, such as vss, whose
     name no port tag shows; rnl-std-fill gives it to the grounds of those nets */
  $NAMED_GROUND_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, -2.7, 1.2, 0]) {
    $GROUND_SYMBOL;
    ? @TEXT("${p}", key="name", halign="middle", valign="top") => @PLACE(0, -2.5)
  };

  /* The symbol of $NET_LABEL: a lead of one unit and the name of its net as text, with no frame. Its
     pin, %l::pin, binds the role p and faces left, away from the lead; a $NET_LABEL_STUB puts it on the
     pin it names, facing that pin, so the lead is the stub's short wire, one unit long, and the name
     reads from its end on, as the name of $IO_PORT_SYMBOL does from its circle */
  $NET_LABEL_SYMBOL = @DEFINE-SYMBOL {
    %pin = (0, 0) @PIN(terminal="p", direction="left");
    @LINE {(0, 0) (1, 0)};
    ? @TEXT("${p}", key="name", halign="start", valign="middle") => @PLACE(1.3, 0)
  }
}

/* rnl-std-basic: definitions (9.4, 12), each virtual part with the rule that draws its usages right
   under it (12.1): its symbol is the definition's name plus _SYMBOL */
@RNL {
  /* virtual elements (12.5, 12.6, 13.2, 15.2). Their role is p (net is a standard subobject name, 9.4).
     The pin of a ground, a supply, a port tag or a net label binds p and is drawn on that net, at the
     usage's own point (12.1): a terminal or a pin given for p stands for its net (5.2.4), so
     $GROUND @ATTACH #M5:3 is a ground on the net of M5:3 with a position of its own; $GROUND_STUB
     draws one at a pin. ${p} shows the net (13.6). */
  /* A ground on a net, drawn at a point of its own. */
  $GROUND = @DEFINE(roles=[["p", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $GROUND => @SET-SYMBOL $GROUND_SYMBOL;
  /* A supply on a net, drawn at a point of its own. */
  $SUPPLY = @DEFINE(roles=[["p", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $SUPPLY => @SET-SYMBOL $SUPPLY_SYMBOL;
  /* A port tag on a net, drawn at a point of its own; its net is to be a port of its level. */
  $IO_PORT = @DEFINE(roles=[["p", "net"]]) { ?p @ASSERT-NET(port=true, message="a port tag stands on a port of its level") };
  # @SELECT-USAGE(recursive=true) $IO_PORT => @SET-SYMBOL $IO_PORT_SYMBOL;
  /* A net label: the name of a net, drawn at a point of its own. The name of a net and nothing else, where
     a wire of the net ends: $NET_LABEL_STUB draws one at a pin, as rnl-std-fill does for the pins left
     without wires */
  $NET_LABEL = @DEFINE(roles=[["p", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $NET_LABEL => @SET-SYMBOL $NET_LABEL_SYMBOL;
  /* the marks: no pin of their symbols binds the role, which takes what the mark is on; the body ties
     the usage's own point, where its symbol is drawn, to that pin or point (12.1 item 5, 12.6) */
  /* A no-connect mark on a terminal left unconnected on purpose. */
  $NO_CONNECT = @DEFINE(roles=[["t", "terminal"]]) { {? ?t} @ALIGN("x"); {? ?t} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $NO_CONNECT => @SET-SYMBOL $NO_CONNECT_SYMBOL;
  /* A junction dot on a point or a terminal. */
  $JUNCTION = @DEFINE(roles=[["p", ["point", "terminal"]]]) { {? ?p} @ALIGN("x"); {? ?p} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $JUNCTION => @SET-SYMBOL $JUNCTION_SYMBOL;
  /* A current arrow on a terminal or a point. */
  $CURRENT_ARROW = @DEFINE(roles=[["p", ["terminal", "point"]]]) { {? ?p} @ALIGN("x"); {? ?p} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $CURRENT_ARROW => @SET-SYMBOL $CURRENT_ARROW_SYMBOL;
  /* An arrow head drawn on a point. It is drawn in a symbol or in the scene (9.2.7); in a symbol body it
     is drawn at the point of its role, and its body is not expanded there */
  $ARROW = @DEFINE(roles=[["at", "point"]]) { {? ?at} @ALIGN("x"); {? ?at} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $ARROW => @SET-SYMBOL $ARROW_SYMBOL;

  /* A single-pole double-throw switch drawn as a figure on a point, with no netlist line. It is a usage on
     a point (9.2.7, 13.4), its own point tied to it. Its pins bind nothing; a wire of a real net that ends
     on one of them, by its name, ends at that pin's coordinates. */
  $SPDT_SWITCH = @DEFINE(roles=[["at", "point"]]) { {? ?at} @ALIGN("x"); {? ?at} @ALIGN("y") };
  # @SELECT-USAGE(recursive=true) $SPDT_SWITCH => @SET-SYMBOL $SPDT_SWITCH_SYMBOL;
  /* A figure drawn at a point with no netlist line, in a symbol of its own whose pins bind no
     terminal and which shows no ${name} or ${value}. Each usage writes its own SET-SYMBOL; there is
     no default, and a device symbol such as $RESISTOR does not fit. Its pins have no terminals, as $SPDT_SWITCH's. The role that
     takes the point of a part that is only drawn is at, here and in the other such parts, a name no
     symbol gives a pin: a pin named as the role would bind it (12.1), as p of $RESISTOR did */
  $FIGURE = @DEFINE(roles=[["at", "point"]]) { {? ?at} @ALIGN("x"); {? ?at} @ALIGN("y") };

  /* A port tag on every port net of a level, in one column in the order of the subcircuit's line. The tags
     are one group (12.4): $PORT_LIST @ATTACH, written once in a level by its author; the fill does not add
     it. Inputs and outputs are not told apart. A port net that has a port tag already, written by hand or
     by the solver, gets none, so that a written tag takes the place of the generated one (10.5). The order
     is the one in which SELECT-NET gives the port nets, those of the .subckt line */
  $PORT_LIST = @DEFINE(roles=[]) {
    %port_net_set = # @SELECT-NET(port=true);
    # @SELECT-USAGE $IO_PORT => @SELECT-NET => @REMOVE-FROM %port_net_set;
    $IO_PORT @ATTACH %port_net_set => %tag_set;
    %tag_set @ORDER("top-to-bottom");
    %tag_set @ALIGN("x");
    %tag_set @GROUP
  };

  /* a stub is a part with its own wire to a pin, named after the part: <part>_STUB.

     Ground and supply with their own wire, at least gap below or above a pin, pointing away from it;
     rnl-std-fill attaches them. Only the least distance is given, 1 by default, so that a solver
     draws a stub as long as its spacing asks, or longer, as when it lines up the grounds of parts of
     different lengths; the constraints are low, a default that gives way first (14.8) */
  /* A ground below a pin, with its own wire. */
  $GROUND_STUB = @DEFINE(roles=[["t", "pin"]], parameters=[["gap", 1]]) {
    %g = $GROUND @ATTACH ?t::net;
    ?t::net @WIRE {?t %g::pin};
    {?t %g::pin} @ALIGN("x", priority="low");
    %g::pin ?t @DISTANCE("bottom-to-top", min=?gap, priority="low");
    %g @ORIENT("R0", priority="low")
  };
  /* A supply above a pin, with its own wire. */
  $SUPPLY_STUB = @DEFINE(roles=[["t", "pin"]], parameters=[["gap", 1]]) {
    %s = $SUPPLY @ATTACH ?t::net;
    ?t::net @WIRE {?t %s::pin};
    {?t %s::pin} @ALIGN("x", priority="low");
    ?t %s::pin @DISTANCE("bottom-to-top", min=?gap, priority="low");
    %s @ORIENT("R0", priority="low")
  };

  /* A port tag on a pin, its lead the stub's short wire. The pin of the port tag is put on the pin, facing
     it (9.2.4, 11.2, 14.9), so the lead of $IO_PORT_SYMBOL leaves the pin the way a wire would; no wire
     is written. rnl-std-fill gives a pin with a stub of its own no net label */
  $IO_PORT_STUB = @DEFINE(roles=[["t", "pin"]]) {
    %p = $IO_PORT @ATTACH ?t::net;
    ?t %p::pin @ORIENT-RELATION("R180");
    {?t %p::pin} @ALIGN("x");
    {?t %p::pin} @ALIGN("y")
  };

  /* A net label on a pin, its lead the short wire of the stub. The label's pin is put on the pin, facing
     it (9.2.4, 11.2, 14.9): the lead of $NET_LABEL_SYMBOL, one unit long, leaves the pin the way a wire
     would, so the wire is never of length 0 and its length is the symbol's; no wire is written.
     rnl-std-fill attaches it to the pins left without wires, and gives a pin with a stub of its own no
     second one (10.5). The pin is no part of a tree of a ROUTE of the same priority written before it,
     nor of one of lower priority (13.7): the name stands for the wires. The label's own pin is on the net
     too, and no ROUTE but one of high priority written after it joins it. A terminal written for the pin
     stands for its pin (5.2.4) */
  $NET_LABEL_STUB = @DEFINE(roles=[["t", "pin"]]) {
    %l = $NET_LABEL @ATTACH ?t::net;
    ?t %l::pin @ORIENT-RELATION("R180");
    {?t %l::pin} @ALIGN("x");
    {?t %l::pin} @ALIGN("y");
    ?t @UNROUTE-OBJECT;
    %l @UNROUTE-OBJECT(priority="high")
  }
}

/* rnl-std-basic 0.4, a package of the standard series 0.4 (16.3).
   The symbols of passive parts, sources, switches, transmission lines, virtual parts and marks; the
   definitions of virtual parts, marks, figures and stubs, each with the rule that draws its usages;
   and the sets of ground, supply and bias nets.
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. The pins of a device
   symbol are named with the standard terminal names of SPICE, in SPICE's order, and bind the
   terminal of that name (6.12, 11.3), so #R1::p is the pin of #R1:p. The transformer takes the
   terminal order p1 n1 p2 n2; the closed and externally controlled switches take p n cp cn. A
   one-pin virtual part names its pin pin. The header record tells a solver to mark wire junctions
   with $JUNCTION (SOLVER-CONFIG junction, 14.10). */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-basic", version="0.4");
  @SOLVER-CONFIG(junction="$JUNCTION");
}

@RNL {
  /* ---------------------------------------------------------------- passive parts */

  /* A resistor. Terminals: p n. */
  $RESISTOR = @DEFINE-SYMBOL(box=[-1, -2, 1, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.95, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(0.95, -1.2);
  };

  /* A variable resistor: a resistor with an arrow across it. Terminals: p n. */
  $VARIABLE_RESISTOR = @DEFINE-SYMBOL(box=[-1.6, -2, 1.6, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -1.2);
  };

  /* A capacitor. Terminals: p n. */
  $CAPACITOR = @DEFINE-SYMBOL(box=[-1.2, -2, 1.2, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.2, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.2, -1.2);
  };

  /* A variable capacitor: a capacitor with an arrow across it. Terminals: p n. */
  $VARIABLE_CAPACITOR = @DEFINE-SYMBOL(box=[-1.6, -2, 1.6, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -1.2);
  };

  /* An inductor. Terminals: p n. */
  $INDUCTOR = @DEFINE-SYMBOL(box=[-1, -2, 1, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 1.2)};
    @ARC(cap="round") {(0, 1.2) (0.2121, 1.1121) (0.3, 0.9)};
    @ARC {(0.3, 0.9) (0.2121, 0.6879) (0, 0.6)};
    @ARC {(0, 0.6) (0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0, -0.6)};
    @ARC {(0, -0.6) (0.2121, -0.6879) (0.3, -0.9)};
    @ARC(cap="round") {(0.3, -0.9) (0.2121, -1.1121) (0, -1.2)};
    @LINE {(0, -1.2) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.7, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(0.7, -1.2);
  };

  /* A variable inductor: an inductor with an arrow across it. Terminals: p n. */
  $VARIABLE_INDUCTOR = @DEFINE-SYMBOL(box=[-1.6, -2, 1.6, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 1.2)};
    @ARC(cap="round") {(0, 1.2) (0.2121, 1.1121) (0.3, 0.9)};
    @ARC {(0.3, 0.9) (0.2121, 0.6879) (0, 0.6)};
    @ARC {(0, 0.6) (0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0, -0.6)};
    @ARC {(0, -0.6) (0.2121, -0.6879) (0.3, -0.9)};
    @ARC(cap="round") {(0.3, -0.9) (0.2121, -1.1121) (0, -1.2)};
    @LINE {(0, -1.2) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -1.2);
  };

  /* A transformer: two coupled windings, their polarity dots on the right. Terminals: p1 n1 p2 n2. */
  $TRANSFORMER = @DEFINE-SYMBOL(box=[-2, -2.4, 2, 2.4]) {
    %p1 = (2, 1) @PIN(terminal="p1", direction="right");
    %n1 = (-2, 1) @PIN(terminal="n1", direction="left");
    %p2 = (2, -1) @PIN(terminal="p2", direction="right");
    %n2 = (-2, -1) @PIN(terminal="n2", direction="left");
    @LINE {(-2, 1) (-1.2, 1)};
    @ARC(cap="round") {(-1.2, 1) (-1.1121, 0.7879) (-0.9, 0.7)};
    @ARC {(-0.9, 0.7) (-0.6879, 0.7879) (-0.6, 1)};
    @ARC {(-0.6, 1) (-0.3, 0.7) (0, 1)};
    @ARC {(0, 1) (0.3, 0.7) (0.6, 1)};
    @ARC {(0.6, 1) (0.6879, 0.7879) (0.9, 0.7)};
    @ARC(cap="round") {(0.9, 0.7) (1.1121, 0.7879) (1.2, 1)};
    @LINE {(1.2, 1) (2, 1)};
    @LINE {(-2, -1) (-1.2, -1)};
    @ARC(cap="round") {(-1.2, -1) (-1.1121, -0.7879) (-0.9, -0.7)};
    @ARC {(-0.9, -0.7) (-0.6879, -0.7879) (-0.6, -1)};
    @ARC {(-0.6, -1) (-0.3, -0.7) (0, -1)};
    @ARC {(0, -1) (0.3, -0.7) (0.6, -1)};
    @ARC {(0.6, -1) (0.6879, -0.7879) (0.9, -0.7)};
    @ARC(cap="round") {(0.9, -0.7) (1.1121, -0.7879) (1.2, -1)};
    @LINE {(1.2, -1) (2, -1)};
    (1.6, 1.45) @CIRCLE(radius=0.229, fill="linecolor", linestyle="none");
    (1.6, -1.45) @CIRCLE(radius=0.229, fill="linecolor", linestyle="none");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.05);
  };


  /* A three-terminal potentiometer, the wiper in the middle. Terminals: n1 nw n2. */
  $POTENTIOMETER = @DEFINE-SYMBOL(box=[-1, -2, 2, 2]) {
    %n1 = (0, 2) @PIN(terminal="n1", direction="up");
    %nw = (2, 0) @PIN(terminal="nw", direction="right");
    %n2 = (0, -2) @PIN(terminal="n2", direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    @LINE {(2, 0) (1, 0)};
    @LINE(fill="linecolor", linestyle="none") {(0.6, 0) (1.1657, 0.2828) (1.1657, -0.2828) (0.6, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(2, 0.35);
    ? @TEXT("${value}", key="value") => @PLACE(2, -1.2);
  };

  /* A photoresistor (light-dependent resistor). Terminals: p n. */
  $PHOTORESISTOR = @DEFINE-SYMBOL(box=[-1.8, -2, 1, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    @LINE {(-1.5, 0.9) (-1.1, 0.5)};
    @LINE(fill="linecolor", linestyle="none") {(-0.9, 0.3) (-1.02, 0.66) (-1.26, 0.42) (-0.9, 0.3)};
    @LINE {(-1.5, 0.3) (-1.1, -0.1)};
    @LINE(fill="linecolor", linestyle="none") {(-0.9, -0.3) (-1.02, 0.06) (-1.26, -0.18) (-0.9, -0.3)};
    ? @TEXT("${name}", key="name") => @PLACE(1, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1, -1.2);
  };

  /* A polarized (electrolytic) capacitor, its positive plate on p. Terminals: p n. */
  $POLARIZED_CAPACITOR = @DEFINE-SYMBOL(box=[-1.4, -2, 1.4, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @BEZIER(linewidth=0.24) {(-0.8051, -0.65) (-0.27, -0.2145) (0.27, -0.2145) (0.8051, -0.65)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    @LINE {(-1.1, 0.9) (-0.5, 0.9)};
    @LINE {(-0.8, 1.2) (-0.8, 0.6)};
    ? @TEXT("${name}", key="name") => @PLACE(1.4, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.4, -1.2);
  };

  /* A quartz crystal resonator. Terminals: n1 n2. */
  $CRYSTAL = @DEFINE-SYMBOL(box=[-1.2, -2, 1.2, 2]) {
    %n1 = (0, 2) @PIN(terminal="n1", direction="up");
    %n2 = (0, -2) @PIN(terminal="n2", direction="down");
    @LINE {(0, 2) (0, 0.7)};
    @LINE(linewidth=0.24) {(-0.8, 0.7) (0.8, 0.7)};
    @LINE(linewidth=0.24) {(-0.5, 0.4) (0.5, 0.4) (0.5, -0.4) (-0.5, -0.4) (-0.5, 0.4)};
    @LINE(linewidth=0.24) {(-0.8, -0.7) (0.8, -0.7)};
    @LINE {(0, -0.7) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.2, 0.25);
  };

  /* A loudspeaker. Terminals: p n. */
  $SPEAKER = @DEFINE-SYMBOL(box=[-0.8, -2, 1.6, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(-0.3, 0.6) (0.3, 0.6) (0.3, -0.6) (-0.3, -0.6) (-0.3, 0.6)};
    @LINE {(0.3, 0.6) (1.1, 1.4) (1.1, -1.4) (0.3, -0.6)};
    @LINE {(0, 0.6) (0, 2)};
    @LINE {(0, -0.6) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -1.2);
  };

  /* ---------------------------------------------------------------- sources and RF port */

  /* An independent voltage source. Terminals: p n. */
  $VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2);
  };

  /* An independent current source, its arrow from p to n. Terminals: p n. */
  $CURRENT_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2);
  };

  /* A battery. Terminals: p n. */
  $BATTERY = @DEFINE-SYMBOL(box=[-2.4, -2, 2.4, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 0.3361)};
    @LINE {(0, -0.3361) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.5341, 0.496) (1.5367, 0.496) (1.5367, 0.1762) (-1.5341, 0.1762) (-1.5341, 0.496)};
    @LINE(fill="linecolor", linestyle="none") {(-0.7988, -0.1762) (0.8006, -0.1762) (0.8006, -0.496) (-0.7988, -0.496) (-0.7988, -0.1762)};
    @LINE {(0.7919, 1.3416) (1.5986, 1.3416)};
    @LINE {(1.1952, 1.745) (1.1952, 0.9385)};
    @LINE {(0.7919, -1.3472) (1.5986, -1.3472)};
    ? @TEXT("${name}", key="name") => @PLACE(2, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(2, -1.2);
  };

  /* A controlled voltage source drawn as a diamond with its output pins only. Terminals: p n. */
  $CONTROLLED_VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-2.4, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2);
  };

  /* A controlled current source drawn as a diamond with its output pins only. Terminals: p n. */
  $CONTROLLED_CURRENT_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2);
  };

  /* Shared four-terminal controlled-source body: diamond output at (0, +-2) and right-angled control leads at (-4, +-1). */
  %CONTROLLED_SOURCE_BODY = @DEFINE-SYMBOL {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    %cp = (-4, 1) @PIN(terminal="cp", direction="left");
    %cn = (-4, -1) @PIN(terminal="cn", direction="left");
    @LINE {(0, 2) (0, 1.25)};
    @LINE {(0, -1.25) (0, -2)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(-4, 1) (-0.75, 1) (-0.75, 0.5)};
    @LINE {(-4, -1) (-0.75, -1) (-0.75, -0.5)};
    @LINE {(-2.95, 0.5) (-2.25, 0.5)};
    @LINE {(-2.6, 0.15) (-2.6, 0.85)};
    @LINE {(-2.95, -0.5) (-2.25, -0.5)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -1.2);
  };

  /* A voltage-controlled voltage source (E) with its control pins on the left. Terminals: p n cp cn. */
  $VCVS_4TERM = @DEFINE-SYMBOL(box=[-4, -2, 1.65, 2]) {
    %CONTROLLED_SOURCE_BODY;
    @LINE {(-0.35, 0.55) (0.35, 0.55)};
    @LINE {(0, 0.2) (0, 0.9)};
    @LINE {(-0.35, -0.55) (0.35, -0.55)};
  };

  /* A voltage-controlled current source (G) with its control pins on the left. Terminals: p n cp cn. */
  $VCCS_4TERM = @DEFINE-SYMBOL(box=[-4, -2, 1.65, 2]) {
    %CONTROLLED_SOURCE_BODY;
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
  };

  /* A behavioral source (B): a circle marked B. Terminals: p n. */
  $BEHAVIORAL_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    @LINE {(0, 2) (0, 1.0756)};
    @LINE {(0, -1.0756) (0, -2)};
    (0, 0) @CIRCLE(radius=1.0756);
    (0, 0) @TEXT("B", halign="middle", valign="middle", size=1.1);
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2);
  };

  /* An RF port: a sine source in series with its internal resistance, for Spectre's port. Terminals: p n. */
  $RF_PORT = @DEFINE-SYMBOL(box=[-1.5, -3, 1.5, 5]) {
    %p = (0, 5) @PIN(terminal="p", direction="up");
    %n = (0, -3) @PIN(terminal="n", direction="down");
    @LINE {(0, 5) (0, 2.75) (0.43, 2.56) (-0.37, 2.38) (0.43, 2.14) (-0.4, 1.91) (0.43, 1.68) (-0.37, 1.45) (0, 1.35) (0, 1.0756)};
    @LINE {(0, -1.0756) (0, -3)};
    (0, 0) @CIRCLE(radius=1.0756);
    @ARC {(-0.6, 0) (-0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0.6, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2);
  };


  /* A sine-wave voltage source, + on p. Terminals: p n. */
  $SINE_VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @BEZIER {(-0.6, 0) (-0.4, 0.6) (-0.2, 0.6) (0, 0) (0.2, -0.6) (0.4, -0.6) (0.6, 0)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2);
  };

  /* A pulse voltage source, + on p. Terminals: p n. */
  $PULSE_VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(0.4, -0.7) (0.4, -0.4) (-0.4, -0.4) (-0.4, 0.4) (0.4, 0.4) (0.4, 0.7)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -1.2);
  };

  /* A microphone, + on p. Terminals: p n. */
  $MICROPHONE = @DEFINE-SYMBOL(box=[-2.4, -2, 2, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0.8, 0) @CIRCLE(radius=0.8);
    @LINE(linewidth=0.24) {(0, 1) (0, -1)};
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1) (0, 2)};
    @LINE {(0, -1) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(2, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(2, -1.2);
  };

  /* An ammeter, current measured from p to n. Terminals: p n. */
  $AMMETER = @DEFINE-SYMBOL(box=[-1.5, -2, 1.5, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-0.4, -0.525) (0, 0.525) (0.4, -0.525)};
    @LINE {(-0.2667, -0.175) (0.2667, -0.175)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
  };

  /* ---------------------------------------------------------------- switches and transmission lines */

  /* A switch drawn open, for a current-controlled switch (W) or Spectre's switch. Terminals: p n. */
  $SWITCH = @DEFINE-SYMBOL(box=[-2, -1.2, 2, 1.8]) {
    %p = (-2, 0) @PIN(terminal="p", direction="left");
    %n = (2, 0) @PIN(terminal="n", direction="right");
    @LINE {(-2, 0) (-1.2727, 0)};
    (-0.9524, 0.002) @CIRCLE(radius=0.3203);
    @LINE {(-0.6954, 0.2418) (0.6406, 1.2807)};
    (1.1201, 0.002) @CIRCLE(radius=0.3202);
    @LINE {(1.4403, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.65);
  };

  /* A switch drawn closed. Terminals: p n. */
  $CLOSED_SWITCH = @DEFINE-SYMBOL(box=[-2, -1.2, 2, 1.2]) {
    %p = (-2, 0) @PIN(terminal="p", direction="left");
    %n = (2, 0) @PIN(terminal="n", direction="right");
    @LINE {(-2, 0) (-1.3562, 0)};
    (-1.0363, 0) @CIRCLE(radius=0.3199);
    @LINE {(-0.7187, 0.1496) (1.3609, 0.4694)};
    (1.0363, 0) @CIRCLE(radius=0.3199);
    @LINE {(1.3562, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 0.8);
  };

  /* A switch with a single control pin at its side. Terminals: p n cp. */
  $EXTERNALLY_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-2, -2, 2.4, 2]) {
    %p = (0, 2) @PIN(terminal="p", direction="up");
    %n = (0, -2) @PIN(terminal="n", direction="down");
    %cp = (-2, 0) @PIN(terminal="cp", direction="left");
    @LINE {(0, 2) (0, 1.2414)};
    (0, 0.9215) @CIRCLE(radius=0.3199);
    @LINE {(-0.2636, 0.6896) (-1.3529, -0.6998)};
    @LINE {(-2, 0) (-0.7428, 0)};
    (0, -1.1511) @CIRCLE(radius=0.3199);
    @LINE {(0, -1.471) (0, -2)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.85, 2.35);
  };

  /* A voltage-controlled switch (S), its differential control pins below it. Terminals: p n cp cn. */
  $VOLTAGE_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-2, -3.8, 2, 1.7]) {
    %p = (-2, 0) @PIN(terminal="p", direction="left");
    %n = (2, 0) @PIN(terminal="n", direction="right");
    %cp = (-2, -3) @PIN(terminal="cp", direction="left");
    %cn = (2, -3) @PIN(terminal="cn", direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (-1, 0) @CIRCLE(radius=0.3);
    @LINE {(-0.7, 0.24) (0.64, 1.28)};
    (1.1, 0) @CIRCLE(radius=0.3);
    @LINE {(1.4, 0) (2, 0)};
    @LINE {(-2, -3) (-1, -3)};
    @LINE {(1, -3) (2, -3)};
    @LINE {(-1, -2.4) (1, -2.4) (1, -3.6) (-1, -3.6) (-1, -2.4)};
    @LINE {(-0.8, -3) (-0.2, -3)};
    @LINE {(-0.5, -2.7) (-0.5, -3.3)};
    @LINE {(0.2, -3) (0.8, -3)};
    @LINE {(0, -2.4) (0, -2)};
    @LINE {(0, -1.6) (0, -1.2)};
    @LINE {(0, -0.8) (0, -0.6)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.65);
  };

  /* The symbol of $SPDT_SWITCH: a single-pole double-throw switch whose pins com a b bind nothing and are wired by name (9.2.4). */
  $SPDT_SWITCH_SYMBOL = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %com = (-2, 0) @PIN(direction="left");
    %a = (2, 1) @PIN(direction="right");
    %b = (2, -1) @PIN(direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (-1, 0) @CIRCLE(radius=0.3);
    @LINE {(-0.732, 0.134) (0.732, 0.866)};
    (1, 1) @CIRCLE(radius=0.3);
    @LINE {(1.3, 1) (2, 1)};
    (1, -1) @CIRCLE(radius=0.3);
    @LINE {(1.3, -1) (2, -1)};
  };

  /* A transmission line (T or O), port 1 on the left and port 2 on the right. Terminals: p1 n1 p2 n2. */
  $TRANSMISSION_LINE = @DEFINE-SYMBOL(box=[-4, -2, 4, 1.2]) {
    %p1 = (-4, 0) @PIN(terminal="p1", direction="left");
    %n1 = (-2, -2) @PIN(terminal="n1", direction="down");
    %p2 = (4, 0) @PIN(terminal="p2", direction="right");
    %n2 = (2, -2) @PIN(terminal="n2", direction="down");
    @LINE {(-4, 0) (-2.3, 0)};
    @LINE {(2.3, 0) (4, 0)};
    @LINE {(-2, -2) (-2, -0.8)};
    @LINE {(2, -2) (2, -0.8)};
    (-2, 0) @ELLIPSE(width=0.6, height=1.6);
    @LINE {(-2, 0.8) (2, 0.8)};
    @LINE {(-2, -0.8) (2, -0.8)};
    @ARC {(2, 0.8) (2.3, 0) (2, -0.8)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.15);
  };

  /* A uniform distributed RC line (U). Terminals: a b ref. */
  $RC_LINE = @DEFINE-SYMBOL(box=[-4, -2, 4, 0.8]) {
    %a = (-4, 0) @PIN(terminal="a", direction="left");
    %b = (4, 0) @PIN(terminal="b", direction="right");
    %ref = (0, -2) @PIN(terminal="ref", direction="down");
    @LINE {(-4, 0) (-2, 0) (-1.667, 0.4) (-1, -0.4) (-0.333, 0.4) (0.333, -0.4) (1, 0.4) (1.667, -0.4) (2, 0) (4, 0)};
    @LINE(linewidth=0.24) {(-2, -0.9) (2, -0.9)};
    @LINE {(0, -0.9) (0, -2)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 0.75);
  };

  /* ---------------------------------------------------------------- virtual-part and mark symbols */

  /* The symbol of $GROUND: a three-bar ground, its pin at the top. For grounds on nets other than 0 in $GROUND_NET_SET, rnl-std-fill switches to $NAMED_GROUND_SYMBOL. */
  $GROUND_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, -2.7, 1.2, 0]) {
    %pin = (0, 0) @PIN(terminal="p", direction="up");
    @LINE {(0, 0) (0, -1)};
    @LINE(linewidth=0.2907) {(-0.6395, -1) (0.6395, -1)};
    @LINE(linewidth=0.2907) {(-0.407, -1.5814) (0.407, -1.5814)};
    @LINE(linewidth=0.2907) {(-0.2326, -2.1047) (0.2326, -2.1047)};
  };

  /* A ground symbol with the name of its net under it, used by rnl-std-fill for ground nets other than 0 in $GROUND_NET_SET. */
  $NAMED_GROUND_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, -2.7, 1.2, 0]) {
    $GROUND_SYMBOL;
    ? @TEXT("${p}", key="netname", halign="middle", valign="top", fix_rotate=true) => @PLACE(0, -2.5);
  };

  /* The symbol of $SUPPLY: a horizontal bar with the name of its net, its pin at the bottom. */
  $SUPPLY_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, 0, 1.2, 2.2]) {
    %pin = (0, 0) @PIN(terminal="p", direction="down");
    @LINE {(0, 0) (0, 1.85)};
    @LINE(fill="linecolor", linestyle="none") {(-1, 2.088) (1, 2.088) (1, 1.764) (-1, 1.764) (-1, 2.088)};
    ? @TEXT("${p}", key="netname", halign="middle", valign="bottom", fix_rotate=true) => @PLACE(0, 2.4);
  };

  /* The symbol of $BIAS: a slanted bar with the name of its net, its pin at the bottom. */
  $BIAS_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, 0, 1.2, 2.4]) {
    %pin = (0, 0) @PIN(terminal="p", direction="down");
    @LINE {(0, 0) (0, 1.85)};
    @LINE(fill="linecolor", linestyle="none") {(-1, 1.55) (1, 2.3) (1, 1.955) (-1, 1.205) (-1, 1.55)};
    ? @TEXT("${p}", key="netname", halign="middle", valign="bottom", fix_rotate=true) => @PLACE(0, 2.6);
  };

  /* The symbol of $IO_PORT: a small circle with the name of its net, its pin on the right. */
  $IO_PORT_SYMBOL = @DEFINE-SYMBOL(box=[-1.4, -0.7, 0, 0.7]) {
    %pin = (0, 0) @PIN(terminal="p", direction="right");
    (-0.7087, 0) @CIRCLE(radius=0.2479);
    @LINE {(0, 0) (-0.4608, 0)};
    ? @TEXT("${p}", key="netname", halign="end", valign="middle") => @PLACE(-1.25, 0);
  };

  /* The symbol of $NET_LABEL: a one-unit lead and the name of its net, its pin facing left. */
  $NET_LABEL_SYMBOL = @DEFINE-SYMBOL {
    %pin = (0, 0) @PIN(terminal="p", direction="left");
    @LINE {(0, 0) (1, 0)};
    ? @TEXT("${p}", key="netname", halign="start", valign="middle") => @PLACE(1.3, 0);
  };

  /* A filled arrow head pointing right, shared by $ARROW and $CURRENT_ARROW. */
  $ARROW_SYMBOL = @DEFINE-SYMBOL(box=[-0.85, -0.4, 0.85, 0.4]) {
    @LINE(fill="linecolor", linestyle="none") {(0.8285, 0) (-0.8285, 0.3953) (-0.8285, -0.3953) (0.8285, 0)};
  };

  /* The symbol of $NO_CONNECT: a cross. */
  $NO_CONNECT_SYMBOL = @DEFINE-SYMBOL(box=[-0.5, -0.5, 0.5, 0.5]) {
    @LINE {(-0.5, -0.5) (0.5, 0.5)};
    @LINE {(-0.5, 0.5) (0.5, -0.5)};
  };

  /* The symbol of $JUNCTION: a filled dot. */
  $JUNCTION_SYMBOL = @DEFINE-SYMBOL(box=[-0.4, -0.4, 0.4, 0.4]) {
    (0, 0) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none");
  };

  /* ---------------------------------------------------------------- net sets (10.5) */

  /* The ground nets, 0 by default, which a file edits with ADD-TO and REMOVE-FROM. */
  $GROUND_NET_SET = # @SELECT-NET(name="0", recursive=true);

  /* The supply nets, none by default, which a file edits with ADD-TO and REMOVE-FROM. */
  $SUPPLY_NET_SET = {};

  /* The bias nets, none by default, which a file edits with ADD-TO and REMOVE-FROM. */
  $BIAS_NET_SET = {};

  /* ---------------------------------------------------------------- virtual parts, marks and figures (9.4, 12) */

  /* A ground on a net, drawn at a point of its own; add a non-0 net to $GROUND_NET_SET (or $NAMED_GROUND_NET_SET) to show its net name. */
  $GROUND = @DEFINE(roles=[["p", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $GROUND => @SET-SYMBOL $GROUND_SYMBOL;

  /* A supply on a net, drawn at a point of its own. */
  $SUPPLY = @DEFINE(roles=[["p", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $SUPPLY => @SET-SYMBOL $SUPPLY_SYMBOL;

  /* A bias voltage mark on a net, drawn at a point of its own. */
  $BIAS = @DEFINE(roles=[["p", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $BIAS => @SET-SYMBOL $BIAS_SYMBOL;

  /* A port tag on a net, drawn at a point of its own; its net must be a port of its level. */
  $IO_PORT = @DEFINE(roles=[["p", "net"]]) {
    ?p @ASSERT-NET(port=true, message="the net of an $IO_PORT is a port of its level");
  };
  # @SELECT-USAGE(recursive=true) $IO_PORT => @SET-SYMBOL $IO_PORT_SYMBOL;

  /* A net label: the name of a net on a short lead, drawn at a point of its own. */
  $NET_LABEL = @DEFINE(roles=[["p", "net"]]) {};
  # @SELECT-USAGE(recursive=true) $NET_LABEL => @SET-SYMBOL $NET_LABEL_SYMBOL;

  /* A no-connect mark on a terminal or pin left unconnected on purpose; a terminal is kept as itself so a mark on a bus bit records which bit is open (12.6). */
  $NO_CONNECT = @DEFINE(roles=[["t", ["terminal", "pin"]]]) {
    {? ?t} @ALIGN("x");
    {? ?t} @ALIGN("y");
  };
  # @SELECT-USAGE(recursive=true) $NO_CONNECT => @SET-SYMBOL $NO_CONNECT_SYMBOL;

  /* A junction dot on a point or a terminal. */
  $JUNCTION = @DEFINE(roles=[["p", ["point", "terminal"]]]) {
    {? ?p} @ALIGN("x");
    {? ?p} @ALIGN("y");
  };
  # @SELECT-USAGE(recursive=true) $JUNCTION => @SET-SYMBOL $JUNCTION_SYMBOL;

  /* A current arrow on a terminal or a point. */
  $CURRENT_ARROW = @DEFINE(roles=[["p", ["terminal", "point"]]]) {
    {? ?p} @ALIGN("x");
    {? ?p} @ALIGN("y");
  };
  # @SELECT-USAGE(recursive=true) $CURRENT_ARROW => @SET-SYMBOL $ARROW_SYMBOL;

  /* An arrow head drawn on a point in a symbol or in the scene (9.2.7). */
  $ARROW = @DEFINE(roles=[["at", "point"]]) {
    {? ?at} @ALIGN("x");
    {? ?at} @ALIGN("y");
  };
  # @SELECT-USAGE(recursive=true) $ARROW => @SET-SYMBOL $ARROW_SYMBOL;

  /* A single-pole double-throw switch drawn as a figure on a point, with no netlist line. */
  $SPDT_SWITCH = @DEFINE(roles=[["at", "point"]]) {
    {? ?at} @ALIGN("x");
    {? ?at} @ALIGN("y");
  };
  # @SELECT-USAGE(recursive=true) $SPDT_SWITCH => @SET-SYMBOL $SPDT_SWITCH_SYMBOL;

  /* A figure drawn at a point with no netlist line, given a symbol of its own with SET-SYMBOL. */
  $FIGURE = @DEFINE(roles=[["at", "point"]]) {
    {? ?at} @ALIGN("x");
    {? ?at} @ALIGN("y");
  };

  /* A port tag on every port net of a level that does not already have an $IO_PORT, arranged in one column. */
  $PORT_LIST = @DEFINE(roles=[]) {
    %port_net_set = # @SELECT-NET(port=true);
    # @SELECT-USAGE $IO_PORT => @SELECT-NET => @REMOVE-FROM %port_net_set;
    $IO_PORT @ATTACH %port_net_set => %tag_set;
    %tag_set @ORDER("top-to-bottom");
    %tag_set @ALIGN("x");
    %tag_set @GROUP;
  };

  /* A non-drawn comment attached to any objects, or to the level itself when target is omitted. */
  $COMMENT = @DEFINE(roles=["{target}"], parameters=[["text", ""]]) {};

  /* ---------------------------------------------------------------- stubs (10.5) */

  /* A ground below a pin, with its own wire of at least gap units. */
  $GROUND_STUB = @DEFINE(roles=[["t", "pin"]], parameters=[["gap", 1]]) {
    %g = $GROUND @ATTACH ?t::net;
    ?t::net @WIRE {?t %g::pin};
    {?t %g::pin} @ALIGN("x", priority="low");
    %g::pin ?t @DISTANCE("bottom-to-top", min=?gap, priority="low");
    %g @ORIENT("R0", priority="low");
  };

  /* A supply above a pin, with its own wire of at least gap units. */
  $SUPPLY_STUB = @DEFINE(roles=[["t", "pin"]], parameters=[["gap", 1]]) {
    %s = $SUPPLY @ATTACH ?t::net;
    ?t::net @WIRE {?t %s::pin};
    {?t %s::pin} @ALIGN("x", priority="low");
    ?t %s::pin @DISTANCE("bottom-to-top", min=?gap, priority="low");
    %s @ORIENT("R0", priority="low");
  };

  /* A bias voltage mark directly on a pin, facing away from the pin like a port stub. */
  $BIAS_STUB = @DEFINE(roles=[["t", "pin"]]) {
    %b = $BIAS @ATTACH ?t::net;
    ?t %b::pin @ORIENT-RELATION("R180");
    {?t %b::pin} @ALIGN("x");
    {?t %b::pin} @ALIGN("y");
  };

  /* A port tag directly on a pin, its lead serving as the stub's short wire. */
  $IO_PORT_STUB = @DEFINE(roles=[["t", "pin"]]) {
    %p = $IO_PORT @ATTACH ?t::net;
    ?t %p::pin @ORIENT-RELATION("R180");
    {?t %p::pin} @ALIGN("x");
    {?t %p::pin} @ALIGN("y");
  };

  /* A net label directly on a pin, its one-unit lead serving as the stub's short wire. */
  $NET_LABEL_STUB = @DEFINE(roles=[["t", "pin"]]) {
    %l = $NET_LABEL @ATTACH ?t::net;
    ?t %l::pin @ORIENT-RELATION("R180");
    {?t %l::pin} @ALIGN("x");
    {?t %l::pin} @ALIGN("y");
    ?t @UNROUTE-OBJECT;
    %l @UNROUTE-OBJECT(priority="high");
  };
}

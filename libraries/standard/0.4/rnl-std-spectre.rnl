/* rnl-std-spectre 0.4, a package of the standard series 0.4 (16.3).
   Made from the files of the series 0.3 (libraries/standard/0.3), which say what they were
   generated from, and edited in rnl, whose files are the source.
   The rule package of Spectre: the symbols of instances by master, then by model type (16.3). */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-spectre", version="0.4");
  @USE-PACKAGE(name="rnl-std-basic", version="0.4");
  @USE-PACKAGE(name="rnl-std-semiconductors", version="0.4")
}

/* ---------------------------------------------------------------- rnl-std-spectre: symbols for Spectre netlists
   Every element the Spectre adapter reads natively, all but subcircuit calls (16.3). Spectre names
   carry no element letter, so nothing goes by name: a primitive by its master, an instance of a model
   card by the card's model type (6.12, 10.1). As a package it references rnl-std-basic and
   rnl-std-semiconductors, whose symbols it names. */
@RNL {
  # @SELECT-INSTANCE(model="resistor", recursive=true) => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(model="capacitor", recursive=true) => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(model="inductor", recursive=true) => @SET-SYMBOL $INDUCTOR;
  # @SELECT-INSTANCE(model="vsource", recursive=true) => @SET-SYMBOL $VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(model="isource", recursive=true) => @SET-SYMBOL $CURRENT_SOURCE;
  # @SELECT-INSTANCE(model="diode", recursive=true) => @SET-SYMBOL $DIODE;
  # @SELECT-INSTANCE(model="vcvs", recursive=true) => @SET-SYMBOL $VCVS_4TERM;
  # @SELECT-INSTANCE(model="vccs", recursive=true) => @SET-SYMBOL $VCCS_4TERM;
  # @SELECT-INSTANCE(model="cccs", recursive=true) => @SET-SYMBOL $CCCS;
  # @SELECT-INSTANCE(model="ccvs", recursive=true) => @SET-SYMBOL $CCVS;
  # @SELECT-INSTANCE(model="bsource", recursive=true) => @SET-SYMBOL $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(model="relay", recursive=true) => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH;
  # @SELECT-INSTANCE(model="switch", recursive=true) => @SET-SYMBOL $SWITCH;
  # @SELECT-INSTANCE(model="port", recursive=true) => @SET-SYMBOL $RF_PORT;
  # @SELECT-INSTANCE(model="transformer", recursive=true) => @SET-SYMBOL $TRANSFORMER;
  # @SELECT-INSTANCE(model="tline", recursive=true) => @SET-SYMBOL $TRANSMISSION_LINE;

  /* the model type of the model card an instance names, in SPICE's words (the adapter's family()) */
  # @SELECT-INSTANCE(type="d", recursive=true) => @SET-SYMBOL $DIODE;
  # @SELECT-INSTANCE(type="r", recursive=true) => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(type="c", recursive=true) => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(type="l", recursive=true) => @SET-SYMBOL $INDUCTOR;
  # @SELECT-INSTANCE(type="sw", recursive=true) => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH;
  # @SELECT-INSTANCE(type="nmos", recursive=true) => @SET-SYMBOL $NMOS_4TERM;
  # @SELECT-INSTANCE(type="npn", recursive=true) => @SET-SYMBOL $NPN;
  # @SELECT-INSTANCE(type="njf", recursive=true) => @SET-SYMBOL $NJFET;
  # @SELECT-INSTANCE(type="nmf", recursive=true) => @SET-SYMBOL $NJFET;
  /* narrow: the model type picks the P variants */
  # @SELECT-INSTANCE(type="pmos", recursive=true) => @SET-SYMBOL $PMOS_4TERM;
  # @SELECT-INSTANCE(type="pnp", recursive=true) => @SET-SYMBOL $PNP;
  # @SELECT-INSTANCE(type="pjf", recursive=true) => @SET-SYMBOL $PJFET;
  # @SELECT-INSTANCE(type="pmf", recursive=true) => @SET-SYMBOL $PJFET
}

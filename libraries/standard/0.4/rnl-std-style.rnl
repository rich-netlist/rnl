/* rnl-std-style 0.4, a package of the standard series 0.4 (16.3).
   The styles (9.3) and the default style rules. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-style", version="0.4");
}

/* ---------------------------------------------------------------- styles (9.3) and default style rules */
@RNL {
  /* Lines as Analog Canvas draws them (razavi-textbook-v1): wires and normal strokes 0.16 wide, with
     butt caps and miter joins. A symbol writes the width of its emphasis (0.24) and ground (0.2907)
     strokes, and a round cap or join, itself; a bus is "bold", twice as wide (9.3). */

  /* The base style of every object: lines, texts and fills as Analog Canvas draws them. */
  $base = @DEFINE-STYLE(linecolor="#1d1d1f", textcolor="#1d1d1f", fillcolor="#ffffff", linewidth=0.16, cap="butt", join="miter", size=1) {};

  /* A dark grey style for virtual parts and other drawn usages. */
  $virtual = @DEFINE-STYLE(linecolor="#555555", textcolor="#555555") {};

  /* The style of a bus: its lines bold. */
  $bus = @DEFINE-STYLE(linestyle="bold") {};

  /* A style for signal wires: blue and bold. */
  $signal = @DEFINE-STYLE(linecolor="#1f4fd8", linestyle="bold") {$base};

  /* A style for notes: grey, smaller text. */
  $note = @DEFINE-STYLE(textcolor="#555555", size=0.9) {};

  /* A grey style for lines and texts. */
  $grey = @DEFINE-STYLE(linecolor="#9a9a9a", textcolor="#9a9a9a") {};

  /* Style first, so every later rule and user statement overrides it. */
  # @SELECT-INSTANCE(recursive=true) => @SET-STYLE $base;
  # @SELECT-USAGE(recursive=true) => @SET-STYLE $base;
  # @SELECT-USAGE(drawn=true, recursive=true) => @SET-STYLE $virtual;
  # @SELECT-WIRE(recursive=true) => @SET-STYLE $base;
  # @SELECT-LABEL(recursive=true) => @SET-STYLE $base;
  # @SELECT-ANNOTATION(recursive=true) => @SET-STYLE $base;
  # @SELECT-WIRE(bus=true, recursive=true) => @SET-STYLE $bus;
}

/* rnl-std-no-instance-labels 0.4, a package of the standard series 0.4 (16.3).
   Hides the default labels of the instances, for a file that writes its own device labels but keeps
   the net names that grounds, supplies, port tags and net labels draw (16.3).
   Optional, not in rnl-std-all: a file names it with USE-PACKAGE. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-no-instance-labels", version="0.4");
}

/* ---------------------------------------------------------------- rules hiding the labels of instances
   Every default label of a drawn instance, its name, value and model and a net name its symbol may
   draw (netname), gets the style textvisible=false (9.3): it is not drawn and takes no room, but its
   content stays. Usages are left alone: the net names that a ground, supply, bias, port tag or net
   label draws stay visible, as do the labels of drawn structures. A label is the same text whoever
   writes it, and a later TEXT with the same key overrides it parameter by parameter (13.3), so the
   style stays: to show a label again, write textvisible=true on it, such as
   #M1 @TEXT("M1", key="name", textvisible=true). Block formulas (key="formula") and amplifier labels
   (key="label") stay visible: they are part of the drawing. Only drawn instances are selected
   (drawn=true, 10.1, 16.3). rnl-std-no-labels hides all of these and the labels of usages as well. */
@RNL {
  %hidden = @DEFINE-STYLE(textvisible=false) {};
  # @SELECT-INSTANCE(drawn=true, recursive=true) => @SELECT-LABEL(key="name") => @SET-STYLE %hidden;
  # @SELECT-INSTANCE(drawn=true, recursive=true) => @SELECT-LABEL(key="value") => @SET-STYLE %hidden;
  # @SELECT-INSTANCE(drawn=true, recursive=true) => @SELECT-LABEL(key="model") => @SET-STYLE %hidden;
  # @SELECT-INSTANCE(drawn=true, recursive=true) => @SELECT-LABEL(key="netname") => @SET-STYLE %hidden;
}

/* rnl-std-structures 0.4, a package of the standard series 0.4.
   The definitions of circuit structures and of their default drawings. A default drawing is the
   constraints of a body, all of priority low: the author's own facts come before them, PRIORITY("disabled")
   on a usage turns them off for that usage, and a rule such as
   # @SELECT-USAGE $DIFFERENTIAL_PAIR_N => @PRIORITY("disabled") does so for every usage of a definition.
   Every position fact here gives its direction; for a drawing the other way round, use the variant or write
   the roles the other way round. An orientation may allow several (an ORIENT-RELATION with a list).
   Each definition's comment begins with one sentence that says what it is, the line a listing of the
   package shows; then what it draws: "Places" when it has position facts (ALIGN,
   ORDER, DISTRIBUTE, DISTANCE, ORIENT-RELATION), "routes" when it joins its members' shared nets with
   wires (ROUTE-OBJECT), "a group" when it makes one, and "Meaning only" when it draws nothing. A
   structure routes no ground or supply net: rnl-std-fill draws those with symbols, by an UNROUTE of
   priority high, unless a file writes a ROUTE of priority high or a WIRE.
   Some definitions assert what their circuit must be (15.3), as violations that change nothing drawn:
   the differential pairs that their sources (emitters) share a net, the current mirrors that their
   gates (bases) do, $DIODE_CONNECTED its gate on its drain (base on collector), $CROSS_COUPLED_PAIR its
   crossed gates and drains, and the roles of a fixed polarity that no member has the other type; the
   six pairs that their sides have the same model, w, l, nf, m and area, and the current mirrors the same
   model and l, a parameter that no member writes counting as one value (15.3); and $SERIES, $PARALLEL,
   $T_NETWORK and $PI_NETWORK their topology (15.4), the gates and bulks of MOS and JFETs and the bases
   and substrates of bipolar transistors left out by type. They
   select terminals by name and instances by type first, so that a member whose names or type are not
   known is not checked: when information is missing, nothing is checked and nothing false is said. */
@RNL(type="header") { @VERSION("0.4"); @PACKAGE(name="rnl-std-structures", version="0.4")}

/* ---------------------------------------------------------------- matching, symmetry, pairs and branches */
@RNL {
  /* Devices or sub-structures matched in their parameters and their layout. Meaning only: places and routes nothing. Devices or sub-structures matched in electrical parameters and layout. */
  $MATCHED = @DEFINE(roles=[["{members}", ["instance", "usage"]]]) {};

  /* Two symmetric objects at one height, mirror images of each other. Places; routes nothing. Two symmetric objects at one height, mirror images about an optional axis: left on the left of the axis, right on the right; with no axis, left is on the left of right. Write the roles the other way round to swap the sides. */
  $MIRRORED = @DEFINE(roles=[["left", ["instance", "usage"]], ["right", ["instance", "usage"]], ["{axis}", ["point", "instance", "usage", "net"]]]) { {?left ?right} @ALIGN("y", priority="low"); {?left {?axis} ?right} @DISTRIBUTE("left-to-right", priority="low"); ?left ?right @ORIENT-RELATION("MY", priority="low") };

  /* A differential pair with its tail below it, as an NMOS pair is drawn. Places and routes; a group. A matched pair driven differentially, mirrored about its tail, with the tail below the pair as an NMOS pair is drawn. left and right are the sides of the drawing, not the polarity of the inputs. The sources of the pair and of the tail point down, the emitters of bipolar transistors: an ORIENT of their pins, selected by type, so that the pair does not lie on its side; an instance without a type is left free. */
  $DIFFERENTIAL_PAIR_N = @DEFINE(roles=[["left", "instance"], ["right", "instance"], ["{tail}", ["instance", "usage"]]]) { {?left ?right} @AS $MATCHED; ?left(left) ?right(right) {?tail}(axis) @AS $MIRRORED; {{?left ?right} ?tail} @ORDER("top-to-bottom", priority="low"); {?left ?right ?tail} @ROUTE-OBJECT(priority="low"); {?left ?right ?tail} @GROUP; {?left ?right} @SELECT-TERMINAL(terminal="g") => @SELECT-INSTANCE => @SELECT-TERMINAL(terminal="s") => @ASSERT-TERMINAL(same=["net"], message="the sources of a differential pair share a net"); {?left ?right} @SELECT-TERMINAL(terminal="e") => @ASSERT-TERMINAL(same=["net"], message="the emitters of a differential pair share a net"); {?left ?right} @ASSERT-INSTANCE(same=["model", "w", "l", "nf", "m", "area"], message="the two sides of a pair are matched"); {?left ?right ?tail} @SELECT-INSTANCE(type="nmos") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pmos") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="njf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pjf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="e") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="e") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="e") => @ORIENT("down", priority="low") };

  /* A differential pair with its tail above it, as a PMOS pair is drawn. Places and routes; a group. The differential pair with the tail above the pair, as a PMOS pair is drawn. The sources of the pair and of the tail point up, the emitters of bipolar transistors: an ORIENT of their pins, selected by type, so that the pair does not lie on its side; an instance without a type is left free. */
  $DIFFERENTIAL_PAIR_P = @DEFINE(roles=[["left", "instance"], ["right", "instance"], ["{tail}", ["instance", "usage"]]]) { {?left ?right} @AS $MATCHED; ?left(left) ?right(right) {?tail}(axis) @AS $MIRRORED; {{?left ?right} ?tail} @ORDER("bottom-to-top", priority="low"); {?left ?right ?tail} @ROUTE-OBJECT(priority="low"); {?left ?right ?tail} @GROUP; {?left ?right} @SELECT-TERMINAL(terminal="g") => @SELECT-INSTANCE => @SELECT-TERMINAL(terminal="s") => @ASSERT-TERMINAL(same=["net"], message="the sources of a differential pair share a net"); {?left ?right} @SELECT-TERMINAL(terminal="e") => @ASSERT-TERMINAL(same=["net"], message="the emitters of a differential pair share a net"); {?left ?right} @ASSERT-INSTANCE(same=["model", "w", "l", "nf", "m", "area"], message="the two sides of a pair are matched"); {?left ?right ?tail} @SELECT-INSTANCE(type="nmos") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pmos") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="njf") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pjf") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low") };

  /* A current mirror: reference and output transistors that share a gate or base node. Places and routes. Copies or scales current from reference transistors to outputs sharing a gate or base node. */
  $CURRENT_MIRROR = @DEFINE(roles=[["{ref}", "instance"], ["{out}", "instance"]]) { {?ref ?out} @ALIGN("y", priority="low"); ?ref{1} {?out} @ORIENT-RELATION(["R0", "MY"], priority="low"); ?ref{1} ?ref{2:end} @ORIENT-RELATION("R0", priority="low"); {?ref ?out} @ROUTE-OBJECT(priority="low"); {?ref ?out} @SELECT-TERMINAL(terminal="g") => @ASSERT-TERMINAL(same=["net"], message="the gates of a current mirror share a net"); {?ref ?out} @SELECT-TERMINAL(terminal="c") => @SELECT-INSTANCE => @SELECT-TERMINAL(terminal="b") => @ASSERT-TERMINAL(same=["net"], message="the bases of a current mirror share a net"); {?ref ?out} @ASSERT-INSTANCE(same=["model", "l"], message="the transistors of a current mirror have one model and one length") };

  /* A DC branch: members in series in one column, from the top down. Places and routes. A DC branch: members in series, in one column, from the top down in the order written; write them the other way round to draw the branch the other way up. */
  $BRANCH = @DEFINE(roles=[["{members}", ["instance", "usage"]]]) { ?members @AS $SERIES; ?members @ALIGN("x", priority="low"); ?members @ORDER("top-to-bottom", priority="low") };

  /* A DC branch drawn as a row: members in series at one height, from left to right. Places and routes. The branch drawn as a row: members in series at one height, from left to right in the order written. */
  $BRANCH_HORIZONTAL = @DEFINE(roles=[["{members}", ["instance", "usage"]]]) { ?members @AS $SERIES; ?members @ALIGN("y", priority="low"); ?members @ORDER("left-to-right", priority="low") };

  /* A cascade of stages along a signal path. Meaning only: places and routes nothing. A cascade of macro stages along a multi-stage signal path. It states no order. */
  $CASCADE = @DEFINE(roles=[["{stages}", ["instance", "usage"]]]) {}
}

@RNL {
  /* Members connected end to end in series along one current path. Routes; places nothing. Two-terminal elements or sub-usages connected end-to-end in series along one current path, without geometric placement constraints. */
  $SERIES = @DEFINE(roles=[["{members}", ["instance", "usage"]]]) { {?members} @ROUTE-OBJECT(priority="low"); ?members @ASSERT-TOPOLOGY("series", exclude=[["nmos", "g"], ["nmos", "b"], ["pmos", "g"], ["pmos", "b"], ["npn", "b"], ["npn", "s"], ["pnp", "b"], ["pnp", "s"], ["lpnp", "b"], ["lpnp", "s"], ["njf", "g"], ["pjf", "g"], ["nmf", "g"], ["pmf", "g"]], message="the members of a series are in series") };

  /* A transistor with its gate on its drain, or its base on its collector. Routes; places nothing. Single transistor with its gate/base tied to its drain/collector; the local gate-to-drain (or base-to-collector) net on ?device is drawn as an explicit internal wire. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $DIODE_CONNECTED = @DEFINE(roles=[["device", "instance"]]) { {?device} @ROUTE-OBJECT(priority="low"); ?device @SELECT-TERMINAL(terminal="g") => %gate_set; ?device @SELECT-TERMINAL(terminal="d") => %drain_set; {%gate_set %drain_set} @ASSERT-TERMINAL(same=["net"], message="a diode-connected transistor has its gate on its drain"); ?device @SELECT-TERMINAL(terminal="b") => %base_set; ?device @SELECT-TERMINAL(terminal="c") => %collector_set; {%base_set %collector_set} @ASSERT-TERMINAL(same=["net"], message="a diode-connected transistor has its base on its collector") };

  /* A CMOS inverter, the PMOS above the NMOS. Places and routes. Complementary MOS inverter formed by a pull-up PMOS and a pull-down NMOS; the shared input gate net and shared output drain net between ?pmos and ?nmos are drawn as explicit wires; drawn in one column, the PMOS above the NMOS (side by side: $CMOS_INVERTER_HORIZONTAL). A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $CMOS_INVERTER = @DEFINE(roles=[["pmos", "instance"], ["nmos", "instance"]]) { {?pmos ?nmos} @ROUTE-OBJECT(priority="low"); {?pmos ?nmos} @ALIGN("x", priority="low"); {?pmos ?nmos} @ORDER("top-to-bottom", priority="low"); ?pmos @SELECT-INSTANCE(type="nmos") => @ASSERT-INSTANCE(type="pmos", message="the pmos of a CMOS inverter is a PMOS"); ?nmos @SELECT-INSTANCE(type="pmos") => @ASSERT-INSTANCE(type="nmos", message="the nmos of a CMOS inverter is an NMOS") };

  /* A CMOS inverter drawn side by side, the PMOS on the left. Places and routes. The CMOS inverter drawn side by side at one height, the PMOS on the left. */
  $CMOS_INVERTER_HORIZONTAL = @DEFINE(roles=[["pmos", "instance"], ["nmos", "instance"]]) { {?pmos ?nmos} @ROUTE-OBJECT(priority="low"); {?pmos ?nmos} @ALIGN("y", priority="low"); {?pmos ?nmos} @ORDER("left-to-right", priority="low"); ?pmos @SELECT-INSTANCE(type="nmos") => @ASSERT-INSTANCE(type="pmos", message="the pmos of a CMOS inverter is a PMOS"); ?nmos @SELECT-INSTANCE(type="pmos") => @ASSERT-INSTANCE(type="nmos", message="the nmos of a CMOS inverter is an NMOS") };

  /* Members connected in parallel across the same two nets. Routes; places nothing. Elements or sub-usages connected in parallel across shared terminals (no alignment or orientation constraint); the two shared terminal nets connecting ?members are drawn as explicit wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $PARALLEL = @DEFINE(roles=[["{members}", ["instance", "usage"]]]) { {?members} @ROUTE-OBJECT(priority="low"); ?members @ASSERT-TOPOLOGY("parallel", exclude=[["nmos", "g"], ["nmos", "b"], ["pmos", "g"], ["pmos", "b"], ["npn", "b"], ["npn", "s"], ["pnp", "b"], ["pnp", "s"], ["lpnp", "b"], ["lpnp", "s"], ["njf", "g"], ["pjf", "g"], ["nmf", "g"], ["pmf", "g"]], message="the members of a parallel are in parallel") };
  /* Members in parallel side by side at one height, standing as one place in a column. Places and routes. Members side by side at one height, the usage's own point at that height, so that the usage stands for them as one place in a column such as a $BRANCH (a lone ? in a definition's body is the usage itself). It binds y alone: the point's x is free, so the column may stand apart from the members. */
  $PARALLEL_HORIZONTAL = @DEFINE(roles=[["{members}", "instance"]]) { {?members} @AS $PARALLEL; {?members ?} @ALIGN("y", priority="low") };
  /* Members in parallel one above another at one x, standing as one place in a row. Places and routes. Members one above another in one column, the usage's own point at that x, so that the usage stands for them as one place in a row such as a $BRANCH_HORIZONTAL (a lone ? in a definition's body is the usage itself). It binds x alone: the point's y is free, so the row may stand apart from the members. */
  $PARALLEL_VERTICAL = @DEFINE(roles=[["{members}", "instance"]]) { {?members} @AS $PARALLEL; {?members ?} @ALIGN("x", priority="low") };

  /* A cascode: a source device under a common-gate transistor in series. Routes; places nothing. Series stack of source device(s)/usage(s) and a cascode transistor with embedded $COMMON_GATE semantics; the internal drain-to-source net between ?source and ?cascode is drawn as an explicit wire. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $CASCODE = @DEFINE(roles=[["{source}", ["instance", "usage"]], ["cascode", "instance"]]) { ?cascode @AS $COMMON_GATE; {?source ?cascode} @AS $SERIES; {?source ?cascode} @ROUTE-OBJECT(priority="low") };

  /* A switch that passes or blocks a signal between its two sides. Meaning only: places and routes nothing. Switch (single FET or usage such as $TRANSMISSION_GATE) that passes or blocks a signal between its two sides; it says nothing else. */
  $PASS_SWITCH = @DEFINE(roles=[["device", ["instance", "usage"]]]) { /* pass or select switch; carries no other semantics */ };

  /* A common-source stage of one MOSFET. Meaning only: places and routes nothing. Single-MOSFET common-source transconductance/gain stage (input at gate, output at drain). */
  $COMMON_SOURCE = @DEFINE(roles=[["device", "instance"]]) { /* single-transistor common-source stage */ };

  /* The load of an amplifier stage or of a signal path. Meaning only: places and routes nothing. Active or passive load element or sub-structure driven by an amplifier stage or terminating a $FLOW path. */
  $LOAD = @DEFINE(roles=[["element", ["instance", "usage"]]]) { /* stage or path load */ };

  /* The signal or bias source at the start of a stage or of a signal path. Meaning only: places and routes nothing. Signal or bias source endpoint initiating a circuit stage or a $FLOW path. */
  $SOURCE = @DEFINE(roles=[["element", ["instance", "usage"]]]) { /* signal or bias source endpoint */ };

  /* A CMOS transmission gate, the PMOS above the NMOS. Places and routes. Bidirectional CMOS pass switch formed by complementary PMOS and NMOS transistors; the shared source-to-source and drain-to-drain nets joining ?pmos and ?nmos are drawn as explicit wires; drawn in one column, the PMOS above the NMOS (side by side: $TRANSMISSION_GATE_HORIZONTAL). A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $TRANSMISSION_GATE = @DEFINE(roles=[["pmos", ["instance", "usage"]], ["nmos", ["instance", "usage"]]]) { {?pmos ?nmos} @ROUTE-OBJECT(priority="low"); {?pmos ?nmos} @ALIGN("x", priority="low"); {?pmos ?nmos} @ORDER("top-to-bottom", priority="low"); ?pmos @SELECT-INSTANCE(type="nmos") => @ASSERT-INSTANCE(type="pmos", message="the pmos of a transmission gate is a PMOS"); ?nmos @SELECT-INSTANCE(type="pmos") => @ASSERT-INSTANCE(type="nmos", message="the nmos of a transmission gate is an NMOS") };

  /* A CMOS transmission gate drawn side by side, the PMOS on the left. Places and routes. The transmission gate drawn side by side at one height, the PMOS on the left. */
  $TRANSMISSION_GATE_HORIZONTAL = @DEFINE(roles=[["pmos", ["instance", "usage"]], ["nmos", ["instance", "usage"]]]) { {?pmos ?nmos} @ROUTE-OBJECT(priority="low"); {?pmos ?nmos} @ALIGN("y", priority="low"); {?pmos ?nmos} @ORDER("left-to-right", priority="low"); ?pmos @SELECT-INSTANCE(type="nmos") => @ASSERT-INSTANCE(type="pmos", message="the pmos of a transmission gate is a PMOS"); ?nmos @SELECT-INSTANCE(type="pmos") => @ASSERT-INSTANCE(type="nmos", message="the nmos of a transmission gate is an NMOS") };

  /* A cross-coupled pair: two matched transistors, the gate of each on the drain of the other, drawn mirrored. Places and routes. Two matched transistors with each gate connected to the other's drain, mirrored as $MIRRORED draws left and right; the cross-coupled gate-to-drain nets (the gate of left to the drain of right, and the gate of right to the drain of left) are drawn as explicit internal wires. It asserts that these nets are shared (15.3): gates and drains for MOS, bases and collectors for bipolar transistors, by terminal name. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $CROSS_COUPLED_PAIR = @DEFINE(roles=[["left", "instance"], ["right", "instance"]]) { {?left ?right} @AS $MATCHED; ?left(left) ?right(right) @AS $MIRRORED; {?left ?right} @ROUTE-OBJECT(priority="low"); ?left @SELECT-TERMINAL(terminal="g") => %left_gate_set; ?right @SELECT-TERMINAL(terminal="d") => %right_drain_set; {%left_gate_set %right_drain_set} @ASSERT-TERMINAL(same=["net"], message="the gate of left of a cross-coupled pair is on the drain of right"); ?right @SELECT-TERMINAL(terminal="g") => %right_gate_set; ?left @SELECT-TERMINAL(terminal="d") => %left_drain_set; {%right_gate_set %left_drain_set} @ASSERT-TERMINAL(same=["net"], message="the gate of right of a cross-coupled pair is on the drain of left"); ?left @SELECT-TERMINAL(terminal="b") => %left_base_set; ?right @SELECT-TERMINAL(terminal="c") => %right_collector_set; {%left_base_set %right_collector_set} @ASSERT-TERMINAL(same=["net"], message="the base of left of a cross-coupled pair is on the collector of right"); ?right @SELECT-TERMINAL(terminal="b") => %right_base_set; ?left @SELECT-TERMINAL(terminal="c") => %left_collector_set; {%right_base_set %left_collector_set} @ASSERT-TERMINAL(same=["net"], message="the base of right of a cross-coupled pair is on the collector of left"); {?left ?right} @ASSERT-INSTANCE(same=["model", "w", "l", "nf", "m", "area"], message="the two sides of a pair are matched") };

  /* A static CMOS logic gate: a pull-up network and a pull-down network meeting at the output. Routes; places nothing; a group. Static or clocked complementary MOS logic gate: a pull-up network and a pull-down network meeting at the output. Each network is as its devices are joined, in series or in parallel (a NOR's pull-down is parallel, a NAND's in series), and the gate asserts neither: write each network as a usage, such as {#M3 #M4} @AS $PARALLEL_HORIZONTAL or @AS $BRANCH, and the pull-up above the pull-down with an ORDER of the devices, such as {#M1 #M2 {#M3 #M4}} @ORDER("top-to-bottom"); the gate joins the nets its devices share. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $CMOS_GATE = @DEFINE(roles=[["{pullup}", ["instance", "usage"]], ["{pulldown}", ["instance", "usage"]]]) { {?pullup ?pulldown} @ROUTE-OBJECT(priority="low"); {?pullup ?pulldown} @GROUP; ?pullup @SELECT-INSTANCE(type="nmos") => @ASSERT-INSTANCE(type="pmos", message="the pullup of a CMOS gate is a PMOS"); ?pulldown @SELECT-INSTANCE(type="pmos") => @ASSERT-INSTANCE(type="nmos", message="the pulldown of a CMOS gate is an NMOS") };

  /* A precharge, equalization or reset transistor. Meaning only: places and routes nothing. Clocked precharge, equalization, or reset transistor that initializes internal or output nodes during a reset phase. */
  $RESET_SWITCH = @DEFINE(roles=[["device", "instance"]]) { /* clocked precharge or reset switch */ };

  /* An RF choke or bias resistor that feeds a DC supply or bias to a node. Meaning only: places and routes nothing. Inductor (RF choke) or bias resistor (single device or usage) that feeds a DC supply or bias voltage to an active node and, for that reason, blocks the AC/RF signal from the DC rail; it says nothing else. */
  $DC_FEED = @DEFINE(roles=[["device", ["instance", "usage"]]]) { /* DC bias or supply feed element; carries no other semantics */ };

  /* A decoupling or bypass capacitor on a supply or bias node. Meaning only: places and routes nothing. Decoupling or bypass capacitor (single capacitor or usage such as $PARALLEL) connected between a DC supply or bias node and AC ground/supply to shunt AC/RF fluctuations; it says nothing else. */
  $DECAP = @DEFINE(roles=[["device", ["instance", "usage"]]]) { /* decoupling or bypass capacitor; carries no other semantics */ };

  /* A series coupling capacitor that passes the AC signal and blocks DC. Meaning only: places and routes nothing. Series coupling capacitor (single capacitor or usage) that passes an AC signal between a port and a stage or between stages and, for that reason, blocks DC between them; it says nothing else. */
  $AC_COUPLE = @DEFINE(roles=[["device", ["instance", "usage"]]]) { /* AC coupling capacitor; carries no other semantics */ };

  /* A flying capacitor switched between clock phases. Meaning only: places and routes nothing; a group. Non-grounded transfer capacitor switched between clock phases by top-plate and bottom-plate switches (no drawing constraint). */
  $FLYING_CAPACITOR = @DEFINE(roles=[["capacitor", ["instance", "usage"]], ["{switches}", ["instance", "usage"]]]) { /* flying capacitor and phase switches */ {?capacitor ?switches} @GROUP };

  /* A divider of two branches in series, upper and lower. Routes; places nothing. Two-branch ratio divider (resistive, capacitive, or inductive) connected in $SERIES with roles upper and lower; the shared midpoint net between ?upper and ?lower is drawn as an explicit wire. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $DIVIDER = @DEFINE(roles=[["upper", ["instance", "usage"]], ["lower", ["instance", "usage"]]]) { {?upper ?lower} @AS $SERIES; {?upper ?lower} @ROUTE-OBJECT(priority="low") };

  /* A low-side switch to the ground or return rail. Meaning only: places and routes nothing. Low-side footer switch connected directly to a ground/return rail to gate return current or discharge a node. */
  $GROUND_SWITCH = @DEFINE(roles=[["device", "instance"]]) { /* low-side ground switch */ };

  /* A first-order RC low-pass filter: a series resistor and a shunt capacitor. Routes; places nothing; a group. First-order passive RC low-pass filter section (series resistor, shunt capacitor) specializing $DIVIDER, with semantics only and no drawing constraint. */
  $FILTER_LOWPASS_RC = @DEFINE(roles=[["resistor", ["instance", "usage"]], ["capacitor", ["instance", "usage"]]]) { ?resistor(upper) ?capacitor(lower) @AS $DIVIDER; {?resistor ?capacitor} @GROUP };

  /* A high-side switch to the supply rail. Meaning only: places and routes nothing. High-side header switch connected directly to a positive supply rail to gate power or charge a circuit node. */
  $POWER_SWITCH = @DEFINE(roles=[["device", "instance"]]) { /* high-side supply switch */ };

  /* A voltage-follower stage of one transistor. Meaning only: places and routes nothing. Abstract voltage-follower transistor stage (superclass of $COMMON_DRAIN and $COMMON_COLLECTOR). */
  $FOLLOWER = @DEFINE(roles=[["device", "instance"]]) { /* abstract voltage-follower stage */ };

  /* A switched-capacitor sampler: sampling switches with sampling capacitors. Meaning only: places and routes nothing; a group. Switched-capacitor sampling cell pairing sampling switch(es) {switch} with sampling capacitor(s) {capacitor} (no drawing constraint). */
  $SC_SAMPLER = @DEFINE(roles=[["{switch}", ["instance", "usage"]], ["{capacitor}", ["instance", "usage"]]]) { /* switched-capacitor sampling cell */ {?switch ?capacitor} @GROUP };

  /* A charge-sharing network: two groups of capacitors that share charge through switches. Routes; places nothing; a group. Charge-redistribution network where capacitor groups ?a and ?b share charge through switch(es) ?switch (no drawing constraint); the shared charge-sharing nets connecting ?a, ?switch, and ?b are drawn as explicit wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $CHARGE_SHARING = @DEFINE(roles=[["{a}", ["instance", "usage"]], ["{switch}", ["instance", "usage"]], ["{b}", ["instance", "usage"]]]) { {?a ?switch ?b} @ROUTE-OBJECT(priority="low"); {?a ?switch ?b} @GROUP };

  /* A parallel RLC or LC tank. Routes; places nothing; a group. Parallel RLC (or LC) resonant tank with optional damping resistor(s), inductor(s), and capacitor(s); the shared tank terminal nets are drawn as explicit wires. It does not apply $PARALLEL, so asserts no topology: a group left empty would be a member on no net (15.4), and an inductor with a tap or a capacitor bank with tuning nets is no two-terminal box, while the tank is still a tank. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $RLC_TANK = @DEFINE(roles=[["{resistors}", ["instance", "usage"]], ["{inductors}", ["instance", "usage"]], ["{capacitors}", ["instance", "usage"]]]) { {?resistors ?inductors ?capacitors} @ROUTE-OBJECT(priority="low"); {?resistors ?inductors ?capacitors} @GROUP };

  /* A differential pair degenerated by a bridge between its two tails, an H. Places and routes; a group. H-bridge source/emitter-degenerated differential stage (not a $DIFFERENTIAL_PAIR_N or _P, and no $SERIES): matched inputs, matched tails, MY between inputs only, each input aligned with its tail in x, inputs aligned in y, tails aligned in y, and the bridge in the middle between the inputs, left on the left (left and right are sides of the drawing, as for the differential pair); horizontal bridge nets are drawn as explicit wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. The sources point as the type has them, of nmos and njf down, of pmos and pjf up, and the emitters of npn down, of pnp and lpnp up: an ORIENT of their pins, selected by type, so that the pair does not lie on its side; an instance without a type is left free. */
  $DEGENERATED_DIFFERENTIAL_PAIR_TYPE_H = @DEFINE(roles=[["left", "instance"], ["right", "instance"], ["{tailleft}", ["instance", "usage"]], ["{tailright}", ["instance", "usage"]], ["{bridge}", ["instance", "usage"]]]) { {?left ?right} @AS $MATCHED; {?tailleft ?tailright} @AS $MATCHED; ?left ?right @ORIENT-RELATION("MY", priority="low"); {?left ?tailleft} @ALIGN("x", priority="low"); {?right ?tailright} @ALIGN("x", priority="low"); {?left ?right} @ALIGN("y", priority="low"); {?tailleft ?tailright} @ALIGN("y", priority="low"); {?left {?bridge} ?right} @DISTRIBUTE("left-to-right", priority="low"); {?left ?right ?tailleft ?tailright ?bridge} @ROUTE-OBJECT(priority="low"); {?left ?right ?tailleft ?tailright ?bridge} @GROUP; {?left ?right} @ASSERT-INSTANCE(same=["model", "w", "l", "nf", "m", "area"], message="the two sides of a pair are matched"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="nmos") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="pmos") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="njf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="pjf") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="e") => @ORIENT("down", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low") };

  /* A first-order RC high-pass filter: a series capacitor and a shunt resistor. Routes; places nothing; a group. First-order passive RC high-pass filter section (series capacitor, shunt resistor) specializing $DIVIDER, with semantics only and no drawing constraint. */
  $FILTER_HIGHPASS_RC = @DEFINE(roles=[["capacitor", ["instance", "usage"]], ["resistor", ["instance", "usage"]]]) { ?capacitor(upper) ?resistor(lower) @AS $DIVIDER; {?capacitor ?resistor} @GROUP };

  /* Two symmetric objects in one column, mirror images of each other. Places; routes nothing. Top-bottom counterpart of $MIRRORED: two symmetric objects in one column, mirror images about an optional horizontal axis, top above the axis and bottom below (swap the roles to swap the sides). */
  $MIRRORED_VERTICAL = @DEFINE(roles=[["top", ["instance", "usage"]], ["bottom", ["instance", "usage"]], ["{axis}", ["point", "instance", "usage", "net"]]]) { {?top ?bottom} @ALIGN("x", priority="low"); {?top {?axis} ?bottom} @DISTRIBUTE("top-to-bottom", priority="low"); ?top ?bottom @ORIENT-RELATION("MX", priority="low") };

  /* A common-base stage of one BJT. Meaning only: places and routes nothing. Single-BJT common-base stage (input at emitter, output at collector, AC-grounded bias at base). */
  $COMMON_BASE = @DEFINE(roles=[["device", "instance"]]) { /* single-BJT common-base stage */ };

  /* A Widlar current mirror: a current mirror with a degenerated output. Routes; places nothing. Source- or emitter-degenerated Widlar bias stage (does not apply $CURRENT_MIRROR); the shared gate/base net between ?ref and ?out, the diode connection on ?ref, and the series net between ?out and ?degenerator are drawn as explicit internal wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $WIDLAR_CURRENT_MIRROR = @DEFINE(roles=[["{ref}", "instance"], ["{out}", "instance"], ["{degenerator}", ["instance", "usage"]]]) { {?out ?degenerator} @AS $SERIES; {?ref ?out ?degenerator} @ROUTE-OBJECT(priority="low"); {?ref ?out} @SELECT-TERMINAL(terminal="g") => @ASSERT-TERMINAL(same=["net"], message="the gates of a Widlar current mirror share a net"); {?ref ?out} @SELECT-TERMINAL(terminal="c") => @SELECT-INSTANCE => @SELECT-TERMINAL(terminal="b") => @ASSERT-TERMINAL(same=["net"], message="the bases of a Widlar current mirror share a net"); {?ref ?out} @ASSERT-INSTANCE(same=["model", "l"], message="the transistors of a Widlar current mirror have one model and one length") };

  /* Two BJTs, or a BJT and a group of parallel BJTs, whose sizes are in a ratio. Meaning only: places and routes nothing. Two BJTs, or a BJT and a group of parallel BJTs, whose sizes are in a ratio (neither $WIDLAR_CURRENT_MIRROR nor $MATCHED). */
  $RATIO_BJT = @DEFINE(roles=[["unit", "instance"], ["{array}", "instance"]]) { /* two BJTs, or a BJT and a parallel BJT array, whose sizes are in a ratio */ };

  /* An emitter follower (a common-collector stage) of one BJT. Meaning only: places and routes nothing. Single-BJT emitter-follower (common-collector) stage specializing $FOLLOWER. */
  $COMMON_COLLECTOR = @DEFINE(roles=[["device", "instance"]]) { ?device @AS $FOLLOWER };

  /* A source follower (a common-drain stage) of one MOSFET. Meaning only: places and routes nothing. Single-MOSFET source-follower (common-drain) stage specializing $FOLLOWER. */
  $COMMON_DRAIN = @DEFINE(roles=[["device", "instance"]]) { ?device @AS $FOLLOWER };

  /* A common-emitter stage of one BJT. Meaning only: places and routes nothing. Single-BJT common-emitter transconductance/gain stage (input at base, output at collector). */
  $COMMON_EMITTER = @DEFINE(roles=[["device", "instance"]]) { /* single-BJT common-emitter stage */ };

  /* A common-gate stage of one MOSFET. Meaning only: places and routes nothing. Single-MOSFET common-gate stage (input at source, output at drain, AC-grounded bias at gate). */
  $COMMON_GATE = @DEFINE(roles=[["device", "instance"]]) { /* single-transistor common-gate stage */ };

  /* A rail-to-rail input stage: a PMOS and an NMOS differential pair on the same inputs. Routes; places nothing; a group. Rail-to-rail differential input stage combining a PMOS differential pair (pmos) and an NMOS differential pair (nmos) with no position constraint; the shared differential input gate nets connecting ?pmos and ?nmos are drawn as explicit wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $COMPLEMENTARY_DIFFERENTIAL_PAIR = @DEFINE(roles=[["pmos", "usage"], ["nmos", "usage"]]) { {?pmos ?nmos} @ROUTE-OBJECT(priority="low"); {?pmos ?nmos} @GROUP; ?pmos @SELECT-INSTANCE(type="nmos") => @ASSERT-INSTANCE(type="pmos", message="the pmos of a complementary differential pair is a PMOS"); ?nmos @SELECT-INSTANCE(type="pmos") => @ASSERT-INSTANCE(type="nmos", message="the nmos of a complementary differential pair is an NMOS") };

  /* A pseudo-differential pair: two matched input transistors without a tail, drawn mirrored. Places; routes nothing. Matched symmetric pair of input transistors driven differentially without a tail current source, mirrored as $MIRRORED draws left and right (left and right are the sides of the drawing). The sources point as the type has them, of nmos and njf down, of pmos and pjf up, and the emitters of npn down, of pnp and lpnp up: an ORIENT of their pins, selected by type, so that the pair does not lie on its side; an instance without a type is left free. */
  $PSEUDO_DIFFERENTIAL_PAIR = @DEFINE(roles=[["left", "instance"], ["right", "instance"]]) { {?left ?right} @AS $MATCHED; ?left(left) ?right(right) @AS $MIRRORED; {?left ?right} @ASSERT-INSTANCE(same=["model", "w", "l", "nf", "m", "area"], message="the two sides of a pair are matched"); {?left ?right} @SELECT-INSTANCE(type="nmos") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right} @SELECT-INSTANCE(type="pmos") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right} @SELECT-INSTANCE(type="njf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right} @SELECT-INSTANCE(type="pjf") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right} @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="e") => @ORIENT("down", priority="low"); {?left ?right} @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low"); {?left ?right} @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low") };

  /* A ladder of resistors in series in one column, from the top down. Places and routes; a group. Multi-tap series string of three or more resistors providing stepped reference voltages, drawn as a $BRANCH: one column, from the top down in the order written (as a row: $RESISTOR_LADDER_HORIZONTAL). */
  $RESISTOR_LADDER = @DEFINE(roles=[["{resistors}", "instance"]]) { ?resistors @AS $BRANCH; {?resistors} @GROUP };

  /* A ladder of resistors in series drawn as a row. Places and routes; a group. The resistor ladder drawn as a row, a $BRANCH_HORIZONTAL. */
  $RESISTOR_LADDER_HORIZONTAL = @DEFINE(roles=[["{resistors}", "instance"]]) { ?resistors @AS $BRANCH_HORIZONTAL; {?resistors} @GROUP };

  /* A pi network: a shunt branch, a series branch and another shunt branch. Routes; places nothing; a group. Three-branch passive Pi network (shunt1, series bridge, shunt2) with no drawing constraint; the shared terminal nets joining ?shunt1 to ?series and ?series to ?shunt2 are drawn as explicit internal wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $PI_NETWORK = @DEFINE(roles=[["shunt1", ["instance", "usage"]], ["series", ["instance", "usage"]], ["shunt2", ["instance", "usage"]]]) { {?shunt1 ?series ?shunt2} @ROUTE-OBJECT(priority="low"); {?shunt1 ?series ?shunt2} @GROUP; {?shunt1 ?series ?shunt2} @ASSERT-TOPOLOGY("loop", exclude=[["nmos", "g"], ["nmos", "b"], ["pmos", "g"], ["pmos", "b"], ["npn", "b"], ["npn", "s"], ["pnp", "b"], ["pnp", "s"], ["lpnp", "b"], ["lpnp", "s"], ["njf", "g"], ["pjf", "g"], ["nmf", "g"], ["pmf", "g"]], message="the three branches of a pi network go round") };

  /* A translinear loop of two groups of transistors, drawn in columns. Places and routes. Floating class-AB or Gilbert translinear loop formed by two transistor pairs in $PARALLEL, every member of a in one column with every member of b (at one height: $TRANS_LINEAR_LOOP_HORIZONTAL); their internal loop nets are drawn as explicit wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $TRANS_LINEAR_LOOP = @DEFINE(roles=[["{a}", ["instance", "usage"]], ["{b}", ["instance", "usage"]]]) { {?a ?b} @AS $PARALLEL; {?a ?b} @ALIGN("x", priority="low"); {?a ?b} @ROUTE-OBJECT(priority="low") };

  /* A translinear loop of two groups of transistors, drawn in rows. Places and routes. The translinear loop with every member of a at one height with every member of b. */
  $TRANS_LINEAR_LOOP_HORIZONTAL = @DEFINE(roles=[["{a}", ["instance", "usage"]], ["{b}", ["instance", "usage"]]]) { {?a ?b} @AS $PARALLEL; {?a ?b} @ALIGN("y", priority="low"); {?a ?b} @ROUTE-OBJECT(priority="low") };

  /* A T network: a series branch, a shunt branch and another series branch. Routes; places nothing; a group. Three-branch passive T network (series1, central shunt branch, series2) with no drawing constraint; the shared central T-junction net connecting ?series1, ?shunt, and ?series2 is drawn as an explicit internal wire. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $T_NETWORK = @DEFINE(roles=[["series1", ["instance", "usage"]], ["shunt", ["instance", "usage"]], ["series2", ["instance", "usage"]]]) { {?series1 ?shunt ?series2} @ROUTE-OBJECT(priority="low"); {?series1 ?shunt ?series2} @GROUP; {?series1 ?shunt ?series2} @ASSERT-TOPOLOGY("star", exclude=[["nmos", "g"], ["nmos", "b"], ["pmos", "g"], ["pmos", "b"], ["npn", "b"], ["npn", "s"], ["pnp", "b"], ["pnp", "s"], ["lpnp", "b"], ["lpnp", "s"], ["njf", "g"], ["pjf", "g"], ["nmf", "g"], ["pmf", "g"]], message="the three branches of a T network meet at one net") };

  /* A chopper: a bridge of four switches that reverses the polarity of a signal. Meaning only: places and routes nothing; a group. Four-switch polarity-reversing modulator/demodulator bridge holding only the matched semantics on ?straight and ?crossed, with no drawing constraint. */
  $CHOPPER = @DEFINE(roles=[["{straight}", ["instance", "usage"]], ["{crossed}", ["instance", "usage"]]]) { ?straight @AS $MATCHED; ?crossed @AS $MATCHED; {?straight ?crossed} @GROUP };

  /* A differential pair degenerated by an element under each input, a T. Places; routes nothing; a group. T-type source/emitter-degenerated differential stage (not a $DIFFERENTIAL_PAIR_N or _P, with no $SERIES and no @ORDER): matched inputs, matched degeneration elements, and the tail in the middle between the inputs, left on the left (left and right are sides of the drawing, as for the differential pair). The sources point as the type has them, of nmos and njf down, of pmos and pjf up, and the emitters of npn down, of pnp and lpnp up: an ORIENT of their pins, selected by type, so that the pair does not lie on its side; an instance without a type is left free. */
  $DEGENERATED_DIFFERENTIAL_PAIR_TYPE_T = @DEFINE(roles=[["left", "instance"], ["right", "instance"], ["degleft", ["instance", "usage"]], ["degright", ["instance", "usage"]], ["{tail}", ["instance", "usage"]]]) { {?left ?right} @AS $MATCHED; {?degleft ?degright} @AS $MATCHED; {?left {?tail} ?right} @DISTRIBUTE("left-to-right", priority="low"); {?left ?right ?degleft ?degright ?tail} @GROUP; {?left ?right} @ASSERT-INSTANCE(same=["model", "w", "l", "nf", "m", "area"], message="the two sides of a pair are matched"); {?left ?right ?tail} @SELECT-INSTANCE(type="nmos") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pmos") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="njf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pjf") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="e") => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="e") => @ORIENT("up", priority="low") };

  /* A second-order LC high-pass filter: a series capacitor and a shunt inductor. Routes; places nothing; a group. Second-order passive LC high-pass L-section (series capacitor, shunt inductor) specializing $DIVIDER, with semantics only and no drawing constraint. */
  $FILTER_HIGHPASS_LC = @DEFINE(roles=[["capacitor", ["instance", "usage"]], ["inductor", ["instance", "usage"]]]) { ?capacitor(upper) ?inductor(lower) @AS $DIVIDER; {?capacitor ?inductor} @GROUP };

  /* A second-order LC low-pass filter: a series inductor and a shunt capacitor. Routes; places nothing; a group. Second-order passive LC low-pass L-section (series inductor, shunt capacitor) specializing $DIVIDER, with semantics only and no drawing constraint. */
  $FILTER_LOWPASS_LC = @DEFINE(roles=[["inductor", ["instance", "usage"]], ["capacitor", ["instance", "usage"]]]) { ?inductor(upper) ?capacitor(lower) @AS $DIVIDER; {?inductor ?capacitor} @GROUP };

  /* A series RLC or LC tank. Routes; places nothing. Series-resonant RLC (or LC) tank section with optional resistor(s), inductor(s), and capacitor(s), without $SERIES semantics since the branch may be folded; internal tank nets are drawn as explicit wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $SERIES_RLC_TANK = @DEFINE(roles=[["{resistors}", ["instance", "usage"]], ["{inductors}", ["instance", "usage"]], ["{capacitors}", ["instance", "usage"]]]) { {?resistors ?inductors ?capacitors} @ROUTE-OBJECT(priority="low") };

  /* An RC band-pass filter: a series RC above a parallel RC. Routes; places nothing; a group. Divider-type passive RC band-pass filter section specializing $DIVIDER, where upper is a series RC ($SERIES usage) and lower is a parallel RC ($PARALLEL usage), with semantics only and no drawing constraint. */
  $FILTER_BANDPASS_RC = @DEFINE(roles=[["upper", "usage"], ["lower", "usage"]]) { ?upper(upper) ?lower(lower) @AS $DIVIDER; {?upper ?lower} @GROUP };

  /* An LC band-pass filter: a series LC above a parallel LC. Routes; places nothing; a group. Divider-type passive LC band-pass filter section specializing $DIVIDER, where upper is a series LC ($SERIES usage) and lower is a parallel LC ($PARALLEL usage), with semantics only and no drawing constraint. */
  $FILTER_BANDPASS_LC = @DEFINE(roles=[["upper", "usage"], ["lower", "usage"]]) { ?upper(upper) ?lower(lower) @AS $DIVIDER; {?upper ?lower} @GROUP };

  /* An RLC band-pass filter of two branches. Routes; places nothing; a group. Divider-type passive RLC band-pass filter section specializing $DIVIDER in either of two forms (upper is R and lower is parallel LC, or upper is series LC and lower is R), with semantics only and no drawing constraint. */
  $FILTER_BANDPASS_RLC = @DEFINE(roles=[["upper", ["instance", "usage"]], ["lower", ["instance", "usage"]]]) { ?upper(upper) ?lower(lower) @AS $DIVIDER; {?upper ?lower} @GROUP };

  /* An LC band-stop filter: a parallel LC above a series LC. Routes; places nothing; a group. Divider-type passive LC band-stop filter section specializing $DIVIDER, where upper is a parallel LC ($PARALLEL usage) and lower is a series LC ($SERIES usage), with semantics only and no drawing constraint. */
  $FILTER_BANDSTOP_LC = @DEFINE(roles=[["upper", "usage"], ["lower", "usage"]]) { ?upper(upper) ?lower(lower) @AS $DIVIDER; {?upper ?lower} @GROUP };

  /* An RLC band-stop filter of two branches. Routes; places nothing; a group. Divider-type passive RLC band-stop filter section specializing $DIVIDER in either of two forms (upper is R and lower is series LC, or upper is parallel LC and lower is R), with semantics only and no drawing constraint. */
  $FILTER_BANDSTOP_RLC = @DEFINE(roles=[["upper", ["instance", "usage"]], ["lower", ["instance", "usage"]]]) { ?upper(upper) ?lower(lower) @AS $DIVIDER; {?upper ?lower} @GROUP };

  /* A first-order RL high-pass filter: a series resistor and a shunt inductor. Routes; places nothing; a group. First-order passive RL high-pass filter section (series resistor, shunt inductor) specializing $DIVIDER, with semantics only and no drawing constraint. */
  $FILTER_HIGHPASS_RL = @DEFINE(roles=[["resistor", ["instance", "usage"]], ["inductor", ["instance", "usage"]]]) { ?resistor(upper) ?inductor(lower) @AS $DIVIDER; {?resistor ?inductor} @GROUP };

  /* A first-order RL low-pass filter: a series inductor and a shunt resistor. Routes; places nothing; a group. First-order passive RL low-pass filter section (series inductor, shunt resistor) specializing $DIVIDER, with semantics only and no drawing constraint. */
  $FILTER_LOWPASS_RL = @DEFINE(roles=[["inductor", ["instance", "usage"]], ["resistor", ["instance", "usage"]]]) { ?inductor(upper) ?resistor(lower) @AS $DIVIDER; {?inductor ?resistor} @GROUP };

  /* A signal path that flows one way. Meaning only: places and routes nothing. Unidirectional signal flow path accepting both instances and usages without @ORDER; the parameter direction (default "left-to-right", one of the four directions) draws nothing. */
  $FLOW = @DEFINE(roles=[["{path}", ["instance", "usage"]]], parameters=[["direction", "left-to-right"]]) { /* {path} accepts instances and usages; it states no order */ };

  /* A feedback loop: a forward path and a feedback network. Meaning only: places and routes nothing. Closed-loop feedback topology pairing a forward gain path with a return feedback network, with no default drawing constraint. */
  $FEEDBACK_LOOP = @DEFINE(roles=[["{forward}", ["instance", "usage"]], ["{feedback}", ["instance", "usage"]]]) { /* closed-loop forward and feedback paths */ };

  /* A common-source amplifier: a MOSFET input and its load. Routes; places nothing. Common-source amplifier stage: a semantic variant of $TRANSCONDUCTOR_Z_AMPLIFIER whose transconductor is a MOSFET common-source stage, without $SERIES semantics since it may be folded (the BJT counterpart is $COMMON_EMITTER_AMPLIFIER). */
  $COMMON_SOURCE_AMPLIFIER = @DEFINE(roles=[["input", ["instance", "usage"]], ["load", ["instance", "usage"]]]) { ?input(transconductor) ?load(load) @AS $TRANSCONDUCTOR_Z_AMPLIFIER };

  /* A Miller-compensated amplifier: a gain stage and its compensation network. Meaning only: places and routes nothing; a group. Two-stage Miller-compensated amplifier branch combining a gain stage and its Miller compensation network across input and output, specializing $FEEDBACK_LOOP. */
  $MILLER_AMPLIFIER = @DEFINE(roles=[["stage", ["instance", "usage"]], ["{compensation}", ["instance", "usage"]]]) { ?stage(forward) ?compensation(feedback) @AS $FEEDBACK_LOOP; {?stage ?compensation} @GROUP };

  /* A push-pull output stage: a pull-up driver above a pull-down driver. Routes; places nothing. Complementary class-A/AB output branch stacking a high-side pull-up driver and a low-side pull-down driver in $SERIES. */
  $PUSH_PULL_STAGE = @DEFINE(roles=[["pullup", ["instance", "usage"]], ["pulldown", ["instance", "usage"]]]) { {?pullup ?pulldown} @AS $SERIES };

  /* A folded cascode: an input device folded into a common-gate transistor with its bias. Routes; places nothing; a group. Single-sided folded-cascode stage where ?source folds into ?cascode (with embedded $COMMON_GATE semantics) biased by ?bias, without $SERIES or @ORDER constraints; the shared folding-node net joining ?source, ?bias, and ?cascode is drawn as an explicit internal wire. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $FOLDED_CASCODE = @DEFINE(roles=[["{source}", ["instance", "usage"]], ["cascode", "instance"], ["{bias}", ["instance", "usage"]]]) { ?cascode @AS $COMMON_GATE; {?source ?cascode ?bias} @ROUTE-OBJECT(priority="low"); {?source ?cascode ?bias} @GROUP };

  /* A switch of several throws that share one pole. Meaning only: places and routes nothing; a group. Multi-throw switch (2:1 MUX or reference selector) whose throws share a common pole node and each act as a $PASS_SWITCH, with no drawing constraint. */
  $MULTI_POLE_SWITCH = @DEFINE(roles=[["{throws}", ["instance", "usage"]]]) { ?throws @AS $PASS_SWITCH; {?throws} @GROUP };

  /* A latch: a bistable core with the devices around it. Meaning only: places and routes nothing; a group. Positive-feedback bistable regeneration core (abstract superclass of $SR_LATCH and $INVERTER_LATCH, or back-to-back PMOS/NMOS cross-coupled latch core), with no drawing constraint; {others} holds the devices of the latch that are not its core, such as switches in series between its pairs, so that its group holds them too. */
  $LATCH = @DEFINE(roles=[["{core}", ["instance", "usage"]], ["{others}", ["instance", "usage"]]]) { /* abstract bistable regeneration core */ {?core ?others} @GROUP };

  /* A bootstrapped sampling switch: the switch, its bootstrap capacitor and its helpers. Meaning only: places and routes nothing; a group. Constant-Vgs bootstrapped sampling switch with main pass transistor (switch), bootstrap capacitor (cap), and auxiliary control switches ({others}). */
  $BOOTSTRAPPED_SWITCH = @DEFINE(roles=[["switch", "instance"], ["cap", "instance"], ["{others}", ["instance", "usage"]]]) { /* bootstrapped sampling switch cell */ {?switch ?cap ?others} @GROUP };

  /* An LC oscillator: a tank and its active negative-resistance core. Meaning only: places and routes nothing; a group. Negative-Gm LC oscillator combining a resonant tank usage and active cross-coupled pair usage(s), with no drawing constraint. */
  $LC_OSCILLATOR = @DEFINE(roles=[["tank", "usage"], ["{active}", "usage"]]) { /* LC tank and active negative-Gm core */ {?tank ?active} @GROUP };

  /* A shift register: a chain of flip-flops or latches. Meaning only: places and routes nothing. Sequential chain of flip-flops or delay latches clocked in series, with no drawing constraint. */
  $SHIFT_REGISTER = @DEFINE(roles=[["{stages}", ["instance", "usage"]]]) { /* sequential shift-register stages */ };

  /* A degenerated amplifier stage: a transconductor, its load and its degeneration. Routes; places nothing. Single-ended transconductor-Z amplifier stage with source or emitter degeneration; {degenerator} is the impedance between the transconductor's source or emitter and its return, with no $SERIES and no drawing constraint. */
  $DEGENERATED_TRANSCONDUCTOR_Z_AMPLIFIER = @DEFINE(roles=[["{transconductor}", ["instance", "usage"]], ["{load}", ["instance", "usage"]], ["{degenerator}", ["instance", "usage"]]]) { ?transconductor(transconductor) ?load(load) @AS $TRANSCONDUCTOR_Z_AMPLIFIER };

  /* An amplifier stage: a transconductor and its load. Routes; places nothing. Semantic transconductor-load amplifier stage pairing ?transconductor with ?load (superclass of $COMMON_SOURCE_AMPLIFIER and $COMMON_EMITTER_AMPLIFIER); the internal output/interstage nets connecting ?transconductor and ?load are drawn as explicit wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $TRANSCONDUCTOR_Z_AMPLIFIER = @DEFINE(roles=[["{transconductor}", ["instance", "usage"]], ["{load}", ["instance", "usage"]]]) { {?transconductor ?load} @ROUTE-OBJECT(priority="low") };

  /* An SR latch of two cross-coupled NAND or NOR gates. Routes; places nothing; a group. Cross-coupled two-gate (NAND or NOR) SR bistable latch specializing $LATCH, with no drawing constraint; cross-coupled feedback nets are drawn as explicit internal wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $SR_LATCH = @DEFINE(roles=[["a", ["instance", "usage"]], ["b", ["instance", "usage"]]]) { {?a ?b} @AS $LATCH; {?a ?b} @ROUTE-OBJECT(priority="low"); {?a ?b} @GROUP };

  /* A latch of two cross-coupled inverters. Routes; places nothing; a group. Back-to-back cross-coupled inverter keeper/storage loop specializing $LATCH, with no drawing constraint; cross-coupled loop nets are drawn as explicit internal wires. A ground or supply net among them is not: rnl-std-fill leaves it unwired, drawn with symbols, unless the file writes &net @ROUTE-NET(priority="high") or a WIRE. */
  $INVERTER_LATCH = @DEFINE(roles=[["a", ["instance", "usage"]], ["b", ["instance", "usage"]]]) { {?a ?b} @AS $LATCH; {?a ?b} @ROUTE-OBJECT(priority="low"); {?a ?b} @GROUP };

  /* A common-emitter amplifier: a BJT input and its load. Routes; places nothing. Common-emitter amplifier stage: the BJT counterpart of $COMMON_SOURCE_AMPLIFIER, a variant of $TRANSCONDUCTOR_Z_AMPLIFIER for a bipolar input device. */
  $COMMON_EMITTER_AMPLIFIER = @DEFINE(roles=[["input", ["instance", "usage"]], ["load", ["instance", "usage"]]]) { ?input(transconductor) ?load(load) @AS $TRANSCONDUCTOR_Z_AMPLIFIER }
}

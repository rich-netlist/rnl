/* rnl-std-45deg 0.4, an optional extension package of the standard series 0.4 (16.3).
   45-degree symbols for bridges, cross-coupled pairs, diagonal windings and 45-degree wires.
   Not included in rnl-std-all; load explicitly with @USE-PACKAGE(name="rnl-std-45deg", version="0.4").
   Every pin sits on an integer grid point with a four-way direction; combined with RNL's eight
   orientations (R0, R90, R180, R270, MY, MX, MYR90, MXR90), one symbol per part covers all four
   diagonal orientations and both orthogonal pin-exit directions without off-grid coordinates. */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-45deg", version="0.4");
  @USE-PACKAGE(name="rnl-std-basic", version="0.4");
}

@RNL {
  /* ---------------------------------------------------------------- passive parts and switch */

  /* A 45-degree resistor. Terminals: p n. */
  $RESISTOR_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %p = (-2, 2) @PIN(terminal="p", direction="up");
    %n = (2, -2) @PIN(terminal="n", direction="down");
    @LINE {(-2, 2) (-0.6167, 0.6167) (-0.0723, 0.8321) (-0.6134, -0.0378) (0.2976, 0.4621) (-0.2294, -0.476) (0.7087, 0.051) (0.2088, -0.8601) (0.6167, -0.6167) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.9, 0.9);
    ? @TEXT("${value}", key="value") => @PLACE(1.4, -0.2);
  };

  /* A 45-degree capacitor. Terminals: p n. */
  $CAPACITOR_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %p = (-2, 2) @PIN(terminal="p", direction="up");
    %n = (2, -2) @PIN(terminal="n", direction="down");
    @LINE(linewidth=0.24) {(0.3406, 0.798) (-0.798, -0.3406)};
    @LINE(linewidth=0.24) {(0.798, 0.3406) (-0.3406, -0.798)};
    @LINE {(-2, 2) (-0.2287, 0.2287)};
    @LINE {(0.2287, -0.2287) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.0, 1.0);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.1);
  };

  /* A 45-degree inductor (also serves diagonal transformer or balun windings). Terminals: p n. */
  $INDUCTOR_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %p = (-2, 2) @PIN(terminal="p", direction="up");
    %n = (2, -2) @PIN(terminal="n", direction="down");
    @LINE {(-2, 2) (-0.8485, 0.8485)};
    @ARC(cap="round") {(-0.8485, 0.8485) (-0.6364, 0.9364) (-0.4243, 0.8485)};
    @ARC {(-0.4243, 0.8485) (-0.3364, 0.6364) (-0.4243, 0.4243)};
    @ARC {(-0.4243, 0.4243) (0, 0.4243) (0, 0)};
    @ARC {(0, 0) (0.4243, 0) (0.4243, -0.4243)};
    @ARC {(0.4243, -0.4243) (0.6364, -0.3364) (0.8485, -0.4243)};
    @ARC(cap="round") {(0.8485, -0.4243) (0.9364, -0.6364) (0.8485, -0.8485)};
    @LINE {(0.8485, -0.8485) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.9, 0.9);
    ? @TEXT("${value}", key="value") => @PLACE(1.4, -0.2);
  };

  /* A 45-degree open switch. Terminals: p n. */
  $SWITCH_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %p = (-2, 2) @PIN(terminal="p", direction="left");
    %n = (2, -2) @PIN(terminal="n", direction="right");
    @LINE {(-2, 2) (-0.8999, 0.8999)};
    (-0.672, 0.6749) @CIRCLE(radius=0.3203);
    @LINE {(-0.3207, 0.6627) (1.3586, 0.4526)};
    (0.7934, -0.7906) @CIRCLE(radius=0.3202);
    @LINE {(1.0184, -1.0184) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.1, 1.2);
  };

  /* ---------------------------------------------------------------- sources */

  /* A 45-degree independent voltage source, + near p and - near n kept upright. Terminals: p n. */
  $VOLTAGE_SOURCE_45 = @DEFINE-SYMBOL(box=[-2.2, -2, 2, 2]) {
    %p = (-2, 2) @PIN(terminal="p", direction="up");
    %n = (2, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-2, 2) (-0.7606, 0.7606)};
    @LINE {(0.7606, -0.7606) (2, -2)};
    @LINE {(-2.05, 0.85) (-1.35, 0.85)};
    @LINE {(-1.7, 1.2) (-1.7, 0.5)};
    @LINE {(0.15, -1.7) (0.85, -1.7)};
    ? @TEXT("${name}", key="name") => @PLACE(1.2, 0.9);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.2);
  };

  /* A 45-degree independent current source, arrow from p to n. Terminals: p n. */
  $CURRENT_SOURCE_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %p = (-2, 2) @PIN(terminal="p", direction="up");
    %n = (2, -2) @PIN(terminal="n", direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-0.4933, 0.4933) (-0.1645, 0.1645)};
    @LINE(fill="linecolor", linestyle="none") {(0.4933, -0.4933) (-0.4933, -0.1644) (0.1644, 0.4933) (0.4933, -0.4933)};
    @LINE {(-2, 2) (-0.7606, 0.7606)};
    @LINE {(0.7606, -0.7606) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.2, 0.9);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.2);
  };

  /* ---------------------------------------------------------------- diodes */

  /* A 45-degree diode. Terminals: a k. */
  $DIODE_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %a = (-2, 2) @PIN(terminal="a", direction="left");
    %k = (2, -2) @PIN(terminal="k", direction="right");
    @LINE {(-2, 2) (-0.5892, 0.5892)};
    @LINE {(-0.1119, 1.0665) (-1.0665, 0.1119) (0.4125, -0.4125) (-0.1119, 1.0665)};
    @LINE(linewidth=0.24) {(0.9899, 0.0471) (-0.0471, -0.9899)};
    @LINE {(0.4714, -0.4714) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.85, 0.85);
    ? @TEXT("", key="model") => @PLACE(-1.6, -0.85);
  };

  /* A 45-degree Zener diode. Terminals: a k. */
  $ZENER_DIODE_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %a = (-2, 2) @PIN(terminal="a", direction="left");
    %k = (2, -2) @PIN(terminal="k", direction="right");
    @LINE {(-2, 2) (-0.5518, 0.5518)};
    @LINE {(-0.0989, 1.0046) (-1.0046, 0.0989) (0.4671, -0.4671) (-0.0989, 1.0046)};
    @LINE(linewidth=0.24) {(0.5564, 0.6467) (1.0658, 0.123) (-0.1088, -1.0516) (0.4006, -1.5609)};
    @LINE {(0.4714, -0.4714) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.95, 0.95);
    ? @TEXT("", key="model") => @PLACE(-1.6, -0.85);
  };

  /* A 45-degree Schottky diode. Terminals: a k. */
  $SCHOTTKY_DIODE_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %a = (-2, 2) @PIN(terminal="a", direction="left");
    %k = (2, -2) @PIN(terminal="k", direction="right");
    @LINE {(-2, 2) (-0.5892, 0.5892)};
    @LINE {(-0.1119, 1.0665) (-1.0665, 0.1119) (0.4125, -0.4125) (-0.1119, 1.0665)};
    @LINE(linewidth=0.24) {(1.0135, -0.4007) (1.2256, -0.1886) (0.9899, 0.0471) (-0.0471, -0.9899) (-0.2828, -0.7542) (-0.0707, -0.5421)};
    @LINE {(0.4714, -0.4714) (2, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.95, 0.95);
    ? @TEXT("", key="model") => @PLACE(-1.6, -0.85);
  };

  /* A 45-degree light-emitting diode (LED). Terminals: a k. */
  $LED_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %a = (-2, 2) @PIN(terminal="a", direction="left");
    %k = (2, -2) @PIN(terminal="k", direction="right");
    @LINE {(-2, 2) (-0.5892, 0.5892)};
    @LINE {(-0.1119, 1.0665) (-1.0665, 0.1119) (0.4125, -0.4125) (-0.1119, 1.0665)};
    @LINE(linewidth=0.24) {(0.9899, 0.0471) (-0.0471, -0.9899)};
    @LINE {(0.4714, -0.4714) (2, -2)};
    @LINE {(0.2828, 0.9899) (0.8485, 0.9899)};
    @LINE(fill="linecolor", linestyle="none") {(1.1314, 0.9899) (0.792, 1.1597) (0.792, 0.8202) (1.1314, 0.9899)};
    @LINE {(0.7071, 0.5657) (1.2728, 0.5657)};
    @LINE(fill="linecolor", linestyle="none") {(1.5556, 0.5657) (1.2162, 0.7354) (1.2162, 0.396) (1.5556, 0.5657)};
    ? @TEXT("${name}", key="name") => @PLACE(1.4, 1.15);
    ? @TEXT("", key="model") => @PLACE(-1.6, -0.85);
  };

  /* ---------------------------------------------------------------- MOS and bipolar transistors */

  /* A 45-degree three-pin NMOS transistor. Terminals: d g s. */
  $NMOS_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %d = (-2, 2) @PIN(terminal="d", direction="up");
    %g = (-2, -2) @PIN(terminal="g", direction="left");
    %s = (2, -2) @PIN(terminal="s", direction="down");
    @LINE {(-1.5006, -0.5139) (-0.4933, 0.4933) (-2, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.22, -0.8633) (-0.8633, -2.22) (-0.6578, -2.0144) (-2.0144, -0.6578) (-2.22, -0.8633)};
    @LINE(fill="linecolor", linestyle="none") {(-2.0556, -0.2878) (-0.2878, -2.0556) (-0.0822, -1.85) (-1.85, -0.0822) (-2.0556, -0.2878)};
    @LINE {(-1.4389, -1.4389) (-2, -2)};
    @LINE {(-0.5755, -1.5622) (0.4933, -0.4933) (2, -2)};
    @LINE(fill="linecolor", linestyle="none") {(0.5344, -0.4523) (-0.4111, -0.8222) (0.1645, -1.3978) (0.5344, -0.4523)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 0.8);
    ? @TEXT("", key="model") => @PLACE(0.9, -0.5);
  };

  /* A 45-degree four-pin NMOS transistor, bulk at (0, 0). Terminals: d g s b. */
  $NMOS_4TERM_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %d = (-2, 2) @PIN(terminal="d", direction="up");
    %g = (-2, -2) @PIN(terminal="g", direction="left");
    %s = (2, -2) @PIN(terminal="s", direction="down");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-1.5006, -0.5139) (-0.4933, 0.4933) (-2, 2)};
    @LINE {(-0.5139, -1.5006) (0.4933, -0.4933) (2, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.22, -0.8633) (-0.8633, -2.22) (-0.6578, -2.0144) (-2.0144, -0.6578) (-2.22, -0.8633)};
    @LINE(fill="linecolor", linestyle="none") {(-2.0556, -0.2878) (-0.2878, -2.0556) (-0.0822, -1.85) (-1.85, -0.0822) (-2.0556, -0.2878)};
    @LINE {(-1.4389, -1.4389) (-2, -2)};
    @LINE {(-0.5139, -0.5139) (0, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-0.9661, -0.9661) (-0.7606, -0.2673) (-0.2673, -0.7606) (-0.9661, -0.9661)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 0.8);
    ? @TEXT("", key="model") => @PLACE(0.9, -0.5);
  };

  /* A 45-degree three-pin PMOS transistor. Terminals: d g s. */
  $PMOS_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %d = (2, -2) @PIN(terminal="d", direction="down");
    %g = (-2, -2) @PIN(terminal="g", direction="left");
    %s = (-2, 2) @PIN(terminal="s", direction="up");
    @LINE {(-0.5139, -1.5006) (0.4933, -0.4933) (2, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.22, -0.8633) (-0.8633, -2.22) (-0.6578, -2.0144) (-2.0144, -0.6578) (-2.22, -0.8633)};
    @LINE(fill="linecolor", linestyle="none") {(-2.0556, -0.2878) (-0.2878, -2.0556) (-0.0822, -1.85) (-1.85, -0.0822) (-2.0556, -0.2878)};
    @LINE {(-1.4389, -1.4389) (-2, -2)};
    @LINE {(-0.8119, 0.1953) (-0.5036, 0.5036) (-2, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.4697, -0.4625) (-1.0997, 0.4831) (-0.5241, -0.0925) (-1.4697, -0.4625)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 0.8);
    ? @TEXT("", key="model") => @PLACE(0.9, -0.5);
  };

  /* A 45-degree four-pin PMOS transistor, bulk at (0, 0). Terminals: d g s b. */
  $PMOS_4TERM_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %d = (2, -2) @PIN(terminal="d", direction="down");
    %g = (-2, -2) @PIN(terminal="g", direction="left");
    %s = (-2, 2) @PIN(terminal="s", direction="up");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-0.5139, -1.5006) (0.4933, -0.4933) (2, -2)};
    @LINE {(-1.5006, -0.5139) (-0.4933, 0.4933) (-2, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.22, -0.8633) (-0.8633, -2.22) (-0.6578, -2.0144) (-2.0144, -0.6578) (-2.22, -0.8633)};
    @LINE(fill="linecolor", linestyle="none") {(-2.0556, -0.2878) (-0.2878, -2.0556) (-0.0822, -1.85) (-1.85, -0.0822) (-2.0556, -0.2878)};
    @LINE {(-1.4389, -1.4389) (-2, -2)};
    @LINE {(-1.0689, -1.0689) (-0.4522, -0.4522)};
    @LINE(fill="linecolor", linestyle="none") {(0, 0) (-0.6988, -0.2056) (-0.2056, -0.6988) (0, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 0.8);
    ? @TEXT("", key="model") => @PLACE(0.9, -0.5);
  };

  /* A 45-degree NPN bipolar transistor. Terminals: c b e. */
  $NPN_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %c = (-2, 2) @PIN(terminal="c", direction="up");
    %b = (-2, -2) @PIN(terminal="b", direction="left");
    %e = (2, -2) @PIN(terminal="e", direction="down");
    @LINE {(-2, -2) (-1.1928, -1.1928)};
    @LINE(linewidth=0.24) {(-2.1365, -0.2491) (-0.2502, -2.1354)};
    @LINE {(-1.6455, -0.7401) (-0.9461, 0.9461) (-2, 2)};
    @LINE {(-0.74, -1.6456) (0.2162, -1.2488)};
    @LINE {(0.8524, -0.9848) (0.946, -0.946) (2, -2)};
    @LINE(fill="linecolor", linestyle="none") {(0.0111, -0.9494) (0.2422, -1.6498) (0.946, -0.946) (0.0111, -0.9494)};
    ? @TEXT("${name}", key="name") => @PLACE(0.4, 0.8);
    ? @TEXT("", key="model") => @PLACE(0.8, -0.5);
  };

  /* A 45-degree PNP bipolar transistor. Terminals: c b e. */
  $PNP_45 = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    %c = (2, -2) @PIN(terminal="c", direction="down");
    %b = (-2, -2) @PIN(terminal="b", direction="left");
    %e = (-2, 2) @PIN(terminal="e", direction="up");
    @LINE {(-2, -2) (-1.1928, -1.1928)};
    @LINE(linewidth=0.24) {(-2.1357, -0.25) (-0.2494, -2.1362)};
    @LINE {(-1.2918, 0.0791) (-0.9461, 0.9461) (-2, 2)};
    @LINE {(-0.7401, -1.6455) (0.946, -0.946) (2, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.642, 0.1947) (-0.9417, -0.0363) (-1.6455, -0.7401) (-1.642, 0.1947)};
    ? @TEXT("${name}", key="name") => @PLACE(0.4, 0.8);
    ? @TEXT("", key="model") => @PLACE(0.8, -0.5);
  };

  /* ---------------------------------------------------------------- 45-degree arrow marks */

  /* A filled arrow head pointing -45 degrees (down-right, matching p->n / a->k at R0), turning to all four diagonals under R0/R90/R180/R270. */
  $ARROW_45_SYMBOL = @DEFINE-SYMBOL(box=[-0.9, -0.9, 0.9, 0.9]) {
    @LINE(fill="linecolor", linestyle="none") {(0.5858, -0.5858) (-0.3063, 0.8654) (-0.8654, 0.3063) (0.5858, -0.5858)};
  };

  /* A 45-degree arrow head drawn on a point in a symbol or on a 45-degree wire in the scene. */
  $ARROW_45 = @DEFINE(roles=[["at", "point"]]) {
    {? ?at} @ALIGN("x");
    {? ?at} @ALIGN("y");
  };
  # @SELECT-USAGE(recursive=true) $ARROW_45 => @SET-SYMBOL $ARROW_45_SYMBOL;

  /* A 45-degree current arrow on a terminal or a point along a 45-degree branch. */
  $CURRENT_ARROW_45 = @DEFINE(roles=[["p", ["terminal", "point"]]]) {
    {? ?p} @ALIGN("x");
    {? ?p} @ALIGN("y");
  };
  # @SELECT-USAGE(recursive=true) $CURRENT_ARROW_45 => @SET-SYMBOL $ARROW_45_SYMBOL;
}

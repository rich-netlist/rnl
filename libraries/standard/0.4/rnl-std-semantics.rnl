        => @SELECT-PIN(terminal="s")
        => @ORIENT("down", priority="low");
    {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="pmos")
        => @SELECT-PIN(terminal="s")
        => @ORIENT("up", priority="low");
    {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="njf")
        => @SELECT-PIN(terminal="s")
        => @ORIENT("down", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="nmf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low");
    {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="pjf")
        => @SELECT-PIN(terminal="s")
        => @ORIENT("up", priority="low"); {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="pmf") => @SELECT-PIN(terminal="s") => @ORIENT("up", priority="low");
    {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="npn")
        => @SELECT-PIN(terminal="e")
        => @ORIENT("down", priority="low");
    {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="pnp")
        => @SELECT-PIN(terminal="e")
        => @ORIENT("up", priority="low");
    {?left ?right ?tailleft ?tailright} @SELECT-INSTANCE(type="lpnp")
        => @SELECT-PIN(terminal="e")
        => @ORIENT("up", priority="low");
    /* the gates or bases face outwards: to the left on the left, to the right on the right */
    ?left @SELECT-PIN(terminal="g") => @ORIENT("left", priority="low");
    ?right @SELECT-PIN(terminal="g") => @ORIENT("right", priority="low");
    ?left @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="b") => @ORIENT("left", priority="low");
    ?right @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="b") => @ORIENT("right", priority="low");
    ?left @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="b") => @ORIENT("left", priority="low");
    ?right @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="b") => @ORIENT("right", priority="low");
    ?left @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="b") => @ORIENT("left", priority="low");
    ?right @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="b") => @ORIENT("right", priority="low");
  };

  /* A differential pair of n-type transistors degenerated by an element under each input, a T, with its tail below.
     Places and routes; a group: matched inputs mirrored above matched degeneration elements with tail
     centered below them, sources or emitters pointing down and gates or bases facing outwards; asserts n-type and matched inputs, matched degeneration elements, series degeneration branches and star connection at the tail node. */
  $DEGENERATED_DIFFERENTIAL_PAIR_TYPE_T_N = @DEFINE(
      roles=[
        ["left", "instance"],
        ["right", "instance"],
        ["degleft", ["instance", "usage"]],
        ["degright", ["instance", "usage"]],
        ["tail", ["instance", "usage"]]]) {
    {?left ?right} @AS $MATCHED;
    {?degleft ?degright} @AS $MATCHED;
    {?left ?degleft} @AS $SERIES;
    {?right ?degright} @AS $SERIES;
    ?left ?right @ORIENT-RELATION("MY", priority="low");
    {?left ?right ?} @ALIGN("y", priority="low");
    {?left ? ?right} @DISTRIBUTE("left-to-right", priority="low");

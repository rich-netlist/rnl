    {?degleft ?degright ?tail} @ASSERT-TOPOLOGY("star", exclude=[["nmos", "g"], ["nmos", "b"],
            ["pmos", "g"], ["pmos", "b"], ["npn", "b"], ["npn", "s"], ["pnp", "b"], ["pnp", "s"],
            ["lpnp", "b"], ["lpnp", "s"], ["njf", "g"], ["pjf", "g"], ["nmf", "g"], ["pmf", "g"]],
            message="the degleft, degright and tail of a $DEGENERATED_DIFFERENTIAL_PAIR_TYPE_T_N meet at one net");
    {?left ?right ?tail} @SELECT-INSTANCE(type="nmos")
        => @SELECT-PIN(terminal="s")
        => @ORIENT("down", priority="low");
    {?left ?right ?tail} @SELECT-INSTANCE(type="pmos")
        => @SELECT-PIN(terminal="s")
        => @ORIENT("down", priority="low");
    {?left ?right ?tail} @SELECT-INSTANCE(type="njf")
        => @SELECT-PIN(terminal="s")
        => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="nmf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low");
    {?left ?right ?tail} @SELECT-INSTANCE(type="pjf")
        => @SELECT-PIN(terminal="s")
        => @ORIENT("down", priority="low"); {?left ?right ?tail} @SELECT-INSTANCE(type="pmf") => @SELECT-PIN(terminal="s") => @ORIENT("down", priority="low");
    {?left ?right ?tail} @SELECT-INSTANCE(type="npn")
        => @SELECT-PIN(terminal="e")
        => @ORIENT("down", priority="low");
    {?left ?right ?tail} @SELECT-INSTANCE(type="pnp")
        => @SELECT-PIN(terminal="e")
        => @ORIENT("down", priority="low");
    {?left ?right ?tail} @SELECT-INSTANCE(type="lpnp")
        => @SELECT-PIN(terminal="e")
        => @ORIENT("down", priority="low");
    /* the gates or bases face outwards: to the left on the left, to the right on the right */
    ?left @SELECT-PIN(terminal="g") => @ORIENT("left", priority="low");
    ?right @SELECT-PIN(terminal="g") => @ORIENT("right", priority="low");
    ?left @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="b") => @ORIENT("left", priority="low");
    ?right @SELECT-INSTANCE(type="npn") => @SELECT-PIN(terminal="b") => @ORIENT("right", priority="low");
    ?left @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="b") => @ORIENT("left", priority="low");
    ?right @SELECT-INSTANCE(type="pnp") => @SELECT-PIN(terminal="b") => @ORIENT("right", priority="low");
    ?left @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="b") => @ORIENT("left", priority="low");
    ?right @SELECT-INSTANCE(type="lpnp") => @SELECT-PIN(terminal="b") => @ORIENT("right", priority="low");
    %n_type_set = {?left ?right} @SELECT-INSTANCE(type="nmos");
    {?left ?right} @SELECT-INSTANCE(type="npn") => @ADD-TO %n_type_set;
    {?left ?right} @SELECT-INSTANCE(type="njf") => @ADD-TO %n_type_set;
    {?left ?right} @SELECT-INSTANCE(type="nmf") => @ADD-TO %n_type_set;
    {?left ?right} @SELECT-INSTANCE(type="*")
        => @ASSERT-IN(message="the two inputs of a $DEGENERATED_DIFFERENTIAL_PAIR_TYPE_T_N are n-type: NMOS, NPN, or an n-channel JFET or MESFET") %n_type_set;
  };

  /* A differential pair of p-type transistors degenerated by an element over each input, an inverted T, with its tail above.
     Places and routes; a group: matched inputs mirrored below matched degeneration elements with tail
     centered above them, sources or emitters pointing up and gates or bases facing outwards; asserts p-type and matched inputs, matched degeneration elements, series degeneration branches and star connection at the tail node. */
  $DEGENERATED_DIFFERENTIAL_PAIR_TYPE_T_P = @DEFINE(
      roles=[
        ["left", "instance"],
        ["right", "instance"],
        ["degleft", ["instance", "usage"]],
        ["degright", ["instance", "usage"]],
        ["tail", ["instance", "usage"]]]) {
    {?left ?right} @AS $MATCHED;
    {?degleft ?degright} @AS $MATCHED;
    {?left ?degleft} @AS $SERIES;
    {?right ?degright} @AS $SERIES;

    @LINE {(-3, 0) (-1.6869, 0)};
    @LINE(linewidth=0.24) {(-1.6869, 1.3334) (-1.6869, -1.3342)};
    @LINE {(-0.8575, 0.9694) (0, 1.338) (0, 2)};
    @LINE {(-1.6869, -0.6402) (0, -1.3378) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.0234, 1.2987) (-0.6916, 0.6402) (-1.6869, 0.6402) (-1.0234, 1.2987)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75)
  }
}

/* rnl-std-semiconductors, drawn by hand: the JFET, which Analog Canvas does not have. Terminals
   d g s (SPICE order); laid out like Analog Canvas's MOS and BJT, gate on the left, with the
   MOS channel bar: the N type has its drain up, and the P type, as $PMOS and $PNP, its source up and
   its drain down. J draws by the model type njf or pjf; Z (ngspice's MESFET) by nmf or pmf.
   The lines start inside the bar, as Analog Canvas's MOS lines do, so that no cap sticks out. */
@RNL {
  %JFET_CHANNEL = @DEFINE-SYMBOL {
    @LINE(fill="linecolor", linestyle="none") {(-1.657, -1.25) (-1.657, 1.25) (-1.366, 1.25) (-1.366, -1.25) (-1.657, -1.25)};
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE {(-3, 0) (-1.5116, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75)
  };
  /* An N-channel JFET. The arrow on the gate points at the channel */
  $NJFET = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    %JFET_CHANNEL;
    @LINE(fill="linecolor", linestyle="none") {(-1.66, 0) (-2.3, 0.35) (-2.3, -0.35) (-1.66, 0)}
  };
  /* A P-channel JFET. The arrow on the gate points away from the channel; the source is up and the drain down, as in $PMOS */
  $PJFET = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    %JFET_CHANNEL;
    @LINE(fill="linecolor", linestyle="none") {(-2.4, 0) (-1.76, 0.35) (-1.76, -0.35) (-2.4, 0)}
  }
}

/* rnl-std-semiconductors 0.4, a package of the standard series 0.4 (16.3).
   The symbols of diodes and MOS, bipolar and JFET transistors.
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. The pins are named with
   the standard terminal names of SPICE, in SPICE's order (a k, d g s b, c b e, d g s), and bind the
   terminal of that name (6.12, 11.3), so #M1::d is the pin of #M1:d. The model label of each symbol
   is empty by default; a file shows it with # @SELECT-INSTANCE => @TEXT("${model}", key="model"). */
@RNL(type="header") {
  @VERSION("0.4");
  @PACKAGE(name="rnl-std-semiconductors", version="0.4");
}

@RNL {
  /* ---------------------------------------------------------------- diodes */

  /* A diode. Terminals: a k. */
  $DIODE = @DEFINE-SYMBOL(box=[-2, -1, 2, 1]) {
    %a = (-2, 0) @PIN(terminal="a", direction="left");
    %k = (2, 0) @PIN(terminal="k", direction="right");
    @LINE {(-2, 0) (-0.8333, 0)};
    @LINE {(-0.8333, 0.675) (-0.8333, -0.675) (0.5833, 0) (-0.8333, 0.675)};
    @LINE(linewidth=0.24) {(0.6667, 0.7333) (0.6667, -0.7333)};
    @LINE {(0.6667, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.1);
    ? @TEXT("", key="model", halign="middle", valign="top") => @PLACE(0, -1.1);
  };

  /* A Zener diode. Terminals: a k. */
  $ZENER_DIODE = @DEFINE-SYMBOL(box=[-2, -1, 2, 1]) {
    %a = (-2, 0) @PIN(terminal="a", direction="left");
    %k = (2, 0) @PIN(terminal="k", direction="right");
    @LINE {(-2, 0) (-0.7803, 0)};
    @LINE {(-0.7803, 0.6404) (-0.7803, -0.6404) (0.6606, 0) (-0.7803, 0.6404)};
    @LINE(linewidth=0.24) {(-0.0639, 0.8507) (0.6667, 0.8406) (0.6667, -0.8205) (1.387, -0.8205)};
    @LINE {(0.6667, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.2);
    ? @TEXT("", key="model", halign="middle", valign="top") => @PLACE(0, -1.2);
  };

  /* ---------------------------------------------------------------- MOS transistors */

  /* An NMOS transistor of three pins, its bulk not drawn. Terminals: d g s. */
  $NMOS = @DEFINE-SYMBOL(box=[-3, -2, 1.4, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.5116, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(0.0581, -0.6977) (-0.8721, -0.2907) (-0.8721, -1.1047) (0.0581, -0.6977)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* An NMOS transistor with its bulk pin aligned to drain and source and its bulk arrow at the channel. Terminals: d g s b. */
  $NMOS_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 0, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-0.7268, 0) (0, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3663, 0) (-0.7268, 0.3488) (-0.7268, -0.3488) (-1.3663, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A PMOS transistor of three pins, its bulk not drawn. Terminals: d g s. */
  $PMOS = @DEFINE-SYMBOL(box=[-3, -2, 1.4, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-0.436, 0.7122) (0, 0.7122) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3663, 0.7122) (-0.436, 1.1192) (-0.436, 0.3052) (-1.3663, 0.7122)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A PMOS transistor with its bulk pin aligned to drain and source. Terminals: d g s b. */
  $PMOS_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 0, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.5116, 0) (-0.6395, 0)};
    @LINE(fill="linecolor", linestyle="none") {(0, 0) (-0.6395, 0.3488) (-0.6395, -0.3488) (0, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A three-pin logic NMOS transistor without a source arrow. Terminals: d g s. */
  $NMOS_LOGIC = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A three-pin logic PMOS transistor without a source arrow, with an inversion bubble on its gate. Terminals: d g s. */
  $PMOS_LOGIC = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    (-2.48, 0) @CIRCLE(radius=0.28);
    @LINE {(-3, 0) (-2.76, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A depletion-mode NMOS transistor of three pins, its bulk not drawn. Terminals: d g s. */
  $DEPLETION_NMOS = @DEFINE-SYMBOL(box=[-3, -2, 1.4, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.0368, 0.6977) (-1.0368, -0.6977)};
    @LINE {(-1.5116, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(0.0581, -0.6977) (-0.8721, -0.2907) (-0.8721, -1.1047) (0.0581, -0.6977)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A depletion-mode NMOS transistor with its bulk pin aligned to drain and source. Terminals: d g s b. */
  $DEPLETION_NMOS_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 0, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-0.7268, 0) (0, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3663, 0) (-0.7268, 0.3488) (-0.7268, -0.3488) (-1.3663, 0)};
    @LINE {(-1.0368, 0.6977) (-1.0368, -0.6977)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A depletion-mode PMOS transistor of three pins, its bulk not drawn. Terminals: d g s. */
  $DEPLETION_PMOS = @DEFINE-SYMBOL(box=[-3, -2, 1.4, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.0368, 0.7777) (-1.0368, -0.6977)};
    @LINE {(-0.436, 0.7122) (0, 0.7122) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3663, 0.7122) (-0.436, 1.1192) (-0.436, 0.3052) (-1.3663, 0.7122)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A depletion-mode PMOS transistor with its bulk pin aligned to drain and source. Terminals: d g s b. */
  $DEPLETION_PMOS_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 0, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.5116, 0) (-0.6395, 0)};
    @LINE(fill="linecolor", linestyle="none") {(0, 0) (-0.6395, 0.3488) (-0.6395, -0.3488) (0, 0)};
    @LINE {(-1.0368, 0.6977) (-1.0368, -0.6977)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* An N-type DMOS transistor of three pins, its bulk not drawn. Terminals: d g s. */
  $NDMOS = @DEFINE-SYMBOL(box=[-3, -2, 1.4, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.4244, 0.2977) (0, 0.2977) (0, 0.6977)};
    @LINE {(-1.5116, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(0.0581, -0.6977) (-0.8721, -0.2907) (-0.8721, -1.1047) (0.0581, -0.6977)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* An N-type DMOS transistor with its bulk pin aligned to drain and source. Terminals: d g s b. */
  $NDMOS_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 0, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-1.4244, 0.85) (0, 0.85) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-0.7268, 0) (0, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3663, 0) (-0.7268, 0.3488) (-0.7268, -0.3488) (-1.3663, 0)};
    @LINE {(-1.4244, 0.5) (0, 0.5) (0, 0.85)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A P-type DMOS transistor of three pins, its bulk not drawn. Terminals: d g s. */
  $PDMOS = @DEFINE-SYMBOL(box=[-3, -2, 1.4, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.4244, -0.2977) (0, -0.2977) (0, -0.6977)};
    @LINE {(-0.436, 0.7122) (0, 0.7122) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.3663, 0.7122) (-0.436, 1.1192) (-0.436, 0.3052) (-1.3663, 0.7122)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A P-type DMOS transistor with its bulk pin aligned to drain and source. Terminals: d g s b. */
  $PDMOS_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 0, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    %b = (0, 0) @PIN(terminal="b", direction="right");
    @LINE {(-1.4244, -0.85) (0, -0.85) (0, -2)};
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.5116, 0) (-0.6395, 0)};
    @LINE(fill="linecolor", linestyle="none") {(0, 0) (-0.6395, 0.3488) (-0.6395, -0.3488) (0, 0)};
    @LINE {(-1.4244, -0.5) (0, -0.5) (0, -0.85)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* ---------------------------------------------------------------- bipolar and JFET transistors */

  /* An NPN bipolar transistor, its substrate not drawn. Terminals: c b e. */
  $NPN = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %c = (0, 2) @PIN(terminal="c", direction="up");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %e = (0, -2) @PIN(terminal="e", direction="down");
    @LINE {(-3, 0) (-1.6869, 0)};
    @LINE(linewidth=0.24) {(-1.6869, 1.3346) (-1.6869, -1.333)};
    @LINE {(-1.6869, 0.6402) (0, 1.338) (0, 2)};
    @LINE {(-1.6869, -0.6404) (-0.7301, -1.0359)};
    @LINE {(-0.0936, -1.2991) (0, -1.3378) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-0.6635, -0.6792) (-0.9953, -1.3378) (0, -1.3378) (-0.6635, -0.6792)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* A PNP bipolar transistor, its substrate not drawn. Terminals: c b e. */
  $PNP = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %c = (0, -2) @PIN(terminal="c", direction="down");
    %b = (-3, 0) @PIN(terminal="b", direction="left");
    %e = (0, 2) @PIN(terminal="e", direction="up");
    @LINE {(-3, 0) (-1.6869, 0)};
    @LINE(linewidth=0.24) {(-1.6869, 1.3334) (-1.6869, -1.3342)};
    @LINE {(-0.8575, 0.9694) (0, 1.338) (0, 2)};
    @LINE {(-1.6869, -0.6402) (0, -1.3378) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.0234, 1.2987) (-0.6916, 0.6402) (-1.6869, 0.6402) (-1.0234, 1.2987)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* Shared JFET channel body: bar, drain and source leads, gate lead and default labels. */
  %JFET_CHANNEL = @DEFINE-SYMBOL {
    @LINE(fill="linecolor", linestyle="none") {(-1.657, -1.25) (-1.657, 1.25) (-1.366, 1.25) (-1.366, -1.25) (-1.657, -1.25)};
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE {(-3, 0) (-1.5116, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("", key="model") => @PLACE(0.5, -1.75);
  };

  /* An N-channel JFET, its gate arrow pointing at the channel. Terminals: d g s. */
  $NJFET = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %d = (0, 2) @PIN(terminal="d", direction="up");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, -2) @PIN(terminal="s", direction="down");
    %JFET_CHANNEL;
    @LINE(fill="linecolor", linestyle="none") {(-1.66, 0) (-2.3, 0.35) (-2.3, -0.35) (-1.66, 0)};
  };

  /* A P-channel JFET, its gate arrow pointing away from the channel. Terminals: d g s. */
  $PJFET = @DEFINE-SYMBOL(box=[-3, -2, 0.8, 2]) {
    %d = (0, -2) @PIN(terminal="d", direction="down");
    %g = (-3, 0) @PIN(terminal="g", direction="left");
    %s = (0, 2) @PIN(terminal="s", direction="up");
    %JFET_CHANNEL;
    @LINE(fill="linecolor", linestyle="none") {(-2.4, 0) (-1.76, 0.35) (-1.76, -0.35) (-2.4, 0)};
  };
}

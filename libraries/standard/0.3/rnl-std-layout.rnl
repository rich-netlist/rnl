/* rnl-std-layout 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The layout definitions (14), and a rule that puts the tail of each differential pair under the
   middle of the pair, as a low default (14.8). */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="rnl-std-layout", version="0.3");
  @USE-PACKAGE(name="rnl-std-semantics", version="0.3")
}

/* ---------------------------------------------------------------- rnl-std-layout: layout intents (14) */
@RNL {
  $MIRROR_PAIR = @DEFINE(roles=["a", "b", "axis"]) {
    {?a ?b} @ALIGN("y");
    {?a ?axis ?b} @DISTRIBUTE("x");
    ?a ?b @ORIENT-RELATION("MY")
  };
  $FLOW = @DEFINE(roles=["{path}"], parameters=[["direction", "left-to-right"]]) {
    ?path @ORDER(?direction, priority="low")
  };
  /* the tail of each differential pair under the middle of the pair (9.5): the tails, a set counted by
     its centre, distributed between the pair, which holds by itself when the pair has no tail (14.1,
     14.4); low, a default that gives way first (14.8) */
  %TAIL_CENTER = @DEFINE(roles=[["pair", "usage"]]) {
    {?pair::in_p {?pair::tail} ?pair::in_n} @DISTRIBUTE("x")
  };
  # @SELECT-USAGE $DIFFERENTIAL_PAIR => @AS(priority="low") %TAIL_CENTER
}

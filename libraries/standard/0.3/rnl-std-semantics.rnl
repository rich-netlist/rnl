   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The semantic definitions (15.1): roles only. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="rnl-std-semantics", version="0.3")}

/* ---------------------------------------------------------------- rnl-std-semantics: roles only (15.1) */
@RNL {
  $DIFFERENTIAL_PAIR = @DEFINE(roles=[["in_p", "instance"], ["in_n", "instance"]]) {};
  $DIFFERENTIAL_PAIR_WITH_TAIL = @DEFINE(roles=[["in_p", "instance"], ["in_n", "instance"], ["tail", "instance"]]) {};
  $CURRENT_MIRROR = @DEFINE(roles=[["ref", "instance"], ["out", "instance"]]) {};
  $INPUT_STAGE = @DEFINE(roles=[["pair", "usage"], ["tail", "instance"]]) {};
  $MATCHED = @DEFINE(roles=["{members}"]) {};
  $BRANCH = @DEFINE(roles=["{members}"]) {};
  $CHAIN = @DEFINE(roles=["source", "{series}", "load"]) {};
  $CASCADE = @DEFINE(roles=["first", "second", "feedback", "load"]) {};
  $SUPPLY_HIGH = @DEFINE(roles=[["pin", "terminal"]]) {};
  $SUPPLY_LOW = @DEFINE(roles=[["pin", "terminal"]]) {}
}

/* rnl-std-core 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The smallest collection of the series (16.3): it references rnl-std-style, rnl-std-basic,
   rnl-std-semiconductors and the rule packages of the two dialects, rnl-std-spice and
   rnl-std-spectre, and has no content of its own. It draws the netlist and adds nothing. A file
   of the language 0.3 uses the rule package of its own dialect only (16.3). */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="rnl-std-core", version="0.3");
  @USE-PACKAGE(name="rnl-std-style", version="0.3");
  @USE-PACKAGE(name="rnl-std-basic", version="0.3");
  @USE-PACKAGE(name="rnl-std-semiconductors", version="0.3");
  @USE-PACKAGE(name="rnl-std-spice", version="0.3");
  @USE-PACKAGE(name="rnl-std-spectre", version="0.3")
}

/* rnl-std-basic 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The symbols of passive parts, sources, switches and transmission lines, of the virtual parts
   and the marks; the definitions of the virtual parts and of the parts that are only drawn, the
   stubs of ground and supply, and the rules that draw their usages.
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. Pins bind by terminal
   number, so a symbol fits any dialect. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="rnl-std-basic", version="0.3")}

/* ---------------------------------------------------------------- rnl-std-basic: symbols (9.2) drawn from Analog Canvas */
@RNL {
  /* p n; from Analog Canvas resistor */
  $RESISTOR = @DEFINE-SYMBOL(box=[-1, -2.4, 1, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.95, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(0.95, -0.95)
  };

  /* p n; from Analog Canvas variable-resistor */
  $VARIABLE_RESISTOR = @DEFINE-SYMBOL(box=[-1.6, -2.4, 1.6, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -0.95)
  };

  /* p n; from Analog Canvas capacitor */
  $CAPACITOR = @DEFINE-SYMBOL(box=[-1.2, -2.4, 1.2, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.2, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.2, -0.95)
  };

  /* p n; from Analog Canvas variable-capacitor */
  $VARIABLE_CAPACITOR = @DEFINE-SYMBOL(box=[-1.6, -2.4, 1.6, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -0.95)
  };

  /* p n; from Analog Canvas inductor-compact */
  $INDUCTOR = @DEFINE-SYMBOL(box=[-1, -2.4, 1, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 2) (0, 1.2)};
    @ARC(cap="round") {(0, 1.2) (0.2121, 1.1121) (0.3, 0.9)};
    @ARC {(0.3, 0.9) (0.2121, 0.6879) (0, 0.6)};
    @ARC {(0, 0.6) (0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0, -0.6)};
    @ARC {(0, -0.6) (0.2121, -0.6879) (0.3, -0.9)};
    @ARC(cap="round") {(0.3, -0.9) (0.2121, -1.1121) (0, -1.2)};
    @LINE {(0, -1.2) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(0.7, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(0.7, -0.95)
  };

  /* p n; from Analog Canvas variable-inductor */
  $VARIABLE_INDUCTOR = @DEFINE-SYMBOL(box=[-1.6, -2.4, 1.6, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 2) (0, 1.2)};
    @ARC(cap="round") {(0, 1.2) (0.2121, 1.1121) (0.3, 0.9)};
    @ARC {(0.3, 0.9) (0.2121, 0.6879) (0, 0.6)};
    @ARC {(0, 0.6) (0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0, -0.6)};
    @ARC {(0, -0.6) (0.2121, -0.6879) (0.3, -0.9)};
    @ARC(cap="round") {(0.3, -0.9) (0.2121, -1.1121) (0, -1.2)};
    @LINE {(0, -1.2) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.6, -0.95)
  };

  /* p_plus p_minus s_plus s_minus; from Analog Canvas xfmr */
  $TRANSFORMER = @DEFINE-SYMBOL(box=[-2.4, -2.4, 2.4, 2.4]) {
    (-2, 1) @PIN(terminal=2, direction="left");
    (2, 1) @PIN(terminal=1, direction="right");
    (-2, -1) @PIN(terminal=4, direction="left");
    (2, -1) @PIN(terminal=3, direction="right");
    @LINE {(-2, 1) (-1.2, 1)};
    @ARC(cap="round") {(-1.2, 1) (-1.1121, 0.7879) (-0.9, 0.7)};
    @ARC {(-0.9, 0.7) (-0.6879, 0.7879) (-0.6, 1)};
    @ARC {(-0.6, 1) (-0.3, 0.7) (0, 1)};
    @ARC {(0, 1) (0.3, 0.7) (0.6, 1)};
    @ARC {(0.6, 1) (0.6879, 0.7879) (0.9, 0.7)};
    @ARC(cap="round") {(0.9, 0.7) (1.1121, 0.7879) (1.2, 1)};
    @LINE {(1.2, 1) (2, 1)};
    @LINE {(-2, -1) (-1.2, -1)};
    @ARC(cap="round") {(-1.2, -1) (-1.1121, -0.7879) (-0.9, -0.7)};
    @ARC {(-0.9, -0.7) (-0.6879, -0.7879) (-0.6, -1)};
    @ARC {(-0.6, -1) (-0.3, -0.7) (0, -1)};
    @ARC {(0, -1) (0.3, -0.7) (0.6, -1)};
    @ARC {(0.6, -1) (0.6879, -0.7879) (0.9, -0.7)};
    @ARC(cap="round") {(0.9, -0.7) (1.1121, -0.7879) (1.2, -1)};
    @LINE {(1.2, -1) (2, -1)};
    (1.6, 1.45) @CIRCLE(radius=0.229, fill="linecolor", linestyle="none");
    (1.6, -1.45) @CIRCLE(radius=0.229, fill="linecolor", linestyle="none");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.05)
  };

  /* p n; from Analog Canvas voltage-source */
  $VOLTAGE_SOURCE = @DEFINE-SYMBOL(box=[-2.4, -2.4, 1.5, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* p n; from Analog Canvas current-source */
  $CURRENT_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2.4, 1.5, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=1.0756);
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.0756) (0, 2)};
    @LINE {(0, -1.0756) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* p n; from Analog Canvas battery */
  $BATTERY = @DEFINE-SYMBOL(box=[-2.4, -2.4, 2.4, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 2) (0, 0.3361)};
    @LINE {(0, -0.3361) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.5341, 0.496) (1.5367, 0.496) (1.5367, 0.1762) (-1.5341, 0.1762) (-1.5341, 0.496)};
    @LINE(fill="linecolor", linestyle="none") {(-0.7988, -0.1762) (0.8006, -0.1762) (0.8006, -0.496) (-0.7988, -0.496) (-0.7988, -0.1762)};
    @LINE {(0.7919, 1.3416) (1.5986, 1.3416)};
    @LINE {(1.1952, 1.745) (1.1952, 0.9385)};
    @LINE {(0.7919, -1.3472) (1.5986, -1.3472)};
    ? @TEXT("${name}", key="name") => @PLACE(2, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(2, -0.95)
  };

  /* p n (cp) (cn); from Analog Canvas vcvs (diamond) */
  $VCVS = @DEFINE-SYMBOL(box=[-2.4, -2.4, 1.5, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -0.95)
  };

  /* p n (cp) (cn); from Analog Canvas vccs (diamond) */
  $VCCS = @DEFINE-SYMBOL(box=[-1.5, -2.4, 1.5, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -0.95)
  };

  /* p n; from Analog Canvas cccs (diamond) */
  $CCCS = @DEFINE-SYMBOL(box=[-1.5, -2.4, 1.5, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -0.95)
  };

  /* p n; from Analog Canvas ccvs (diamond) */
  $CCVS = @DEFINE-SYMBOL(box=[-2.4, -2.4, 1.5, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(-2.0058, 1.4535) (-1.1919, 1.4535)};
    @LINE {(-1.5988, 1.8605) (-1.5988, 1.0465)};
    @LINE {(-2.0058, -1.3372) (-1.1919, -1.3372)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(0, 1.25) (0, 2)};
    @LINE {(0, -1.25) (0, -2)};
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -0.95)
  };

  /* p n (cp) (cn); from Analog Canvas ideal-switch */
  $SWITCH = @DEFINE-SYMBOL(box=[-3.4, -1.2, 3.4, 1.8]) {
    (-2, 0) @PIN(terminal=1, direction="left");
    (2, 0) @PIN(terminal=2, direction="right");
    @LINE {(-2, 0) (-1.2727, 0)};
    (-0.9524, 0.002) @CIRCLE(radius=0.3203);
    @LINE {(-0.6954, 0.2418) (0.6406, 1.2807)};
    (1.1201, 0.002) @CIRCLE(radius=0.3202);
    @LINE {(1.4403, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.65)
  };

  /* p n (cp) (cn); from Analog Canvas closed-switch */
  $CLOSED_SWITCH = @DEFINE-SYMBOL(box=[-3.4, -1.2, 3.4, 1.2]) {
    (-2, 0) @PIN(terminal=1, direction="left");
    (2, 0) @PIN(terminal=2, direction="right");
    @LINE {(-2, 0) (-1.3562, 0)};
    (-1.0363, 0) @CIRCLE(radius=0.3199);
    @LINE {(-0.7187, 0.1496) (1.3609, 0.4694)};
    (1.0363, 0) @CIRCLE(radius=0.3199);
    @LINE {(1.3562, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 0.8)
  };

  /* p n cp (cn); from Analog Canvas externally-controlled-switch */
  $EXTERNALLY_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-2.4, -2.4, 2.4, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (-2, 0) @PIN(terminal=3, direction="left");
    @LINE {(0, 2) (0, 1.2414)};
    (0, 0.9215) @CIRCLE(radius=0.3199);
    @LINE {(-0.2636, 0.6896) (-1.3529, -0.6998)};
    @LINE {(-2, 0) (-0.7428, 0)};
    (0, -1.1511) @CIRCLE(radius=0.3199);
    @LINE {(0, -1.471) (0, -2)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.85, 2.35)
  };

  /* p n cp cn; from Analog Canvas voltage-controlled-switch */
  $VOLTAGE_CONTROLLED_SWITCH = @DEFINE-SYMBOL(box=[-3.4, -3.8, 3.4, 1.7]) {
    (-2, 0) @PIN(terminal=1, direction="left");
    (2, 0) @PIN(terminal=2, direction="right");
    (-2, -3) @PIN(terminal=3, direction="left");
    (2, -3) @PIN(terminal=4, direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (-1, 0) @CIRCLE(radius=0.3);
    @LINE {(-0.7, 0.24) (0.64, 1.28)};
    (1.1, 0) @CIRCLE(radius=0.3);
    @LINE {(1.4, 0) (2, 0)};
    @LINE {(-2, -3) (-1, -3)};
    @LINE {(1, -3) (2, -3)};
    @LINE {(-1, -2.4) (1, -2.4) (1, -3.6) (-1, -3.6) (-1, -2.4)};
    @LINE {(-0.8, -3) (-0.2, -3)};
    @LINE {(-0.5, -2.7) (-0.5, -3.3)};
    @LINE {(0.2, -3) (0.8, -3)};
    @LINE {(0, -2.4) (0, -2)};
    @LINE {(0, -1.6) (0, -1.2)};
    @LINE {(0, -0.8) (0, -0.6)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.65)
  };

  /* draws $SPDT_SWITCH; com a b; from Analog Canvas spdt-switch */
  $SPDT_SWITCH_SYMBOL = @DEFINE-SYMBOL(box=[-3.4, -2, 3.4, 2]) {
    (-2, 0) @PIN(terminal=1, direction="left");
    (2, 1) @PIN(terminal=2, direction="right");
    (2, -1) @PIN(terminal=3, direction="right");
    @LINE {(-2, 0) (-1.3, 0)};
    (-1, 0) @CIRCLE(radius=0.3);
    @LINE {(-0.732, 0.134) (0.732, 0.866)};
    (1, 1) @CIRCLE(radius=0.3);
    @LINE {(1.3, 1) (2, 1)};
    (1, -1) @CIRCLE(radius=0.3);
    @LINE {(1.3, -1) (2, -1)}
  };

  /* draws $GROUND; p; from Analog Canvas ground */
  $GROUND_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, -2.7, 1.2, 0.4]) {
    (0, 0) @PIN(terminal=1, direction="up");
    @LINE {(0, 0) (0, -1)};
    @LINE(linewidth=0.2907) {(-0.6395, -1) (0.6395, -1)};
    @LINE(linewidth=0.2907) {(-0.407, -1.5814) (0.407, -1.5814)};
    @LINE(linewidth=0.2907) {(-0.2326, -2.1047) (0.2326, -2.1047)}
  };

  /* draws $SUPPLY; p; from Analog Canvas vdd-port */
  $SUPPLY_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, -0.4, 1.2, 2.2]) {
    (0, 0) @PIN(terminal=1, direction="down");
    @LINE {(0, 0) (0, 1.85)};
    @LINE(fill="linecolor", linestyle="none") {(-1, 2.088) (1, 2.088) (1, 1.764) (-1, 1.764) (-1, 2.088)};
    ? @TEXT("${p}", key="name", halign="middle", valign="bottom") => @PLACE(0, 2.4)
  };

  /* draws $IO_PORT; p; from Analog Canvas port */
  $IO_PORT_SYMBOL = @DEFINE-SYMBOL(box=[-1.4, -0.7, 0.4, 0.7]) {
    (0, 0) @PIN(terminal=1, direction="right");
    (-0.7087, 0) @CIRCLE(radius=0.2479);
    @LINE {(0, 0) (-0.4608, 0)};
    ? @TEXT("${p}", key="name", halign="end", valign="middle") => @PLACE(-1.25, 0)
  }
}

/* rnl-std-basic, drawn by hand: what Analog Canvas has no drawing for. In the manner of the drawings
   above: strokes of the style's width, 0.24 where Analog Canvas emphasizes (a capacitor plate), arcs
   rather than Bezier curves, pins on integer points, a box 0.4 outside the pins and the drawing. */
@RNL {
  /* the arrow head, drawn on a point (9.2.7); its definition is $ARROW. Analog Canvas's arrow head,
     1.657 long and 0.79 wide, centred on the point */
  $ARROW_SYMBOL = @DEFINE-SYMBOL(box=[-0.85, -0.4, 0.85, 0.4]) { @LINE(fill="linecolor", linestyle="none") {(0.8285, 0) (-0.8285, 0.3953) (-0.8285, -0.3953) (0.8285, 0)}};

  /* E and G with four terminals, p n cp cn = 1 2 3 4: rnl-std 0.2's layout, the output pins at (0, ±2)
     as in $VCVS, Analog Canvas's diamond, and control leads that reach its sides, + and − between */
  %CONTROLLED_SOURCE_BODY = @DEFINE-SYMBOL {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (-4, 1) @PIN(terminal=3, direction="left");
    (-4, -1) @PIN(terminal=4, direction="left");
    @LINE {(0, 2) (0, 1.25)};
    @LINE {(0, -1.25) (0, -2)};
    @LINE {(0, 1.25) (1.25, 0) (0, -1.25) (-1.25, 0) (0, 1.25)};
    @LINE {(-4, 1) (-3, 1) (-0.75, 0.5)};
    @LINE {(-4, -1) (-3, -1) (-0.75, -0.5)};
    (-2.5, 0.4) @TEXT("+", halign="middle", valign="middle", size=0.8);
    (-2.5, -0.4) @TEXT("−", halign="middle", valign="middle", size=0.8);
    ? @TEXT("${name}", key="name") => @PLACE(1.65, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.65, -0.95)
  };
  $VCVS_4TERM = @DEFINE-SYMBOL(box=[-4.4, -2.4, 1.65, 2.4]) {
    %CONTROLLED_SOURCE_BODY;
    @LINE {(-0.35, 0.55) (0.35, 0.55)};
    @LINE {(0, 0.2) (0, 0.9)};
    @LINE {(-0.35, -0.55) (0.35, -0.55)}
  };
  /* the arrow of Analog Canvas's VCCS */
  $VCCS_4TERM = @DEFINE-SYMBOL(box=[-4.4, -2.4, 1.65, 2.4]) {
    %CONTROLLED_SOURCE_BODY;
    @LINE {(0, 0.6977) (0, 0.2326)};
    @LINE(fill="linecolor", linestyle="none") {(0, -0.6977) (-0.4651, 0.2326) (0.4651, 0.2326) (0, -0.6977)}
  };

  /* B (Spectre's bsource), p n = 1 2. Its V= or I= makes it a voltage or a current source, and no
     selection condition sees that, so one drawing: the source body of Analog Canvas with a B */
  $BEHAVIORAL_SOURCE = @DEFINE-SYMBOL(box=[-1.5, -2.4, 1.5, 2.4]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    @LINE {(0, 2) (0, 1.0756)};
    @LINE {(0, -1.0756) (0, -2)};
    (0, 0) @CIRCLE(radius=1.0756);
    (0, 0) @TEXT("B", halign="middle", valign="middle", size=1.1);
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* Spectre's port, p n = 1 2: a source with its own resistance; the resistor is Analog Canvas's,
     at 0.8 of its size */
  $RF_PORT = @DEFINE-SYMBOL(box=[-1.5, -3.4, 1.5, 3.4]) {
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    @LINE {(0, 3) (0, 2.75) (0.43, 2.56) (-0.37, 2.38) (0.43, 2.14) (-0.4, 1.91) (0.43, 1.68) (-0.37, 1.45) (0, 1.35) (0, 1.0756)};
    @LINE {(0, -1.0756) (0, -3)};
    (0, 0) @CIRCLE(radius=1.0756);
    /* a sine of two half circles */
    @ARC {(-0.6, 0) (-0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0.6, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(1.5, 0.25);
    ? @TEXT("${value}", key="value") => @PLACE(1.5, -0.95)
  };

  /* T (lossless) and O (lossy): port 1 on the left, port 2 on the right, p1 n1 p2 n2 = 1 2 3 4.
     6.12 gives these elements no terminal names yet, so a reference writes the number (#T1:3) */
  $TRANSMISSION_LINE = @DEFINE-SYMBOL(box=[-4.4, -2.4, 4.4, 1.2]) {
    (-4, 0) @PIN(terminal=1, direction="left");
    (-2, -2) @PIN(terminal=2, direction="down");
    (4, 0) @PIN(terminal=3, direction="right");
    (2, -2) @PIN(terminal=4, direction="down");
    @LINE {(-4, 0) (-2.3, 0)};
    @LINE {(2.3, 0) (4, 0)};
    @LINE {(-2, -2) (-2, -0.8)};
    @LINE {(2, -2) (2, -0.8)};
    (-2, 0) @ELLIPSE(width=0.6, height=1.6);
    @LINE {(-2, 0.8) (2, 0.8)};
    @LINE {(-2, -0.8) (2, -0.8)};
    /* the far end: an arc through the ends of the ellipse's half */
    @ARC {(2, 0.8) (2.3, 0) (2, -0.8)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.15)
  };

  /* U, the uniform RC line: the two ends, then the node its capacitance goes to, a b ref = 1 2 3 */
  $RC_LINE = @DEFINE-SYMBOL(box=[-4.4, -2.4, 4.4, 0.8]) {
    (-4, 0) @PIN(terminal=1, direction="left");
    (4, 0) @PIN(terminal=2, direction="right");
    (0, -2) @PIN(terminal=3, direction="down");
    @LINE {(-4, 0) (-2, 0) (-1.667, 0.4) (-1, -0.4) (-0.333, 0.4) (0.333, -0.4) (1, 0.4) (1.667, -0.4) (2, 0) (4, 0)};
    @LINE(linewidth=0.24) {(-2, -0.9) (2, -0.9)};
    @LINE {(0, -0.9) (0, -2)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 0.75)
  };

  /* marks: the cross of no connection (12.6), as in rnl-std 0.2; the dot of a junction and the arrow
     of a current (13.2, 15.2) as Analog Canvas draws them: a dot 0.378 in radius, and the arrow's head
     alone, on the wire, which is its shaft */
  $NO_CONNECT_SYMBOL = @DEFINE-SYMBOL(box=[-0.5, -0.5, 0.5, 0.5]) {
    @LINE {(-0.5, -0.5) (0.5, 0.5)};
    @LINE {(-0.5, 0.5) (0.5, -0.5)}
  };
  $JUNCTION_SYMBOL = @DEFINE-SYMBOL(box=[-0.4, -0.4, 0.4, 0.4]) {(0, 0) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none")};
  /* points right; ORIENT("R270") points down (15.2) */
  $CURRENT_ARROW_SYMBOL = @DEFINE-SYMBOL(box=[-0.85, -0.4, 0.85, 0.4]) { @LINE(fill="linecolor", linestyle="none") {(0.8285, 0) (-0.8285, 0.3953) (-0.8285, -0.3953) (0.8285, 0)}};

  /* a ground with the name of its net under it, for a ground net other than 0, such as vss, whose
     name no port tag shows; rnl-std-fill gives it to the grounds of those nets */
  $NAMED_GROUND_SYMBOL = @DEFINE-SYMBOL(box=[-1.2, -2.7, 1.2, 0.4]) {
    $GROUND_SYMBOL;
    ? @TEXT("${p}", key="name", halign="middle", valign="top") => @PLACE(0, -2.5)
  }
}

/* rnl-std-basic: definitions (9.4, 12) and the rules that draw their usages */
@RNL {
  /* virtual elements (12.5, 12.6, 13.2, 15.2). Their role is p (net is a standard subobject name, 9.4);
     ${p} shows the net, or the net of the terminal when drawn on a pin (13.6, PR1). */
  $GROUND = @DEFINE(roles=[["p", ["net", "terminal"]]]) {};
  $SUPPLY = @DEFINE(roles=[["p", ["net", "terminal"]]]) {};
  $IO_PORT = @DEFINE(roles=[["p", ["net", "terminal"]]]) {};
  $NO_CONNECT = @DEFINE(roles=[["t", "terminal"]]) {};
  $JUNCTION = @DEFINE(roles=[["p", ["point", "terminal"]]]) {};
  $CURRENT_ARROW = @DEFINE(roles=[["p", ["terminal", "point"]]]) {};
  /* an arrow head on a point, in a symbol or in the scene (9.2.7) */
  $ARROW = @DEFINE(roles=[["p", "point"]]) {};

  /* a part that is only drawn and has no netlist line: a usage on a point (9.2.7, 13.4). A wire of
     a real net that ends on one of its pins ends at that point's coordinates. */
  $SPDT_SWITCH = @DEFINE(roles=[["p", "point"]]) {};
  /* any symbol drawn as a figure on a point, with no netlist line: each usage writes its own
     SET-SYMBOL; there is no default. Its pins have no terminals, as $SPDT_SWITCH's */
  $FIGURE = @DEFINE(roles=[["p", "point"]]) {};

  /* ground and supply with their own wire, at least gap below or above a pin, pointing away from it;
     rnl-std-fill attaches them. Only the least distance is given, so that a solver may draw a stub
     longer, as when it lines up the grounds of parts of different lengths; the constraints are low,
     a default that gives way first (14.8) */
  $GROUND_STUB = @DEFINE(roles=[["t", "terminal"]], parameters=[["gap", 2]]) {
    %g = $GROUND @ATTACH ?t::net;
    ?t::net @WIRE {?t %g:p};
    {?t %g:p} @ALIGN("x", priority="low");
    %g:p ?t @DISTANCE("bottom-to-top", min=?gap, priority="low");
    %g @ORIENT("R0", priority="low")
  };
  $SUPPLY_STUB = @DEFINE(roles=[["t", "terminal"]], parameters=[["gap", 2]]) {
    %s = $SUPPLY @ATTACH ?t::net;
    ?t::net @WIRE {?t %s:p};
    {?t %s:p} @ALIGN("x", priority="low");
    ?t %s:p @DISTANCE("bottom-to-top", min=?gap, priority="low");
    %s @ORIENT("R0", priority="low")
  };

  /* each definition with its own symbol: the definition's name plus _SYMBOL */
  # @SELECT-USAGE $GROUND => @SET-SYMBOL $GROUND_SYMBOL;
  # @SELECT-USAGE $SUPPLY => @SET-SYMBOL $SUPPLY_SYMBOL;
  # @SELECT-USAGE $IO_PORT => @SET-SYMBOL $IO_PORT_SYMBOL;
  # @SELECT-USAGE $NO_CONNECT => @SET-SYMBOL $NO_CONNECT_SYMBOL;
  # @SELECT-USAGE $JUNCTION => @SET-SYMBOL $JUNCTION_SYMBOL;
  # @SELECT-USAGE $CURRENT_ARROW => @SET-SYMBOL $CURRENT_ARROW_SYMBOL;
  # @SELECT-USAGE $ARROW => @SET-SYMBOL $ARROW_SYMBOL;
  # @SELECT-USAGE $SPDT_SWITCH => @SET-SYMBOL $SPDT_SWITCH_SYMBOL
}

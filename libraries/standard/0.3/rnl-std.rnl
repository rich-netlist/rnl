/* rnl-std 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The standard package of the series, used implicitly at the root of every file of the language
   version 0.3 (16.3). A package collection: it has no content of its own and references
   rnl-std-core, then rnl-std-fill, rnl-std-semantics and rnl-std-layout. Used, it brings them in
   in that order, each once (16.2). */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="rnl-std", version="0.3");
  @USE-PACKAGE(name="rnl-std-core", version="0.3");
  @USE-PACKAGE(name="rnl-std-fill", version="0.3");
  @USE-PACKAGE(name="rnl-std-semantics", version="0.3");
  @USE-PACKAGE(name="rnl-std-layout", version="0.3")
}

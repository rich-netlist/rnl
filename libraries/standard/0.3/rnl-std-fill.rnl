/* rnl-std-fill 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The sets of the fill and the rules that add grounds, supplies and port tags (10.5, 16.3). A
   file that does not want the fill drops it with an empty inline package of its name. */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="rnl-std-fill", version="0.3");
  @USE-PACKAGE(name="rnl-std-basic", version="0.3")
}

/* ---------------------------------------------------------------- rnl-std-fill: fill (10.5) */
@RNL {
  /* sets the user edits with ADD-TO / REMOVE-FROM (10.5) */
  $GROUND_NET_SET = # @SELECT-NET(name="0");
  $SUPPLY_NET_SET = {};
  $PORT_FILL_SET = # @SELECT-NET(port=true);

  /* ground and supply for unwired pins: a stub with its own wire, gap below or above the pin
     (10.5, PR3). The solver places it and writes it back as an explicit statement; its wire then
     makes the terminal wired, so the fill does not come back (10.5 V8, PR2). A ground drawn right
     on a pin (12.1 rule 5) is left to the user; through the usages only their terminal members are
     selected (10.1, PR16), so such a pin is taken out of the fill. */
  $GROUND_FILL_SET = $GROUND_NET_SET @SELECT-TERMINAL(wired=false);
  # @SELECT-USAGE $NO_CONNECT => @SELECT-TERMINAL => @REMOVE-FROM $GROUND_FILL_SET;
  # @SELECT-USAGE $GROUND => @SELECT-TERMINAL => @REMOVE-FROM $GROUND_FILL_SET;
  $GROUND_STUB @ATTACH $GROUND_FILL_SET;

  $SUPPLY_FILL_SET = $SUPPLY_NET_SET @SELECT-TERMINAL(wired=false);
  # @SELECT-USAGE $NO_CONNECT => @SELECT-TERMINAL => @REMOVE-FROM $SUPPLY_FILL_SET;
  # @SELECT-USAGE $SUPPLY => @SELECT-TERMINAL => @REMOVE-FROM $SUPPLY_FILL_SET;
  $SUPPLY_STUB @ATTACH $SUPPLY_FILL_SET;

  /* ports of a subcircuit: one tag per port net that has none yet, but none on a ground or supply
     net, where the stubs stand already */
  $SUPPLY_NET_SET @REMOVE-FROM $PORT_FILL_SET;
  $GROUND_NET_SET @REMOVE-FROM $PORT_FILL_SET;
  # @SELECT-USAGE $IO_PORT => @SELECT-NET => @REMOVE-FROM $PORT_FILL_SET;
  $IO_PORT @ATTACH $PORT_FILL_SET;

  /* so the grounds of a ground net other than 0, such as vss, show the name of their net */
  $NAMED_GROUND_NET_SET = {$GROUND_NET_SET};
  # @SELECT-NET(name="0") => @REMOVE-FROM $NAMED_GROUND_NET_SET;
  $NAMED_GROUND_NET_SET @SELECT-ANCESTOR-USAGE $GROUND => @SET-SYMBOL $NAMED_GROUND_SYMBOL;

  /* net-name labels for unwired pins: not applied by default; a document opts in with
     $LABEL_TERMINAL_SET @TEXT("${net}", key="netname") */
  $LABEL_TERMINAL_SET = # @SELECT-TERMINAL(wired=false);
  $GROUND_NET_SET @SELECT-TERMINAL => @REMOVE-FROM $LABEL_TERMINAL_SET;
  $SUPPLY_NET_SET @SELECT-TERMINAL => @REMOVE-FROM $LABEL_TERMINAL_SET;
  # @SELECT-USAGE $NO_CONNECT => @SELECT-TERMINAL => @REMOVE-FROM $LABEL_TERMINAL_SET;

  /* nets to draw with wires, routed by the solver: not applied by default; a document or a style
     package opts in with $WIRE_NET_SET @ROUTE (13.7, PR5) */
  $WIRE_NET_SET = # @SELECT-NET;
  $GROUND_NET_SET @REMOVE-FROM $WIRE_NET_SET;
  $SUPPLY_NET_SET @REMOVE-FROM $WIRE_NET_SET
}

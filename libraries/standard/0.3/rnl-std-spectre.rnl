/* rnl-std-spectre 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The rule package of Spectre: the symbols of instances by master, then by model type (16.3). */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="rnl-std-spectre", version="0.3");
  @USE-PACKAGE(name="rnl-std-basic", version="0.3");
  @USE-PACKAGE(name="rnl-std-semiconductors", version="0.3")
}

/* ---------------------------------------------------------------- rnl-std-spectre: symbols for Spectre netlists
   Every element the Spectre adapter reads natively, all but subcircuit calls (16.3). Spectre names
   carry no element letter, so nothing goes by name: a primitive by its master, an instance of a model
   card by the card's model type (6.12, 10.1). As a package it references rnl-std-basic and
   rnl-std-semiconductors, whose symbols it names. */
@RNL {
  # @SELECT-INSTANCE(model="resistor") => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(model="capacitor") => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(model="inductor") => @SET-SYMBOL $INDUCTOR;
  # @SELECT-INSTANCE(model="vsource") => @SET-SYMBOL $VOLTAGE_SOURCE;
  # @SELECT-INSTANCE(model="isource") => @SET-SYMBOL $CURRENT_SOURCE;
  # @SELECT-INSTANCE(model="diode") => @SET-SYMBOL $DIODE;
  # @SELECT-INSTANCE(model="vcvs") => @SET-SYMBOL $VCVS_4TERM;
  # @SELECT-INSTANCE(model="vccs") => @SET-SYMBOL $VCCS_4TERM;
  # @SELECT-INSTANCE(model="cccs") => @SET-SYMBOL $CCCS;
  # @SELECT-INSTANCE(model="ccvs") => @SET-SYMBOL $CCVS;
  # @SELECT-INSTANCE(model="bsource") => @SET-SYMBOL $BEHAVIORAL_SOURCE;
  # @SELECT-INSTANCE(model="relay") => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH;
  # @SELECT-INSTANCE(model="switch") => @SET-SYMBOL $SWITCH;
  # @SELECT-INSTANCE(model="port") => @SET-SYMBOL $RF_PORT;
  # @SELECT-INSTANCE(model="transformer") => @SET-SYMBOL $TRANSFORMER;

  /* the model type of the model card an instance names, in SPICE's words (the adapter's family()) */

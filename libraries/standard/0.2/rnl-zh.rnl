  @ALIAS("尾管", "tail", definition="$INPUT_STAGE");
  @ALIAS("成员", "members", definition="$MATCHED");
  @ALIAS("成员", "members", definition="$BRANCH");
  @ALIAS("源", "source", definition="$CHAIN");
  @ALIAS("串联", "series", definition="$CHAIN");
  @ALIAS("负载", "load", definition="$CHAIN");
  @ALIAS("第一级", "first", definition="$CASCADE");
  @ALIAS("第二级", "second", definition="$CASCADE");
  @ALIAS("反馈", "feedback", definition="$CASCADE");
  @ALIAS("负载", "load", definition="$CASCADE");
  @ALIAS("端子", "pin", definition="$SUPPLY_HIGH");
  @ALIAS("端子", "pin", definition="$SUPPLY_LOW");
  @ALIAS("甲", "a", definition="$MIRROR_PAIR");
  @ALIAS("乙", "b", definition="$MIRROR_PAIR");
  @ALIAS("轴", "axis", definition="$MIRROR_PAIR");
  @ALIAS("甲", "a", definition="$TAIL_CENTER");
  @ALIAS("乙", "b", definition="$TAIL_CENTER");
  @ALIAS("尾端", "t", definition="$TAIL_CENTER");
  @ALIAS("中点", "mid", definition="$TAIL_CENTER");
  @ALIAS("端子", "t", definition="$GND_STUB");
  @ALIAS("间距", "gap", definition="$GND_STUB");

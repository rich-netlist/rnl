  @ALIAS("$带尾管差分对", "$DIFFPAIR_TAIL");
  @ALIAS("$电流镜", "$CURRENT_MIRROR");
  @ALIAS("$输入级", "$INPUT_STAGE");
  @ALIAS("$匹配组", "$MATCHED");
  @ALIAS("$支路", "$BRANCH");
  @ALIAS("$信号链", "$CHAIN");
  @ALIAS("$级联", "$CASCADE");
  @ALIAS("$高电源端", "$SUPPLY_HIGH");
  @ALIAS("$低电源端", "$SUPPLY_LOW");
  @ALIAS("$镜像对", "$MIRROR_PAIR");
  @ALIAS("$尾管居中", "$TAIL_CENTER");
  @ALIAS("$接地桩", "$GND_STUB");
  @ALIAS("$电源桩", "$SUPPLY_STUB");
  @ALIAS("$信号流向", "$FLOW");
  @ALIAS("$箭头符号", "$ARROW_HEAD");

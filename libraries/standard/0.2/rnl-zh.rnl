  @ALIAS("@选出用例", "@SELECT-USAGE");
  @ALIAS("@选出所处用例", "@SELECT-ANCESTOR-USAGE");
  @ALIAS("@加入", "@ADD-TO");
  @ALIAS("@移出", "@REMOVE-FROM");

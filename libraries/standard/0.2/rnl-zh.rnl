  @ALIAS("负输入", "in_n", definition="$DIFFPAIR");
  @ALIAS("正输入", "in_p", definition="$DIFFPAIR_TAIL");
  @ALIAS("负输入", "in_n", definition="$DIFFPAIR_TAIL");

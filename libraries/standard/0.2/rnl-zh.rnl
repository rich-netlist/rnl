  @ALIAS("从右到左", "right-to-left");
  @ALIAS("从下到上", "bottom-to-top");
  @ALIAS("从上到下", "top-to-bottom");
  @ALIAS("左", "left");
  @ALIAS("右", "right");
  @ALIAS("上", "up");
  @ALIAS("下", "down");

  @ALIAS("$信号", "$signal");
  @ALIAS("$注释", "$note");
  @ALIAS("$灰色", "$grey");
  @ALIAS("挂点", "p", definition="$ARROW");
  @ALIAS("挂点", "p", definition="$GND");
  @ALIAS("挂点", "p", definition="$SUPPLY");
  @ALIAS("挂点", "p", definition="$IOPORT");

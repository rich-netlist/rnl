{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RNL Viewer",
  "version": "0.3.0",
  "identifier": "io.github.rich-netlist.viewer",
  "build": {
    "frontendDist": "../viewer-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RNL Viewer",
        "dragDropEnabled": true,
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Rich Netlist",
    "copyright": "Copyright (c) 2026 many-question",
    "homepage": "https://github.com/rich-netlist/rnl",
    "license": "MIT AND OFL-1.1",
    "licenseFile": "LICENSE.txt",
    "resources": ["LICENSE.txt"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "installerHooks": "nsis-hooks.nsh"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "e063e79a-593d-5622-8b1a-cbc027a3628a"
      }
    }
  }
}

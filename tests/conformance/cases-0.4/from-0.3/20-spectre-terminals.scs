// Spectre default terminal names: primitives, multi-throw switch, model families, and DEVICE override (6.12)
//! 6.12: Spectre primitives take default terminal names by master (resistor: p n;
//!   diode: a k; vcvs and relay: p n cp cn; transformer: p1 n1 p2 n2).
//!   A `switch` has terminals t0 .. tn matching its node count.
//!   An instance of a model card takes the terminal names and `type` of its model's
//!   device family (psp103 -> d g s b / pmos; vbic -> c b e s / npn; juncap200 -> a k / d;
//!   jfet -> d g s / pjf; rdiff -> p n / r).
//!   A DEVICE in the header record overrides the adapter defaults.
simulator lang=spectre
// @RNL(type="header") { @USE-PACKAGE(name="rnl-std-all", version="0.4");
//   @VERSION("0.4");
//   @DEVICE(name="r_custom", model="resistor", terminals=["pos", "neg"])
// }
// @RNL { # @SELECT-PIN(recursive=true) => @REMOVE-FROM $LABEL_FILL_SET; # @SELECT-INSTANCE(type="pmos", recursive=true) => @SET-SYMBOL $PMOS_4TERM; # @SELECT-INSTANCE(model="relay", recursive=true) => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH; # @SELECT-INSTANCE(type="sw", recursive=true) => @SET-SYMBOL $VOLTAGE_CONTROLLED_SWITCH; %bulk_ground_pins = $GROUND_NET_SET @SELECT-TERMINAL(type="nmos", terminal="b", recursive=true) => @SELECT-PIN(wired=false, recursive=true); $GROUND_NET_SET @SELECT-TERMINAL(type="pmos", terminal="b", recursive=true) => @SELECT-PIN(wired=false, recursive=true) => @ADD-TO %bulk_ground_pins; # @SELECT-USAGE(recursive=true) $NO_CONNECT => @SELECT-PIN(role="t", recursive=true) => @REMOVE-FROM %bulk_ground_pins; %bulk_ground_pins @ADD-TO $GROUND_FILL_SET; %bulk_supply_pins = $SUPPLY_NET_SET @SELECT-TERMINAL(type="nmos", terminal="b", recursive=true) => @SELECT-PIN(wired=false, recursive=true); $SUPPLY_NET_SET @SELECT-TERMINAL(type="pmos", terminal="b", recursive=true) => @SELECT-PIN(wired=false, recursive=true) => @ADD-TO %bulk_supply_pins; # @SELECT-USAGE(recursive=true) $NO_CONNECT => @SELECT-PIN(role="t", recursive=true) => @REMOVE-FROM %bulk_supply_pins; %bulk_supply_pins @ADD-TO $SUPPLY_FILL_SET; $PORT_FILL_NET_SET = # @SELECT-NET(port=true, recursive=true); $SUPPLY_NET_SET @REMOVE-FROM $PORT_FILL_NET_SET; $GROUND_NET_SET @REMOVE-FROM $PORT_FILL_NET_SET; # @SELECT-USAGE(recursive=true) $IO_PORT => @SELECT-NET(recursive=true) => @REMOVE-FROM $PORT_FILL_NET_SET; $IO_PORT @ATTACH $PORT_FILL_NET_SET }

r1 (n_rp n_rn) resistor r=1k
r_custom (n_rp n_rn) resistor r=2k
d1 (n_da n_dk) diode
e1 (n_ep n_en n_ecp n_ecn) vcvs gain=2
rel1 (n_relp n_reln n_ecp n_ecn) relay
xf1 (n_pp n_pm n_sp n_sm) transformer n1=1 n2=2
sw3 (n_com n_t1 n_t2 n_t3) switch dc_position=2

mp1 (n_md n_mg n_ms n_mb) psp_pmos w=2u l=100n
qb1 (n_qc n_qb n_qe 0) vbic_npn
dj1 (n_da n_dk) jcap_d
jp1 (n_jd n_jg n_js) jfet_p
rd1 (n_rp n_rn) rdiff_r r=500

model psp_pmos psp103 type=pmos
model vbic_npn vbic type=npn
model jcap_d juncap200
model jfet_p jfet type=pjf
model rdiff_r rdiff

// @RNL {
//   #r_custom @SET-SYMBOL(terminals=[["pos", "p"], ["neg", "n"]]) $RESISTOR;
//   $SP3T = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
//     (-2, 0) @PIN(terminal=1, direction="left");
//     (2, 1) @PIN(terminal=2, direction="right");
//     (2, 0) @PIN(terminal=3, direction="right");
//     (2, -1) @PIN(terminal=4, direction="right");
//     (-2, -2) (2, 2) @RECTANGLE
//   };
//   #sw3 @SET-SYMBOL $SP3T;
//   #r1 @PLACE(0, 0);
//   #r_custom @PLACE(10, 0);
//   #d1 @PLACE(20, 0);
//   #e1 @PLACE(30, 0);
//   #rel1 @PLACE(40, 0);
//   #xf1 @PLACE(50, 0);
//   #sw3 @PLACE(60, 0);
//   #mp1 @PLACE(0, -15);
//   #qb1 @PLACE(10, -15);
//   #dj1 @PLACE(20, -15);
//   #jp1 @PLACE(30, -15);
//   #rd1 @PLACE(40, -15);
//
//   %rp_branch = (10,3); %rn_branch = (10,-4);
//   $JUNCTION @ATTACH %rp_branch => @PLACE(10,3); $JUNCTION @ATTACH %rn_branch => @PLACE(10,-4);
//   &n_rp @WIRE(mode="auto") {#r1:p (0,6) (10,6) %rp_branch #r_custom:pos};
//   &n_rp @WIRE(mode="auto") {%rp_branch (8,3) (8,-10) (40,-10) #rd1:p};
//   &n_rn @WIRE(mode="auto") {#r1:n (0,-4) %rn_branch #r_custom:neg};
//   &n_rn @WIRE(mode="auto") {%rn_branch (14,-4) (14,-20) (40,-20) #rd1:n};
//   &n_da @WIRE(mode="auto") {#d1:a #dj1:a};
//   &n_dk @WIRE(mode="auto") {#d1:k #dj1:k};
//   &n_ecp @WIRE(mode="auto") {#e1:cp (25,1) (25,5) (37,5) (37,-3) #rel1:cp};
//   &n_ecn @WIRE(mode="auto") {#e1:cn (25,-1) (25,-5) (43,-5) (43,-3) #rel1:cn};
//   {#e1:p #e1:n #rel1:p #rel1:n} @CURRENT("in");
//   {#xf1:p1 #xf1:n1 #xf1:p2 #xf1:n2} @CURRENT("in");
//   {#sw3:t0 #sw3:t1 #sw3:t2 #sw3:t3} @CURRENT("in");
//   {#mp1:d #mp1:g #mp1:s #mp1:b} @CURRENT("in");
//   {#qb1:c #qb1:b #qb1:e #qb1:s} @CURRENT("in");
//   {#jp1:d #jp1:g #jp1:s} @CURRENT("in")
// }

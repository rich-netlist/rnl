/* The stand-in of rnl-std-basic 0.3: a resistor and a current source. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="rnl-std-basic", version="0.3")}
@RNL {
  $RES = @DEFINE-SYMBOL(box=[-1, -3, 1, 3]) {
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    @RECTANGLE {(-1, -2) (1, 2)}
  };
  $ISRC = @DEFINE-SYMBOL(box=[-2, -3, 2, 3]) {
    (0, 3) @PIN(terminal=1, direction="up");
    (0, -3) @PIN(terminal=2, direction="down");
    (0, 0) @CIRCLE(radius=2);
    @LINE(arrow="end") {(0, 1) (0, -1)}
  }
}

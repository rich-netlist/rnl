/* rnl-std-semiconductors 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The symbols of diodes and transistors, from Analog Canvas, and of the JFET, drawn by hand.
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. Pins bind by terminal
   number, so a symbol fits any dialect. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="rnl-std-semiconductors", version="0.3")}

/* ---------------------------------------------------------------- rnl-std-semiconductors: symbols drawn from Analog Canvas */
@RNL {
  /* a k; from Analog Canvas diode */
  $DIODE = @DEFINE-SYMBOL(box=[-2, -1, 2, 1]) {
    (-2, 0) @PIN(terminal=1, direction="left");
    (2, 0) @PIN(terminal=2, direction="right");
    @LINE {(-2, 0) (-0.8333, 0)};
    @LINE {(-0.8333, 0.675) (-0.8333, -0.675) (0.5833, 0) (-0.8333, 0.675)};
    @LINE(linewidth=0.24) {(0.6667, 0.7333) (0.6667, -0.7333)};
    @LINE {(0.6667, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.1)
  };

  /* a k; from Analog Canvas zener-diode */
  $ZENER_DIODE = @DEFINE-SYMBOL(box=[-2, -1, 2, 1]) {
    (-2, 0) @PIN(terminal=1, direction="left");
    (2, 0) @PIN(terminal=2, direction="right");
    @LINE {(-2, 0) (-0.7803, 0)};
    @LINE {(-0.7803, 0.6404) (-0.7803, -0.6404) (0.6606, 0) (-0.7803, 0.6404)};
    @LINE(linewidth=0.24) {(-0.0639, 0.8507) (0.6667, 0.8406) (0.6667, -0.8205) (1.387, -0.8205)};
    @LINE {(0.6667, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.2)
  };

  /* d g s (b); from Analog Canvas nmos (textbook-3terminal) */
  $NMOS = @DEFINE-SYMBOL(box=[-3, -2, 1.4, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (-3, 0) @PIN(terminal=2, direction="left");
    (0, -2) @PIN(terminal=3, direction="down");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.5116, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(0.0581, -0.6977) (-0.8721, -0.2907) (-0.8721, -1.1047) (0.0581, -0.6977)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("${model}", key="model") => @PLACE(0.5, -1.75)
  };

  /* d g s b; from Analog Canvas nmos */
  $NMOS_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 1, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (-3, 0) @PIN(terminal=2, direction="left");
    (0, -2) @PIN(terminal=3, direction="down");
    (1, 0) @PIN(terminal=4, direction="right");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.5116, 0) (0, 0)};
    @LINE {(0.6395, 0) (1, 0)};
    @LINE(fill="linecolor", linestyle="none") {(0, 0) (0.6395, 0.3488) (0.6395, -0.3488) (0, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("${model}", key="model") => @PLACE(0.5, -1.75)

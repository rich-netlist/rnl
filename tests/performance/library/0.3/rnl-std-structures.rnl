/* rnl-std-structures 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The definitions of circuit structures and of layouts (9.5, 14, 15.1), which rnl-std-semantics and
   rnl-std-layout held apart before. Some carry a default drawing in their bodies, whose constraints
   are all of priority low (14.8): the author's own facts come before them, PRIORITY("disabled") on a
   usage turns them off for that usage, and a rule such as
   # @SELECT-USAGE $DIFFERENTIAL_PAIR => @PRIORITY("disabled") for every usage of a definition. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="rnl-std-structures", version="0.3")}

/* ---------------------------------------------------------------- circuit structures (15.1) */
@RNL {
  /* the tail, a set that may be left empty, by its centre under the middle of the pair (14.1, 14.4) */
  $DIFFERENTIAL_PAIR = @DEFINE(roles=[["in_p", "instance"], ["in_n", "instance"], ["{tail}", "instance"]]) {
    {?in_p {?tail} ?in_n} @DISTRIBUTE("x", priority="low")
  };
  $CURRENT_MIRROR = @DEFINE(roles=[["{ref}", "instance"], ["{out}", "instance"]]) {};
  $MATCHED = @DEFINE(roles=["{members}"]) {};
  /* the members in one column; which is on top is the solver's, by the direction of the current */
  $BRANCH = @DEFINE(roles=["{members}"]) {
    ?members @ALIGN("x", priority="low")
  };
  /* from the source through the members of the chain, in the order written, to the load */
  $CHAIN = @DEFINE(roles=["source", "{chain}", "load"]) {
    {?source ?chain ?load} @ORDER("left-to-right", priority="low")
  };
  $CASCADE = @DEFINE(roles=["{first}", "{second}", "{feedback}", "{load}"]) {};
  $SUPPLY_HIGH = @DEFINE(roles=[["pin", "terminal"]]) {};
  $SUPPLY_LOW = @DEFINE(roles=[["pin", "terminal"]]) {}
}

/* ---------------------------------------------------------------- layouts (14) */
@RNL {
  /* a and b at one height, mirror images about the axis point, a on the left (14.7, 14.9) */
  $MIRRORED = @DEFINE(roles=["a", "b", "axis"]) {
    {?a ?b} @ALIGN("y", priority="low");
    {?a ?axis ?b} @DISTRIBUTE("x", priority="low");
    {?a ?b} @ORDER("left-to-right", priority="low");
    ?a ?b @ORIENT-RELATION("MY", priority="low")
  };
  $FLOW = @DEFINE(roles=["{path}"], parameters=[["direction", "left-to-right"]]) {
    ?path @ORDER(?direction, priority="low")
  }
}

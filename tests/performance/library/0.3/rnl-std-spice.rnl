/* rnl-std-spice 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The rule package of SPICE: the symbols of instances by element letter, then by model type (16.3). */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="rnl-std-spice", version="0.3");
  @USE-PACKAGE(name="rnl-std-basic", version="0.3");
  @USE-PACKAGE(name="rnl-std-semiconductors", version="0.3")
}

/* ---------------------------------------------------------------- rnl-std-spice: symbols for SPICE netlists
   Every element the SPICE adapter reads natively, all but subcircuit calls (16.3): broad (element letter,
   the first letter of the name) first, narrow (model type) later. A transistor (M, Q, J, Z) is drawn by
   the type of its model card alone, below: its polarity is not told by its name, so one whose card is not
   found is not drawn. As a package it references
   rnl-std-basic and rnl-std-semiconductors, whose symbols it names. */
@RNL {
  # @SELECT-INSTANCE(name="R*") => @SET-SYMBOL $RESISTOR;
  # @SELECT-INSTANCE(name="C*") => @SET-SYMBOL $CAPACITOR;
  # @SELECT-INSTANCE(name="L*") => @SET-SYMBOL $INDUCTOR;

  # @SELECT-INSTANCE(name="W*") => @SET-SYMBOL $SWITCH;
  # @SELECT-INSTANCE(name="T*") => @SET-SYMBOL $TRANSMISSION_LINE;
  # @SELECT-INSTANCE(name="O*") => @SET-SYMBOL $TRANSMISSION_LINE;
  # @SELECT-INSTANCE(name="U*") => @SET-SYMBOL $RC_LINE;

  /* the model type of the .model card the element names */

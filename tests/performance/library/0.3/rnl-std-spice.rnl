  # @SELECT-INSTANCE(name="E*") => @SET-SYMBOL $VCVS_4TERM;
  # @SELECT-INSTANCE(name="G*") => @SET-SYMBOL $VCCS_4TERM;
  # @SELECT-INSTANCE(name="F*") => @SET-SYMBOL $CCCS;
  # @SELECT-INSTANCE(name="H*") => @SET-SYMBOL $CCVS;
  # @SELECT-INSTANCE(name="B*") => @SET-SYMBOL $BEHAVIORAL_SOURCE;

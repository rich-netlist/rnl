/* rnl-std-rf 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   RF parts: the center-tap inductor and the T-coil.
   In rnl-std-full; a file that wants it alone names it with USE-PACKAGE (16.2).
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. Pins bind by terminal
   number, so a symbol fits any dialect. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="rnl-std-rf", version="0.3")}

/* ---------------------------------------------------------------- symbols (9.2) drawn from Analog Canvas */
@RNL {
  /* n1 n2 tap; from Analog Canvas center-tap-inductor */
  $CENTER_TAP_INDUCTOR = @DEFINE-SYMBOL(box=[-5, -2, 5, 1.6]) {
    (-5, 0) @PIN(terminal=1, direction="left");
    (5, 0) @PIN(terminal=2, direction="right");
    (0, -2) @PIN(terminal=3, direction="down");
    @LINE {(-5, 0) (-4.5, 0)};
    @ARC(cap="round") {(-4.5, 0) (-4.3536, 0.3536) (-4, 0.5)};
    @ARC {(-4, 0.5) (-3.6464, 0.3536) (-3.5, 0)};
    @ARC {(-3.5, 0) (-3, 0.5) (-2.5, 0)};
    @ARC {(-2.5, 0) (-2, 0.5) (-1.5, 0)};
    @ARC {(-1.5, 0) (-1.3536, 0.3536) (-1, 0.5)};
    @ARC(cap="round") {(-1, 0.5) (-0.6464, 0.3536) (-0.5, 0)};
    @LINE {(-0.5, 0) (0.5, 0)};
    @ARC(cap="round") {(0.5, 0) (0.6464, 0.3536) (1, 0.5)};
    @ARC {(1, 0.5) (1.3536, 0.3536) (1.5, 0)};
    @ARC {(1.5, 0) (2, 0.5) (2.5, 0)};
    @ARC {(2.5, 0) (3, 0.5) (3.5, 0)};
    @ARC {(3.5, 0) (3.6464, 0.3536) (4, 0.5)};
    @ARC(cap="round") {(4, 0.5) (4.3536, 0.3536) (4.5, 0)};
    @LINE {(4.5, 0) (5, 0)};
    @LINE {(0, 0) (0, -2)};
    (0, 0) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 0.85)
  };

  /* n1 n2 tap; from Analog Canvas tcoil */
  $T_COIL = @DEFINE-SYMBOL(box=[-9, -2, 9, 5.6]) {
    (-9, 0) @PIN(terminal=1, direction="left");
    (9, 0) @PIN(terminal=2, direction="right");
    (0, -2) @PIN(terminal=3, direction="down");
    @LINE {(-9, 0) (-6.0624, 0)};
    @ARC(cap="round") {(-6.0624, 0) (-5.916, -0.3536) (-5.5624, -0.5)};
    @ARC {(-5.5624, -0.5) (-5.2089, -0.3536) (-5.0624, 0)};
    @ARC {(-5.0624, 0) (-4.5624, -0.5) (-4.0624, 0)};
    @ARC {(-4.0624, 0) (-3.5624, -0.5) (-3.0624, 0)};
    @ARC {(-3.0624, 0) (-2.916, -0.3536) (-2.5624, -0.5)};
    @ARC(cap="round") {(-2.5624, -0.5) (-2.2089, -0.3536) (-2.0624, 0)};
    @LINE {(-2.0624, 0) (2.1812, 0)};
    @ARC(cap="round") {(2.1812, 0) (2.3277, -0.3536) (2.6812, -0.5)};
    @ARC {(2.6812, -0.5) (3.0348, -0.3536) (3.1812, 0)};
    @ARC {(3.1812, 0) (3.6812, -0.5) (4.1812, 0)};
    @ARC {(4.1812, 0) (4.6812, -0.5) (5.1812, 0)};
    @ARC {(5.1812, 0) (5.3277, -0.3536) (5.6812, -0.5)};
    @ARC(cap="round") {(5.6812, -0.5) (6.0348, -0.3536) (6.1812, 0)};
    @LINE {(6.1812, 0) (9, 0)};
    @LINE {(0, 0) (0, -2)};
    @LINE {(-8, 0) (-8, 4.3335) (-1.95, 4.3335)};
    @LINE(linewidth=0.24) {(-0.3234, 5.1386) (-0.3234, 3.5284)};
    @LINE(linewidth=0.24) {(0.3234, 5.1386) (0.3234, 3.5284)};
    @LINE {(-0.3234, 4.3335) (-2, 4.3335)};
    @LINE {(0.3234, 4.3335) (2, 4.3335)};
    @LINE {(1.95, 4.3335) (8, 4.3335) (8, 0)};
    (-5.9216, 0.6074) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none");
    (2.322, 0.6074) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none");
    (-8, 0) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none");
    (0, 0) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none");
    (8, 0) @CIRCLE(radius=0.3779, fill="linecolor", linestyle="none");
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 5.5)
  }
}

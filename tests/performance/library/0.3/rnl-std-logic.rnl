  };

  /* d ck rst q qb (vp) (vn); from Analog Canvas d-flip-flop-reset */
  $D_FLIP_FLOP_WITH_RESET = @DEFINE-SYMBOL(box=[-4, -5, 4, 2.7]) {
    (-4, 1) @PIN(terminal=1, direction="left");
    (-4, -1) @PIN(terminal=2, direction="left");
    (0, -5) @PIN(terminal=3, direction="down");
    (4, 1) @PIN(terminal=4, direction="right");
    (4, -1) @PIN(terminal=5, direction="right");
    @LINE {(-4, 1) (-2.5001, 1)};
    @LINE {(-4, -1) (-2.5001, -1)};
    @LINE(linewidth=0.24) {(-2.5001, 2.5) (2.5001, 2.5) (2.5001, -3.5) (-2.5001, -3.5) (-2.5001, 2.5)};
    @LINE {(2.5001, 1) (4, 1)};
    @LINE {(2.5001, -1) (4, -1)};
    @LINE {(0, -3.5) (0, -5)};
    (-2.1, 1) @TEXT("D", halign="start", valign="middle", size=1.03, bold=true, italic=true);
    (-2.1, -1) @TEXT("CK", halign="start", valign="middle", size=1.03, bold=true, italic=true);
    (0, -3.1) @TEXT("RST", halign="middle", valign="bottom", size=1.03, bold=true, italic=true);
    (2.1, 1) @TEXT("Q", halign="end", valign="middle", size=1.03, bold=true, italic=true);
    (2.1, -1) @TEXT("\overline{Q}", halign="end", valign="middle", size=1.03, bold=true, italic=true);
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.85)
  };

  /* draws $DELAY_CELL; a y; from Analog Canvas delay-cell */
  $DELAY_CELL_SYMBOL = @DEFINE-SYMBOL(box=[-4, -2.4, 4, 2.4]) {
    (-4, 0) @PIN(terminal=1, direction="left");
    (4, 0) @PIN(terminal=2, direction="right");
    @LINE {(-4, 0) (-2.4, 0)};
    @LINE(linewidth=0.24) {(-2.4, 1.2) (2.4, 1.2) (2.4, -1.2) (-2.4, -1.2) (-2.4, 1.2)};
    @LINE {(2.4, 0) (4, 0)};
    @LINE(fill="linecolor", linestyle="none") {(-0.0951, 0.3868) (-0.1484, 0.1398) (-0.4607, -0.5332) (-0.5551, -0.6035) (-0.0951, 0.3868)};
    @LINE(fill="linecolor", linestyle="none") {(-0.0951, 0.3868) (0.3092, -0.6035) (0.1301, -0.5332) (-0.1484, 0.1398) (-0.0951, 0.3868)};
    @LINE(fill="linecolor", linestyle="none") {(-0.5551, -0.6035) (-0.4607, -0.5332) (0.1301, -0.5332) (0.3092, -0.6035) (-0.5551, -0.6035)};
    @LINE(fill="linecolor", linestyle="none") {(0.661, -0.4849) (0.4843, -0.4849) (0.632, 0.2294) (0.3802, 0.2294) (0.4117, 0.3722) (1.0872, 0.3722) (1.0581, 0.2294) (0.8087, 0.2294) (0.661, -0.4849)}
  }

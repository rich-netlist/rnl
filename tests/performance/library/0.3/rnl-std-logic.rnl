    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    (2, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, 0) (-1.25, 0)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.3375, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15)
  };

  /* a b y (vp) (vn); from Analog Canvas xor-gate */
  $XOR_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1) @PIN(terminal=1, direction="left");
    (-3, -1) @PIN(terminal=2, direction="left");
    (3, 0) @PIN(terminal=3, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(2.23, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15)
  };

  /* a b c y (vp) (vn); from Analog Canvas xor-gate-3 */
  $XOR_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1) @PIN(terminal=1, direction="left");
    (-3, 0) @PIN(terminal=2, direction="left");
    (-3, -1) @PIN(terminal=3, direction="left");
    (3, 0) @PIN(terminal=4, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (-0.6, 0) (-1.35, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, 1.78) (0.68, 1.18) (2.23, 0)};
    @ARC(linewidth=0.24, cap="round") {(-1.35, -1.78) (0.68, -1.18) (2.23, 0)};
    @ARC(linewidth=0.24) {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, 0) (-1.25, 0)};
    @LINE {(-3, -1) (-1.4599, -1)};

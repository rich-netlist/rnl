/* rnl-std-logic 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   Gates, buffer, inverter, D flip-flops, and the drawing-only delay cell.
   In rnl-std-full; a file that wants it alone names it with USE-PACKAGE (16.2).
   Coordinates are y-up; one unit is one grid step, ten Analog Canvas units. Pins bind by terminal
   number, so a symbol fits any dialect. */
@RNL(type="header") { @VERSION("0.3"); @PACKAGE(name="rnl-std-logic", version="0.3")}

/* ---------------------------------------------------------------- symbols (9.2) drawn from Analog Canvas */
@RNL {
  /* a b y (vp) (vn); from Analog Canvas and-gate */
  $AND_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {
    (-3, 1) @PIN(terminal=1, direction="left");
    (-3, -1) @PIN(terminal=2, direction="left");
    (2, 0) @PIN(terminal=3, direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(1.5, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 1.85)
  };

  /* a b c y (vp) (vn); from Analog Canvas and-gate-3 */
  $AND_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 2, 2.4]) {

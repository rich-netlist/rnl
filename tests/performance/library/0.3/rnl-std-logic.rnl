    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 2.15)
  };

  /* a b y (vp) (vn); from Analog Canvas xnor-gate */
  $XNOR_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 4, 2.4]) {

    (-3, -1) @PIN(terminal=2, direction="left");
    (2, 0) @PIN(terminal=3, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    @LINE {(-3, 1) (-1.4599, 1)};

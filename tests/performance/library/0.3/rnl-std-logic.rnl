    (-3, 0) @PIN(terminal=2, direction="left");
    (-3, -1) @PIN(terminal=3, direction="left");
    (2, 0) @PIN(terminal=4, direction="right");
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (-1.25, 0) (-2, -1.78)};
    @ARC(linewidth=0.24, cap="round") {(-2, 1.78) (0.03, 1.18) (1.58, 0)};
    @ARC(linewidth=0.24, cap="round") {(-2, -1.78) (0.03, -1.18) (1.58, 0)};
    @LINE {(-3, 1) (-1.4599, 1)};
    @LINE {(-3, 0) (-1.25, 0)};
    @LINE {(-3, -1) (-1.4599, -1)};
    @LINE {(1.58, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 2.15)
  };

  /* a b y (vp) (vn); from Analog Canvas nor-gate */
  $NOR_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1) @PIN(terminal=1, direction="left");
    (-3, -1) @PIN(terminal=2, direction="left");

    (-3, 0) @PIN(terminal=2, direction="left");
    (-3, -1) @PIN(terminal=3, direction="left");
    (2, 0) @PIN(terminal=4, direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, 0) (-2, 0)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(1.5, 0) (2, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(-0.5, 1.85)
  };

  /* a b y (vp) (vn); from Analog Canvas nand-gate */
  $NAND_2INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1) @PIN(terminal=1, direction="left");
    (-3, -1) @PIN(terminal=2, direction="left");
    (3, 0) @PIN(terminal=3, direction="right");
    @LINE(linewidth=0.24) {(0, 1.5) (-2, 1.5) (-2, -1.5) (0, -1.5)};
    @ARC(linewidth=0.24) {(0, 1.5) (1.5, 0) (0, -1.5)};
    (2.05, 0) @CIRCLE(radius=0.3375, linewidth=0.24);
    @LINE {(-3, 1) (-2, 1)};
    @LINE {(-3, -1) (-2, -1)};
    @LINE {(2.3875, 0) (3, 0)};
    ? @TEXT("${name}", key="name", halign="middle") => @PLACE(0, 1.85)
  };

  /* a b c y (vp) (vn); from Analog Canvas nand-gate-3 */
  $NAND_3INPUT = @DEFINE-SYMBOL(box=[-3, -2.4, 3, 2.4]) {
    (-3, 1) @PIN(terminal=1, direction="left");

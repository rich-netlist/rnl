/* rnl-std-full 0.3, a package of the standard series 0.3 (16.3).
   Generated by build-std.mjs in rnl-dev (notes/analog-canvas-rnl-import-export/std-0.3, 609ab05)
   from Analog Canvas 9bbfd340b (packages/components/definitions), symbol-list.json (rnl-dev f0c23b6)
   and the hand-written parts there; from here on edited in rnl, whose files are the source.
   The fuller collection (16.3): rnl-std and the packages of fields. A file names it with
   USE-PACKAGE in its header record; what the implicit rnl-std brings in is not brought in twice. */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="rnl-std-full", version="0.3");
  @USE-PACKAGE(name="rnl-std", version="0.3");
  @USE-PACKAGE(name="rnl-std-functional", version="0.3");
  @USE-PACKAGE(name="rnl-std-rf", version="0.3");
  @USE-PACKAGE(name="rnl-std-logic", version="0.3");
  @USE-PACKAGE(name="rnl-std-signal-flow", version="0.3")
}

// Fifth-order Butterworth LC ladder low-pass, 50 ohm, 100 MHz, with source and load
// Doubly terminated: source resistor RS, shunt C1, series L2, shunt C3, series L4, shunt C5, load RL.
// @RNL(type="header") { @USE-PACKAGE(name="rnl-std-all", version="0.4"); @USE-PACKAGE(name="rnl-std-semantics", version="0.4"); @VERSION("0.4")}
simulator lang=spectre

VS (src 0) vsource dc=0 mag=2
RS (src in) resistor r=50
C1 (in 0) capacitor c=19.7p
L2 (in n2) inductor l=128.8n
C3 (n2 0) capacitor c=63.7p
L4 (n2 out) inductor l=128.8n
C5 (out 0) capacitor c=19.7p
RL (out 0) resistor r=50

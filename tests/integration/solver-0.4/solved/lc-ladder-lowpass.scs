//
//   /* what the circuit is: a doubly terminated fifth-order LC ladder, shunt C1, series L2, shunt C3, series L4, shunt C5,
//      between the source resistor RS and the load RL */
//   %pi1 = #C1(shunt1) #L2(series) #C3(shunt2) @AS $PI_NETWORK;
//   %pi2 = #C3(shunt1) #L4(series) #C5(shunt2) @AS $PI_NETWORK;
//   %t1 = #L2(series1) #C3(shunt) #L4(series2) @AS $T_NETWORK;
//   {#C1 #C5} @AS $MATCHED_CAPACITOR;
//   {#L2 #L4} @AS $MATCHED;
//   {#RS #RL} @AS $MATCHED_RESISTOR;
//   %flow = {#RS #C1 #L2 #C3 #L4 #C5}(path) {#VS}(source) {#RL %pout}(load) @AS $SIGNAL_FLOW;
//
//   /* no branch here (nothing carries DC): the ladder is laid out by hand.
//      The series path is one row, lying: source resistor, L2, L4 */
//   %series_row = {#RS #L2 #L4} @ALIGN("y");
//
//   /* from left to right the source, the series parts alternating with the shunt capacitors, the load and the output
//      tag; the shunt capacitors and the load in one row below the series row */
//   %ladder_order = {#VS #RS #C1 #L2 #C3 #L4 #C5 #RL %pout} @ORDER("left-to-right");
//   %shunt_row = {#C1 #C3 #C5 #RL} @ALIGN("y");
